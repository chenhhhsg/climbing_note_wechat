/**
 * 好友记录详情页样式
 */

.container {
  padding: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 好友信息头 */
.friend-header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #2c3e50 0%, #3d566e 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 62, 80, 0.3);
}

.friend-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
}

.friend-avatar-default {
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: bold;
}

.friend-info {
  flex: 1;
}

.friend-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
  display: block;
  margin-bottom: 6rpx;
}

.friend-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 概览卡片 */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.overview-stats {
  display: flex;
}

.overview-stat {
  flex: 1;
  text-align: center;
}

.overview-stat-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c3e50;
  display: block;
  margin-bottom: 8rpx;
}

.stat-success {
  color: #4caf50;
}

.stat-project {
  color: #2196f3;
}

.overview-stat-label {
  font-size: 22rpx;
  color: #999999;
}

.overview-notes {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 26rpx;
  color: #666666;
}

/* 线路列表 */
.routes-section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

.route-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.route-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.route-grade {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c3e50;
}

.route-status-tag {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.route-status-success {
  background-color: #e8f5e9;
  color: #4caf50;
}

.route-status-project {
  background-color: #e3f2fd;
  color: #2196f3;
}

.route-status-fail {
  background-color: #ffebee;
  color: #f44336;
}

.route-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.route-tag {
  font-size: 24rpx;
  padding: 6rpx 14rpx;
  background-color: #f5f5f5;
  color: #666666;
  border-radius: 8rpx;
}

.route-attempts {
  font-size: 24rpx;
  color: #999999;
}

.route-notes {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.route-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.route-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 10rpx;
}

/* 状态提示 */
.loading-state,
.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999999;
}
