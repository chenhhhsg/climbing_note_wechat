/**
 * 逐把视频页样式（T023 / T024）
 * 与逐把明细、单线记录同一套粉笔白 + 深绿配色；本页含待确认预览、原生播放器、
 * 已保存副本与更换/移除操作。
 */

page {
  background-color: #F2F4F3;
}

.page {
  padding: 12px 16px 28px;
  background-color: #F2F4F3;
}

.card {
  background-color: #FFFFFF;
  border-radius: 8rpx;
  padding: 16px;
  margin-bottom: 12px;
}

.card-title {
  display: block;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans CJK SC",
    "Source Han Sans SC", "Microsoft YaHei", sans-serif;
  line-height: 1.35;
  font-weight: 700;
  font-size: 32rpx;
  color: #182421;
  margin-bottom: 16rpx;
}

.error-card {
  background-color: #F7E6DB;
}

.choose-error {
  margin-bottom: 12px;
}

.error-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #943A23;
  margin-bottom: 12rpx;
}

.error-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #813323;
  margin-bottom: 10rpx;
}

.error-hint {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #745241;
  margin-bottom: 16rpx;
}

.notice {
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12px;
  background-color: #F7F1E2;
  color: #745241;
}

.notice-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.5;
}

.notice-hint {
  display: block;
  font-size: 22rpx;
  margin-top: 8rpx;
  opacity: 0.75;
}

/* 这一把的紧凑归属（T055）：线路、把次与场次压在一小段里 */
.attempt-head {
  border-left: 8rpx solid #1F5948;
  padding: 12px 16px;
  margin-bottom: 10px;
}

.attempt-head-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
}

.video-route {
  display: inline;
  font-size: 30rpx;
  font-weight: 700;
  color: #182421;
  word-break: break-all;
}

.video-route-meta {
  display: inline;
  margin-left: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #53615B;
}

.video-attempt-meta {
  display: block;
  margin-top: 2rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #182421;
}

.video-session-meta {
  display: block;
  margin-top: 2rpx;
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-variant-numeric: tabular-nums;
  font-size: 22rpx;
  line-height: 1.5;
  color: #53615B;
  word-break: break-all;
}

.video-note {
  display: block;
  border-left: 4rpx solid #B7683D;
  padding: 2rpx 0 2rpx 16rpx;
  margin: 8rpx 0 2rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: #53615B;
  word-break: break-all;
}

.video-state {
  display: inline-block;
  margin-top: 8rpx;
  padding: 3rpx 14rpx;
  border-radius: 6rpx;
  background-color: #F2F4F3;
  font-size: 23rpx;
  line-height: 1.5;
  color: #53615B;
}

/* 选片与预览 */
.video-hint {
  display: block;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #53615B;
}

.preview-name {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  color: #182421;
  word-break: break-all;
}

.preview-meta {
  display: block;
  margin-top: 4rpx;
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-variant-numeric: tabular-nums;
  font-size: 24rpx;
  line-height: 1.5;
  color: #53615B;
}

.button-row {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.button-row .secondary-button,
.button-row .primary-button {
  flex: 1;
  margin: 0 8rpx;
}

.video-foot-hint {
  display: block;
  margin-top: 16px;
  font-size: 22rpx;
  line-height: 1.6;
  color: #53615B;
}

/* 播放器：待确认预览与已保存副本共用，换片时整块重建。
   T055 不再在画面外放大号播放按钮，原生控件覆盖在画面上。 */
.player-card {
  border-left: 8rpx solid #1F5948;
  padding: 12px 12px 10px;
  margin-bottom: 8px;
}

/* 16:9：320px 屏内容宽约 288px（两侧 16px 内边距），380rpx ≈ 162px；
   390px 屏约 197px，与 16:9 的 201px 接近，画面与原生控件都完整可见。 */
.video {
  display: block;
  width: 100%;
  height: 380rpx;
  margin-top: 0;
  background-color: #000000;
  border-radius: 6rpx;
}

.player-status {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #53615B;
}

.playback-error {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 6rpx;
  background-color: #F7E6DB;
}

.op-status {
  background-color: #E8F0EC;
}

/* T055 共用操作区：紧贴播放器；已保存、待确认、首次选片与缺失共用这一块 */
.video-actions {
  padding: 10px 16px 12px;
}

.action-block {
  margin-top: 4px;
}

.action-block:first-child {
  margin-top: 0;
}

.action-label {
  display: block;
  font-size: 26rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #182421;
  margin-bottom: 8rpx;
}

/* 窄屏同排：两个按钮各自等宽（320px 内容宽约 288px，每个约 138px），
   永不换行、不越界；文案保持单行。 */
.action-row {
  display: flex;
  flex-wrap: nowrap;
  align-items: stretch;
  margin-top: 12rpx;
}

.action-block > .action-row:first-child {
  margin-top: 0;
}

.action-row .primary-button,
.action-row .secondary-button {
  flex: 1 1 0;
  min-width: 0;
  margin: 0 6rpx;
  padding: 16rpx 6rpx;
  font-size: 28rpx;
  white-space: nowrap;
}

.action-row .primary-button:first-child,
.action-row .secondary-button:first-child {
  margin-left: 0;
}

.action-row .primary-button:last-child,
.action-row .secondary-button:last-child {
  margin-right: 0;
}

.action-row-single .primary-button,
.action-row-single .secondary-button {
  flex: 1 1 100%;
  margin-left: 0;
  margin-right: 0;
}

.action-hint {
  margin: 10rpx 0 0;
  font-size: 23rpx;
  line-height: 1.55;
}

.saved-meta {
  display: flex;
  flex-wrap: wrap;
  margin-top: 2rpx;
}

.saved-meta .preview-meta {
  margin: 0 16rpx 0 0;
  font-size: 22rpx;
}

.op-error {
  background-color: #F7E6DB;
}

.video-actions .notice:last-child {
  margin-bottom: 0;
}

/* 本机视频占用（T026） */
.space-card {
  border-left: 8rpx solid #B7683D;
}

.space-usage {
  display: block;
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-variant-numeric: tabular-nums;
  font-size: 30rpx;
  line-height: 1.5;
  color: #182421;
}

.space-warning {
  display: block;
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 6rpx;
  background-color: #F7E6DB;
  font-size: 24rpx;
  line-height: 1.6;
  color: #813323;
}

.space-error {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #745241;
}

.cleanup-notice {
  margin-top: 12rpx;
}

.cleanup-button {
  margin-top: 16rpx;
}

.store-hint {
  background-color: #F7F1E2;
}

/* 手工时间点（T025）：列表可点回、可单点移除，触控目标不小于 44px */
.markers-card {
  border-left: 8rpx solid #1F5948;
}

.marker-current {
  display: block;
  margin-bottom: 10rpx;
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-variant-numeric: tabular-nums;
  font-size: 24rpx;
  line-height: 1.5;
  color: #182421;
}

.marker-seek-request,
.marker-seek-actual,
.marker-seek-pending {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #53615B;
}

.marker-seek-pending {
  padding: 10rpx 14rpx;
  border-radius: 6rpx;
  background-color: #F7F1E2;
  color: #745241;
}

.marker-list {
  margin: 8rpx 0 12rpx;
}

.marker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* 320px 屏幕上时间文字 + 两个动作按钮放不下时整体换行，
     动作按钮保持完整宽度，不挤出可视区，也不压扁时间文字。 */
  flex-wrap: wrap;
  row-gap: 6rpx;
  padding: 8rpx 0;
  border-top: 1px solid #E4E9E6;
}

.marker-row:first-child {
  border-top: none;
}

.marker-time {
  flex: 0 0 auto;
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-variant-numeric: tabular-nums;
  font-size: 30rpx;
  line-height: 1.5;
  color: #182421;
  white-space: nowrap;
}

.marker-actions {
  display: flex;
  flex: 0 0 auto;
  flex-wrap: nowrap;
  justify-content: flex-end;
  margin-left: auto;
}

/* 微信默认 button 宽 184px，两个按钮在 320px 屏幕上会越界；
   这里显式收窄到 84px（仍大于 44px 触控宽），并保留 44px 最小高度。
   选择器比后面的 .secondary-button 更具体，避免内边距/字号被覆盖。 */
.marker-actions .marker-button {
  flex: 0 0 84px;
  width: 84px;
  min-width: 84px;
  max-width: 84px;
  box-sizing: border-box;
  margin: 0 0 0 8rpx;
  padding: 12rpx 8rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

.marker-notice,
.marker-error {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.marker-notice {
  color: #1F5948;
}

.marker-error {
  padding: 12rpx 16rpx;
  border-radius: 6rpx;
  background-color: #F7E6DB;
  color: #813323;
}

/* 已保存副本的移除确认 */
.confirm-box {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 6rpx;
  background-color: #F7F1E2;
}

.confirm-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #745241;
  margin-bottom: 8rpx;
}

/* 常用触控目标至少 44×44 逻辑像素 */
.primary-button,
.secondary-button {
  min-height: 44px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
}

.primary-button::after,
.secondary-button::after {
  border: none;
}

.primary-button {
  background-color: #1F5948;
  color: #FFFFFF;
  border-radius: 8rpx;
  font-size: 30rpx;
  padding: 22rpx;
  border: none;
}

.secondary-button {
  background-color: #FFFFFF;
  color: #1F5948;
  border: 2rpx solid #1F5948;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 18rpx;
}
