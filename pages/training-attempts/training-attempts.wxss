/**
 * 本场逐把页样式（T036 / T042）
 * 与单线记录页同一套配色；备注编辑、更正结果与原把次行一一对应。
 */

page {
  background-color: #F2F4F3;
}

.page {
  padding: 12px 16px 28px;
  background-color: #F2F4F3;
}

.card {
  background-color: #FFFFFF;
  border-radius: 8rpx;
  padding: 16px;
  margin-bottom: 12px;
}

.card-title {
  display: block;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans CJK SC",
    "Source Han Sans SC", "Microsoft YaHei", sans-serif;
  line-height: 1.35;
  font-weight: 700;
  font-size: 32rpx;
  color: #182421;
  margin-bottom: 16rpx;
}

.error-card {
  background-color: #F7E6DB;
}

.error-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #943A23;
  margin-bottom: 12rpx;
}

.error-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #813323;
  margin-bottom: 10rpx;
}

.error-hint {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #745241;
  margin-bottom: 16rpx;
}

.storage-error,
.notice {
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.storage-error {
  background-color: #F7E6DB;
  color: #943A23;
}

.notice {
  background-color: #F7F1E2;
  color: #745241;
}

.storage-error-text,
.notice-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.5;
}

.storage-error-hint,
.notice-hint {
  display: block;
  font-size: 22rpx;
  margin-top: 8rpx;
  opacity: 0.75;
}

/* 当前线与场次 */
.attempts-route {
  display: flex;
  align-items: stretch;
  margin: 0 0 20rpx;
  overflow: hidden;
  background: #FFFFFF;
  border: 1px solid #D7DED9;
  border-radius: 8rpx;
}

.attempts-route .route-swatch {
  width: 9rpx;
  height: auto;
  flex: none;
  border: 0;
  border-radius: 0;
  margin: 0;
}

.attempts-route-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 18rpx 22rpx;
}

.attempts-route-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #182421;
  word-break: break-all;
}

.attempts-route-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #53615B;
}

.attempts-session-meta {
  margin-top: 4rpx;
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-variant-numeric: tabular-nums;
  font-size: 22rpx;
  line-height: 1.5;
  color: #53615B;
  word-break: break-all;
}

/* 逐把 */
.empty-attempts {
  font-size: 26rpx;
  line-height: 1.6;
  color: #53615B;
  padding: 24rpx 0;
}

/* 明细行：整行可点（点哪一行就在那一行里编辑这一把的备注），命中区至少 44 逻辑像素高 */
.attempt-item {
  background-color: #FFFFFF;
  border-bottom: 1px solid #D7DED9;
}

.attempt-item:last-child {
  border-bottom: none;
}

.attempt-row-tap {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 44px;
  box-sizing: border-box;
  padding: 20rpx 0;
}

.attempt-main {
  display: flex;
  align-items: baseline;
}

.attempt-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #182421;
  margin-right: 20rpx;
}

.attempt-result {
  font-size: 28rpx;
  color: #182421;
  margin-right: 20rpx;
}

.attempt-send {
  color: #B7683D;
  font-weight: 700;
}

.attempt-time {
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-variant-numeric: tabular-nums;
  font-size: 24rpx;
  color: #53615B;
}

/* 长备注换行，不截断：原文与输入框里看到的是同一段话 */
.attempt-note {
  display: block;
  border-left: 4rpx solid #B7683D;
  padding: 3rpx 0 3rpx 16rpx;
  margin: 12rpx 0;
  font-size: 26rpx;
  line-height: 1.6;
  color: #53615B;
  word-break: break-all;
}

/* 行内的备注入口提示：和整行是同一个动作，不再是一个独立的小按钮 */
.attempt-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.attempt-note-action {
  display: block;
  font-size: 26rpx;
  line-height: 1.4;
  color: #1F5948;
}

/* 更正结果（T042）：这一行自己那一把的完攀入口，独立于点整行补备注 */
.attempt-correct-slot {
  display: flex;
  align-items: center;
}

.attempt-correct-action {
  min-height: 44px;
  box-sizing: border-box;
  padding: 10rpx 12rpx;
  font-size: 26rpx;
  line-height: 1.4;
  color: #1F5948;
  margin: 0;
}

.attempt-corrected-text {
  display: block;
  padding: 10rpx 0;
  font-size: 24rpx;
  line-height: 1.5;
  color: #1F5948;
}

/* 视频关联状态与文字入口（T023）：入口独立于点整行补备注，写在行尾 */
.attempt-video-slot {
  display: flex;
  align-items: center;
}

.attempt-video-state {
  font-size: 22rpx;
  line-height: 1.5;
  color: #53615B;
  margin-right: 12rpx;
}

.attempt-video-action {
  display: block;
  min-height: 44px;
  box-sizing: border-box;
  padding: 10rpx 0 10rpx 12rpx;
  font-size: 26rpx;
  line-height: 1.4;
  color: #1F5948;
}

.attempt-video-saved {
  color: #B7683D;
  font-weight: 700;
}

/* 备注编辑：就地展开在刚点过的那一行下面（不滚动、不挪坐标） */
.note-editor {
  margin: 4rpx 0 16rpx;
  padding: 20rpx;
  background: #F2F4F3;
  border-left: 8rpx solid #1F5948;
  border-radius: 8rpx;
}

.note-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #182421;
}

.note-context {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: #53615B;
  margin-bottom: 12rpx;
}

.note-input {
  width: 100%;
  min-height: 140rpx;
  background-color: #F2F4F3;
  border: 1px solid #D7DED9;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
  word-break: break-all;
}

.button-row {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.button-row .secondary-button,
.button-row .primary-button {
  flex: 1;
  margin: 0 8rpx;
}

.attempts-foot-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #53615B;
}

/* 通用按钮：常用触控目标至少 44×44 逻辑像素（88rpx） */
.primary-button,
.secondary-button,
.text-button {
  min-height: 44px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
}

.primary-button::after,
.secondary-button::after,
.text-button::after {
  border: none;
}

.primary-button {
  background-color: #1F5948;
  color: #FFFFFF;
  border-radius: 8rpx;
  font-size: 30rpx;
  padding: 22rpx;
  border: none;
}

.secondary-button {
  background-color: #FFFFFF;
  color: #1F5948;
  border: 2rpx solid #1F5948;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 18rpx;
}

.text-button {
  background-color: transparent;
  color: #1F5948;
  font-size: 26rpx;
  padding: 8rpx 0;
}
