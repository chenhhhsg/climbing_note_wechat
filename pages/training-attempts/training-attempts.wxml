<!--
  本场逐把（T036 / T042）
  只列所选场次与长期线路的已提交把次；按原序号、结果、备注对齐，给指定把次补/改备注。
  保存、取消与失败重试都只影响原 attemptId；撤回与恢复在单线记录页。
  T023：每一行还显示这一把的视频关联状态与文字入口，选片与待确认预览在视频页。
  T042：符合条件的完攀在自己那一行给「更正结果」，确认后只翻这一把的结果。
  T044：每一把一张卡框——完攀用深绿、未完成用深橙，卡框描边与浅色底同色系，
  结果用深底白字并写明「完攀 / 未完成」；同一套卡框供 T045 现场复用。
-->
<view class="page">
  <view wx:if="{{loadError}}" id="load-error" class="card error-card">
    <text class="error-title">本机训练档案读取失败</text>
    <text class="error-text">{{loadError}}</text>
    <text class="error-hint">原档案保持原样，没有被改写。</text>
    <button id="retry-load" class="secondary-button" bindtap="retryLoad">重试读取</button>
  </view>

  <block wx:else>
    <view wx:if="{{contextError}}" id="attempts-context-error" class="card error-card">
      <text class="error-title">这个入口不能用来查看明细</text>
      <text class="error-text">{{contextError}}</text>
      <text class="error-hint">没有改动任何数据；请从单线记录页重新进入。</text>
      <button id="attempts-back" class="secondary-button" bindtap="backToList">返回单线记录</button>
    </view>

    <block wx:if="{{ready && !contextError}}">
      <view
        wx:if="{{storageError}}"
        id="storage-error"
        class="storage-error"
        bindtap="dismissStorageError"
      >
        <text class="storage-error-text">{{storageError}}</text>
        <text class="storage-error-hint">当前操作未生效，可重试；点击收起</text>
      </view>

      <view wx:if="{{notice}}" id="notice" class="notice" bindtap="dismissNotice">
        <text class="notice-text">{{notice}}</text>
        <text class="notice-hint">点击收起</text>
      </view>

      <block wx:if="{{activeSession && selectedRoute}}">
        <view id="attempts-route" class="attempts-route">
          <view class="route-swatch" style="background: {{selectedRoute.colorHex}};"></view>
          <view class="attempts-route-info">
            <text class="attempts-route-name">{{selectedRoute.name}}</text>
            <text class="attempts-route-meta">{{selectedRoute.climbType}} {{selectedRoute.grade}} · 本场 {{attempts.length}} 把</text>
            <text id="attempts-session-meta" class="attempts-session-meta">{{activeSession.dateText}} · {{activeSession.gymName}} · {{activeSession.label}}</text>
          </view>
        </view>

        <view wx:if="{{!hasAttempts}}" id="attempts-empty" class="empty-attempts">
          <text>这一场这一条线还没有已提交把次。回到单线记录页记第一把。</text>
        </view>

        <!--
          明细行（T037）：点哪一行就在**那一行里**展开备注编辑器（只认这一行的原
          attemptId）。编辑器就在刚点过的那一行下面，45 条的明细里也不用滚过一屏；
          打开与保存都不主动滚动，刚才点过的坐标留在原处。
          编辑器是可点行区的兄弟节点，点输入框、取消与保存不会触发「重新打开」。
        -->
        <view wx:else id="attempts-list" class="attempts-list">
          <view
            wx:for="{{attempts}}"
            wx:key="id"
            id="attempt-{{item.id}}"
            class="attempt-item {{item.isSend ? 'attempt-item-send' : 'attempt-item-fail'}}"
          >
            <view
              class="attempt-row-tap"
              data-attempt-id="{{item.id}}"
              bindtap="openNoteEditor"
            >
              <view class="attempt-main">
                <text class="attempt-label">{{item.label}}</text>
                <text class="attempt-result {{item.isSend ? 'attempt-result-send' : 'attempt-result-fail'}}">{{item.resultText}}</text>
                <text class="attempt-time">{{item.timeText}}</text>
              </view>
              <text wx:if="{{item.hasNote}}" class="attempt-note">{{item.note}}</text>
              <view class="attempt-actions">
                <text class="attempt-note-action">{{item.hasNote ? '改备注 ›' : '补备注 ›'}}</text>
                <!--
                  更正结果（T042）：只出现在这一行自己那一把仍可更正的完攀上。
                  点它先弹确认（原序号、日期场次岩馆、原结果 → 未完成），确认后才改这一把；
                  catchtap 让这一下不会顺手打开备注编辑器。刚改好或不可改时这一段只留只读文字。
                -->
                <view wx:if="{{item.correctable || item.correctStatusText}}" class="attempt-correct-slot">
                  <button
                    wx:if="{{item.correctable}}"
                    id="correct-attempt-{{item.id}}"
                    class="text-button attempt-correct-action"
                    data-attempt-id="{{item.id}}"
                    catchtap="confirmCorrectRow"
                  >{{item.correctText}}</button>
                  <text
                    wx:else
                    id="corrected-attempt-{{item.id}}"
                    class="attempt-corrected-text"
                  >{{item.correctStatusText}}</text>
                </view>
                <!--
                  视频入口（T023）：只显示关联状态与文字入口，点它进入这一把的视频页。
                  catchtap 阻止冒泡：点视频入口不会顺手打开备注编辑器，两者互不干扰。
                -->
                <view class="attempt-video-slot">
                  <text id="video-state-{{item.id}}" class="attempt-video-state">{{item.videoStateText}}</text>
                  <text
                    id="open-video-{{item.id}}"
                    class="attempt-video-action {{item.hasVideo ? 'attempt-video-saved' : ''}}"
                    data-attempt-id="{{item.id}}"
                    catchtap="openAttemptVideo"
                  >{{item.videoEntryText}}</text>
                </view>
              </view>
            </view>

            <!-- 这一把的备注编辑器：只改打开时的那一把；取消不写盘，失败保留输入可原地重试 -->
            <view
              wx:if="{{noteEditor && noteEditor.attemptId === item.id}}"
              id="note-editor"
              class="note-editor"
            >
              <text class="note-title">{{noteEditor.hasNote ? '改备注' : '补备注'}}</text>
              <text class="note-context">{{noteEditor.routeName}} · {{noteEditor.attemptLabel}} · {{noteEditor.resultText}}</text>
              <textarea
                id="note-input"
                class="note-input"
                data-attempt-id="{{noteEditor.attemptId}}"
                data-edit-version="{{noteEditor.version}}"
                value="{{noteEditor.text}}"
                placeholder="例如：抓到后向右摆"
                maxlength="120"
                bindinput="onNoteInput"
              ></textarea>
              <view class="button-row">
                <button
                  id="cancel-note"
                  class="secondary-button"
                  data-attempt-id="{{noteEditor.attemptId}}"
                  data-edit-version="{{noteEditor.version}}"
                  bindtap="cancelNote"
                >取消</button>
                <button
                  id="save-note"
                  class="primary-button"
                  data-attempt-id="{{noteEditor.attemptId}}"
                  data-edit-version="{{noteEditor.version}}"
                  bindtap="saveNote"
                >保存备注</button>
              </view>
            </view>
          </view>
        </view>

        <text class="attempts-foot-hint">这里只列这一场这一条线的有效把次；撤回、恢复与结果记录在单线记录页，完攀可在这一行更正结果。</text>
      </block>
    </block>
  </block>
</view>
