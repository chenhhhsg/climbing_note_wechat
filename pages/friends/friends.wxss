/**
 * 好友列表页样式
 */

.container {
  padding: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #f5f5f5;
}

/* 邀请码卡片 */
.invite-card {
  background: linear-gradient(135deg, #2c3e50 0%, #3d566e 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 62, 80, 0.3);
}

.invite-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
}

.invite-code-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.invite-code {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 8rpx;
}

.invite-copy-btn {
  padding: 10rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #ffffff;
}

.invite-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 添加好友 */
.add-section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.add-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 20rpx;
}

.add-row {
  display: flex;
  gap: 16rpx;
}

.add-input {
  flex: 1;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  letter-spacing: 4rpx;
}

.add-btn {
  height: 72rpx;
  padding: 0 32rpx;
  background-color: #2c3e50;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.add-btn-disabled {
  opacity: 0.5;
}

/* 好友列表 */
.friends-section {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.friends-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
  padding: 24rpx 30rpx 16rpx;
}

.friend-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.friend-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.friend-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.friend-avatar-default {
  background-color: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 32rpx;
  color: #666666;
  font-weight: bold;
}

.friend-name {
  font-size: 30rpx;
  color: #333333;
}

.friend-delete {
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  color: #f44336;
}

/* 空状态 */
.friends-empty {
  text-align: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999999;
  display: block;
}

/* 加载中 */
.loading-state {
  text-align: center;
  padding: 40rpx;
  color: #999999;
  font-size: 28rpx;
}
