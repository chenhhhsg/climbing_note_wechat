<!--
  9c 攀岩体能自测（T020）
  从「我的 → 体能自测」进入。先看说明、器材与动作标准，再录入测试日期、体重与四项实测值；
  页面即时显示已有分项，四项填齐后显示总分与三对照。保存只写本机独立命名空间，
  不写训练档案、不上传原始数据、断网可用。
-->
<view class="page">
  <!-- 说明：用途、器材、动作标准与算法 -->
  <view id="intro-card" class="card intro-card">
    <text class="section-title">{{specVersionText}}</text>
    <text class="intro-text">用途：看自己的指力、上肢拉力、核心动作和单杠悬挂耐力各测到了什么水平，复测时看出哪项变了。自测独立于线路记录，不是记线路的前置条件。</text>
    <text class="intro-text">器材：约 20 mm 指力板、可加负重的腰带或负重带、单杠、秒表或手机计时。</text>
    <text class="intro-text">动作标准：指力＝双手在约 20 mm 指力板边缘悬挂满 5 秒；拉力＝单杠完成 1 次标准引体向上；核心＝悬垂屈膝 L 举、直腿 L 举或前水平，填写得分最高的一项；悬挂耐力＝双手固定握单杠自重悬挂。</text>
    <text class="intro-text">算法：每项最多 10 分，取已经达到的最高档，两档之间保留较低档，超出最高档封顶；负重项用（当日体重＋额外负重）÷ 当日体重；四项直接相加，满分 40，总分查原表得到法式、YDS 与抱石跨项目对照。</text>
    <text class="intro-text">空白表示未测；明确测过但没达到第一档记 0 分；额外负重 0 kg 表示自重完成。抱石对照只是跨项目参考标签，不代表实际完攀能力。本页保存 {{tableVersionText}}。</text>
    <text class="intro-text">来源：9c 测试由 Stian Christophersen 与 Martin Mobråten 设计，Magnus Midtbø 演示；总分对照表沿用原表与 IRCRA 线路列。</text>
  </view>

  <!-- 本机自测记录损坏或版本不支持：显示可见错误，保留原数据 -->
  <view wx:if="{{loadError}}" id="load-error" class="card error-card">
    <text class="error-title">本机自测记录读取失败</text>
    <text class="error-text">{{loadError}}</text>
    <text class="error-hint">原记录保持原样，没有被改写。</text>
    <button id="retry-load" class="secondary-button" bindtap="retryLoad">重试读取</button>
  </view>

  <block wx:else>
    <view wx:if="{{storageError}}" id="storage-error" class="storage-error" bindtap="dismissStorageError">
      <text class="storage-error-text">{{storageError}}</text>
      <text class="storage-error-hint">当前操作未生效，可重试；点击收起</text>
    </view>

    <view wx:if="{{notice}}" id="notice" class="notice" bindtap="dismissNotice">
      <text class="notice-text">{{notice}}</text>
      <text class="notice-hint">点击收起</text>
    </view>

    <!-- 录入表单 -->
    <view wx:if="{{formVisible}}" id="form-card" class="card form-card">
      <text class="section-title">{{formTitle}}</text>
      <text wx:if="{{editingText}}" id="editing-text" class="form-hint">{{editingText}}</text>

      <view class="form-row">
        <text class="form-label">测试日期</text>
        <picker mode="date" value="{{date}}" bindchange="onDateChange">
          <view id="date-picker" class="picker-value">{{date}}</view>
        </picker>
      </view>

      <view class="form-row">
        <text class="form-label">当日体重（kg）</text>
        <input
          id="weight-input"
          class="form-input"
          type="digit"
          value="{{weightKg}}"
          placeholder="例如 60"
          bindinput="onWeightInput"
        />
      </view>

      <!-- 指力 -->
      <view class="item-block">
        <text class="item-title">指力（额外负重，kg）</text>
        <picker range="{{loadStateLabels}}" value="{{fingerStateIndex}}" bindchange="onFingerStateChange">
          <view id="finger-state-picker" class="picker-value">{{loadStateLabels[fingerStateIndex]}}</view>
        </picker>
        <input
          wx:if="{{fingerDone}}"
          id="finger-extra-input"
          class="form-input"
          type="digit"
          value="{{fingerExtraKg}}"
          placeholder="只挂自重请填 0"
          bindinput="onFingerExtraInput"
        />
        <text class="item-hint">已测未达＝测过但没完成 5 秒悬挂，记 0 分。</text>
      </view>

      <!-- 拉力 -->
      <view class="item-block">
        <text class="item-title">拉力（额外负重，kg）</text>
        <picker range="{{loadStateLabels}}" value="{{pullStateIndex}}" bindchange="onPullStateChange">
          <view id="pull-state-picker" class="picker-value">{{loadStateLabels[pullStateIndex]}}</view>
        </picker>
        <input
          wx:if="{{pullDone}}"
          id="pull-extra-input"
          class="form-input"
          type="digit"
          value="{{pullExtraKg}}"
          placeholder="只挂自重请填 0"
          bindinput="onPullExtraInput"
        />
        <text class="item-hint">已测未达＝测过但没完成 1 次标准引体向上，记 0 分。</text>
      </view>

      <!-- 核心动作 -->
      <view class="item-block">
        <text class="item-title">核心动作（得分最高的一项）</text>
        <picker range="{{coreActionLabels}}" value="{{coreActionIndex}}" bindchange="onCoreActionChange">
          <view id="core-action-picker" class="picker-value">
            {{coreActionIndex >= 0 ? coreActionLabels[coreActionIndex] : '未选择动作'}}
          </view>
        </picker>
        <input
          id="core-seconds-input"
          class="form-input"
          type="digit"
          value="{{coreSeconds}}"
          placeholder="持续秒数，留空＝未测"
          bindinput="onCoreSecondsInput"
        />
      </view>

      <!-- 悬挂耐力 -->
      <view class="item-block">
        <text class="item-title">悬挂耐力（自重，秒）</text>
        <input
          id="hang-seconds-input"
          class="form-input"
          type="digit"
          value="{{hangSeconds}}"
          placeholder="双手固定握单杠，留空＝未测"
          bindinput="onHangSecondsInput"
        />
      </view>

      <text wx:if="{{formError}}" id="form-error" class="form-error">{{formError}}</text>

      <button id="save-test" class="btn-primary save-button" bindtap="saveTest">保存本次自测</button>
      <button id="new-test" class="secondary-button" bindtap="startNewTest">新建复测</button>
    </view>

    <!-- 即时结果：已有分项 + 四项填齐后的总分与三对照 -->
    <view id="preview-card" class="card result-card">
      <text class="section-title">本次分项与总分</text>
      <text id="preview-count" class="form-hint">{{preview.measuredCountText}}</text>
      <view wx:for="{{preview.items}}" wx:key="key" id="preview-{{item.key}}" class="result-row">
        <view class="result-head">
          <text class="result-label">{{item.label}}</text>
          <text class="result-status">{{item.statusText}}</text>
          <text class="result-points">{{item.pointsText}}</text>
        </view>
        <text class="result-raw">{{item.rawText}}</text>
        <text wx:if="{{item.levelText}}" class="result-level">{{item.levelText}}</text>
      </view>
      <text id="preview-total" class="result-total">{{preview.totalText}}</text>
      <view wx:for="{{preview.gradeLines}}" wx:key="key" id="grade-{{item.key}}" class="grade-line">
        <text class="grade-label">{{item.label}}</text>
        <text class="grade-value">{{item.value}}</text>
      </view>
    </view>

    <!-- 已保存的本机自测记录 -->
    <view id="records-card" class="card records-card">
      <text class="section-title">本机自测记录</text>
      <text id="records-count" class="form-hint">{{recordCountText}}{{archiveText ? ' · ' + archiveText : ''}}</text>
      <text id="records-empty" wx:if="{{!records.length}}" class="text-secondary">还没有保存过自测；填好上面四项后点「保存本次自测」。</text>

      <view wx:for="{{records}}" wx:key="id" id="record-{{item.id}}" class="record-row">
        <view class="record-head">
          <text class="record-date">{{item.date}}</text>
          <text class="record-total">{{item.totalText}}</text>
        </view>
        <text class="record-grade">{{item.gradeText}}</text>
        <text class="record-items">{{item.itemsText}}</text>
        <text class="record-version">{{item.tableVersionText}}</text>
        <view class="record-actions">
          <button class="secondary-button small-button" data-id="{{item.id}}" bindtap="editRecord">修改</button>
          <button class="secondary-button small-button" data-id="{{item.id}}" bindtap="toggleCompare">
            {{item.selected ? '取消比较' : '选择比较'}}
          </button>
        </view>
      </view>

      <button
        wx:if="{{selectedIds.length}}"
        id="clear-compare"
        class="text-button"
        bindtap="clearCompare"
      >清空比较选择</button>
    </view>

    <!-- 两次自测比较：各分项原始数据与总分 -->
    <view wx:if="{{comparison}}" id="comparison-card" class="card compare-card">
      <text class="section-title">两次自测比较</text>
      <text id="compare-left" class="compare-summary">{{comparison.summary.leftText}}</text>
      <text id="compare-right" class="compare-summary">{{comparison.summary.rightText}}</text>
      <view wx:for="{{comparison.rows}}" wx:key="key" id="compare-{{item.key}}" class="compare-row">
        <text class="compare-label">{{item.label}}</text>
        <text class="compare-value">前：{{item.left.rawText}} · {{item.left.pointsText}}（{{item.left.statusText}}）</text>
        <text class="compare-value">后：{{item.right.rawText}} · {{item.right.pointsText}}（{{item.right.statusText}}）</text>
        <text class="compare-delta">{{item.deltaText}}</text>
      </view>
      <text id="compare-total-delta" class="compare-delta">{{comparison.summary.totalDeltaText}}</text>
    </view>
  </block>
</view>
