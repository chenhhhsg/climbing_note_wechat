/**
 * 9c 攀岩体能自测页样式（沿用正式页面样式：白卡片 + 深色主按钮）
 */

.page {
  padding: 20rpx;
  padding-bottom: 60rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #173d32;
  margin-bottom: 16rpx;
}

/* 说明区 */
.intro-card {
  background-color: #fffcf3;
}

.intro-text {
  display: block;
  font-size: 26rpx;
  color: #555555;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

/* 错误与提示 */
.error-card {
  border-left: 8rpx solid #9c3d22;
}

.error-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #9c3d22;
  margin-bottom: 10rpx;
}

.error-text {
  display: block;
  font-size: 26rpx;
  color: #22372f;
  margin-bottom: 10rpx;
}

.error-hint {
  display: block;
  font-size: 24rpx;
  color: #606d61;
  margin-bottom: 20rpx;
}

.storage-error,
.notice {
  background-color: #f6ead5;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.storage-error-text,
.notice-text {
  display: block;
  font-size: 26rpx;
  color: #804b27;
}

.storage-error-hint,
.notice-hint {
  display: block;
  font-size: 22rpx;
  color: #c08a3e;
  margin-top: 6rpx;
}

.notice {
  background-color: #e4ebdf;
}

.notice-text {
  color: #315747;
}

.notice-hint {
  color: #5c93c4;
}

/* 表单 */
.form-card {
  background-color: #fffcf3;
}

.form-hint {
  display: block;
  font-size: 24rpx;
  color: #606d61;
  margin-bottom: 16rpx;
}

.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #dcdccc;
}

.form-label {
  font-size: 28rpx;
  color: #22372f;
}

.form-input {
  flex: 1;
  margin-left: 20rpx;
  text-align: right;
  font-size: 28rpx;
  color: #173d32;
}

.picker-value {
  font-size: 28rpx;
  color: #173d32;
  padding: 6rpx 16rpx;
  background-color: #f7f4ea;
  border-radius: 8rpx;
  min-width: 140rpx;
  text-align: center;
}

.item-block {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #dcdccc;
}

.item-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #173d32;
  margin-bottom: 12rpx;
}

.item-block .picker-value {
  display: inline-block;
}

.item-block .form-input {
  display: block;
  width: 100%;
  margin: 12rpx 0 0 0;
  text-align: left;
  background-color: #f0eddf;
  border-radius: 8rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.item-hint {
  display: block;
  font-size: 22rpx;
  color: #606d61;
  margin-top: 10rpx;
}

.form-error {
  display: block;
  font-size: 26rpx;
  color: #9c3d22;
  margin: 16rpx 0;
}

.save-button {
  margin-top: 30rpx;
}

.secondary-button {
  margin-top: 16rpx;
  background-color: #fffcf3;
  color: #173d32;
  border: 2rpx solid #173d32;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 16rpx 30rpx;
  text-align: center;
}

.secondary-button::after {
  border: none;
}

.small-button {
  display: inline-block;
  margin: 0 12rpx 0 0;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
}

.text-button {
  background-color: transparent;
  color: #173d32;
  font-size: 26rpx;
  margin-top: 16rpx;
  padding: 10rpx 0;
  text-align: center;
}

.text-button::after {
  border: none;
}

/* 即时结果 */
.result-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #dcdccc;
}

.result-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.result-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #173d32;
}

.result-status {
  font-size: 24rpx;
  color: #355e50;
}

.result-points {
  font-size: 28rpx;
  color: #173d32;
}

.result-raw {
  display: block;
  font-size: 24rpx;
  color: #526157;
  margin-top: 6rpx;
}

.result-level {
  display: block;
  font-size: 22rpx;
  color: #606d61;
  margin-top: 4rpx;
}

.result-total {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #173d32;
  margin-top: 20rpx;
}

.grade-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.grade-label {
  font-size: 26rpx;
  color: #526157;
}

.grade-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #173d32;
}

/* 记录列表 */
.record-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #dcdccc;
}

.record-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-date {
  font-size: 28rpx;
  font-weight: bold;
  color: #173d32;
}

.record-total {
  font-size: 28rpx;
  color: #173d32;
}

.record-grade {
  display: block;
  font-size: 24rpx;
  color: #526157;
  margin-top: 6rpx;
}

.record-items {
  display: block;
  font-size: 24rpx;
  color: #606d61;
  margin-top: 6rpx;
}

.record-version {
  display: block;
  font-size: 22rpx;
  color: #bbbbbb;
  margin-top: 6rpx;
}

/* 每条记录的两个版本号（评分规则 / 等级对照表）与来源说明 */
.record-versions {
  margin-top: 2rpx;
}

.record-actions {
  margin-top: 14rpx;
}

/* 两次比较 */
.compare-summary {
  display: block;
  font-size: 24rpx;
  color: #526157;
  margin-bottom: 8rpx;
}

.compare-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #dcdccc;
}

.compare-label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #173d32;
  margin-bottom: 6rpx;
}

.compare-value {
  display: block;
  font-size: 24rpx;
  color: #555555;
}

.compare-delta {
  display: block;
  font-size: 24rpx;
  color: #355e50;
  margin-top: 6rpx;
}

/* 岩馆手册 */
.form-row { flex-wrap:wrap; column-gap:16rpx; row-gap:6rpx; }
.form-input,.item-block .form-input { box-sizing:border-box; min-height:88rpx; height:88rpx; padding:0 18rpx; line-height:normal; border:1px solid #babfae; border-radius:6rpx; font-size:30rpx; }
.form-row .form-input { min-width:150rpx; }
.grade-value,.result-points { color:#173d32; font-family:Georgia,"SimSun",serif; }
