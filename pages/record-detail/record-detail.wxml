<!--
  记录详情页面 - 完整字段展示
-->
<view class="container">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <!-- 记录详情 -->
  <view wx:elif="{{record}}" class="record-detail">
    <!-- 状态标签 -->
    <view class="status-bar">
      <view class="status-tag-wrap {{record.isCompleted ? 'status-success' : 'status-fail'}}">
        <text class="status-tag-icon">
          {{record.status === 'flash' ? '⚡' : record.status === 'completed' ? '✅' : record.status === 'project' ? '🎯' : '❌'}}
        </text>
        <text class="status-tag-text">{{record.statusLabel}}</text>
      </view>
      <text class="record-date">{{record.dateText}}</text>
    </view>

    <!-- 基本信息卡片 -->
    <view class="card">
      <view class="card-title">基本信息</view>
      <view class="info-grid">
        <view class="info-item">
          <text class="info-label">攀岩类型</text>
          <text class="info-value">{{record.climbTypeLabel}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">难度等级</text>
          <text class="info-value grade">{{record.grade}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">攀岩地点</text>
          <text class="info-value">{{record.location || '-'}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">尝试次数</text>
          <text class="info-value">{{record.attempts}}次</text>
        </view>
      </view>
    </view>

    <!-- 线路信息卡片 -->
    <view wx:if="{{record.routeName || record.routeColor || record.area}}" class="card">
      <view class="card-title">线路信息</view>
      <view class="info-grid">
        <view wx:if="{{record.routeName}}" class="info-item">
          <text class="info-label">线路编号</text>
          <text class="info-value">{{record.routeName}}</text>
        </view>
        <view wx:if="{{record.routeColor}}" class="info-item">
          <text class="info-label">线路颜色</text>
          <view class="color-tag">{{record.routeColor}}</view>
        </view>
        <view wx:if="{{record.area}}" class="info-item">
          <text class="info-label">区域</text>
          <text class="info-value">{{record.area}}</text>
        </view>
      </view>
    </view>

    <!-- Project 信息 -->
    <view wx:if="{{record.isProject}}" class="card">
      <view class="card-title">Project 追线</view>
      <view class="info-grid">
        <view class="info-item">
          <text class="info-label">状态</text>
          <text class="info-value project-status-{{record.projectStatus}}">{{record.projectStatusText}}</text>
        </view>
        <view wx:if="{{record.completedDate}}" class="info-item">
          <text class="info-label">完成日期</text>
          <text class="info-value">{{record.completedDate}}</text>
        </view>
      </view>
      <!-- Project 状态操作 -->
      <view class="project-actions">
        <view wx:if="{{record.projectStatus === 'active'}}" class="project-btn-group">
          <button class="btn-project-complete" bindtap="updateProjectStatus" data-status="completed">标记完成</button>
          <button class="btn-project-abandon" bindtap="updateProjectStatus" data-status="abandoned">放弃</button>
        </view>
        <view wx:elif="{{record.projectStatus === 'completed'}}" class="project-btn-group">
          <button class="btn-project-reactivate" bindtap="updateProjectStatus" data-status="active">重新开始</button>
        </view>
        <view wx:elif="{{record.projectStatus === 'abandoned'}}" class="project-btn-group">
          <button class="btn-project-reactivate" bindtap="updateProjectStatus" data-status="active">重新开始</button>
        </view>
      </view>
    </view>

    <!-- 备注卡片 -->
    <view wx:if="{{record.notes}}" class="card">
      <view class="card-title">备注</view>
      <view class="notes-content">
        <text>{{record.notes}}</text>
      </view>
    </view>

    <!-- 图片卡片 -->
    <view wx:if="{{record.images && record.images.length > 0}}" class="card">
      <view class="card-title">图片 ({{record.images.length}})</view>
      <view class="image-grid">
        <image
          wx:for="{{record.images}}"
          wx:key="*this"
          src="{{item}}"
          mode="aspectFill"
          class="image-item"
          bindtap="previewImage"
          data-url="{{item}}"
        />
      </view>
    </view>

    <!-- 创建时间 -->
    <view class="create-time">
      <text>记录于 {{record.dateText}}</text>
    </view>

    <!-- 操作按钮 -->
    <view class="actions">
      <view class="action-buttons">
        <button class="btn-edit" bindtap="editRecord">编辑记录</button>
        <button class="btn-delete" bindtap="deleteRecord">删除记录</button>
      </view>
    </view>
  </view>
</view>
