<!--
  旧记录详情页（T018：只读回看）
  按原 _id 显示旧记录的原字段与图片引用：「尝试 5 次、完成」只是一条历史汇总，
  不拆成逐把、不计入本机统计、不更新或删除旧记录。
-->
<view class="container">
  <!-- 加载中 -->
  <view wx:if="{{state === 'loading'}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <!-- 缺少 ID -->
  <view wx:elif="{{state === 'missing'}}" class="error-state">
    <text class="error-text">{{errorTitle}}</text>
    <text class="error-hint">{{errorHint}}</text>
  </view>

  <!-- 空库 / 记录不存在 / 云环境不可用 / 没有权限 / 读取失败：状态可区分，都可重试 -->
  <view wx:elif="{{state !== 'ready'}}" id="record-{{state}}" class="error-state">
    <text class="error-text">{{errorTitle}}</text>
    <text class="error-hint">{{errorHint}}</text>
    <button wx:if="{{recordId}}" class="btn-retry" bindtap="retryLoad">重试</button>
  </view>

  <!-- 旧记录（只读回看） -->
  <view wx:else class="record-detail">
    <!-- 状态标签 -->
    <view class="status-bar">
      <text class="status-tag {{view.status === '完成' ? 'status-success' : 'status-fail'}}">
        {{view.status || '旧记录'}}
      </text>
      <text class="record-date">{{view.dateText}}</text>
    </view>

    <!-- 历史汇总：一条旧汇总只显示一条，不拆成逐把 -->
    <view id="legacy-summary" class="summary-card">
      <text class="summary-text">{{view.summaryText}}</text>
      <text class="summary-hint">{{view.readOnlyHint}}</text>
      <text wx:if="{{view.hasEmbeddedRoutes}}" class="summary-embedded">
        原记录自带 {{view.embeddedRouteCount}} 条明细结构：按原结构只读保留，不拆成逐把。
      </text>
      <text class="summary-note">这条旧汇总不计入本机训练历史的逐把统计。</text>
    </view>

    <!-- 基本信息卡片 -->
    <view class="card">
      <view class="card-title">基本信息</view>
      <view class="info-grid">
        <view class="info-item">
          <text class="info-label">攀岩类型</text>
          <text class="info-value">{{view.climbType || '-'}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">难度等级</text>
          <text class="info-value grade">{{view.grade || '-'}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">攀岩地点</text>
          <text class="info-value">{{view.location || '-'}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">尝试次数</text>
          <text class="info-value">{{view.attemptsText || '-'}}</text>
        </view>
      </view>
    </view>

    <!-- 备注卡片 -->
    <view wx:if="{{view.notes}}" class="card">
      <view class="card-title">备注</view>
      <view class="notes-content">
        <text>{{view.notes}}</text>
      </view>
    </view>

    <!-- 图片卡片（原图片引用，只预览） -->
    <view wx:if="{{view.images.length > 0}}" class="card">
      <view class="card-title">图片</view>
      <view class="image-grid">
        <image
          wx:for="{{view.images}}"
          wx:key="*this"
          src="{{item}}"
          mode="aspectFill"
          class="image-item"
          bindtap="previewImage"
          data-url="{{item}}"
        />
      </view>
    </view>

    <!-- 只读说明：本单的旧数据回看只读 -->
    <view id="read-only-notice" class="read-only-notice">
      <text class="read-only-text">旧记录为只读回看：不修改、不删除、不拆成逐把，也不并入本机训练统计。</text>
    </view>
  </view>
</view>
