/**
 * 旧记录详情页面样式（T018：只读回看）
 */

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
}

/* 读取失败 / 空库 / 无权限 / 云不可用：有区别的状态，都可重试 */
.error-state {
  text-align: center;
  padding: 100rpx 0;
}

.error-text {
  font-size: 30rpx;
  color: #666666;
  display: block;
  margin-bottom: 16rpx;
}

.error-hint {
  font-size: 24rpx;
  color: #999999;
  display: block;
  margin-bottom: 30rpx;
}

.btn-retry {
  background-color: #2c3e50;
  color: #ffffff;
  border-radius: 12rpx;
  padding: 18rpx 60rpx;
  font-size: 28rpx;
  display: inline-block;
  border: none;
}

.btn-retry::after {
  border: none;
}

/* 状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.status-tag {
  padding: 12rpx 30rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.status-success {
  background-color: #e8f5e9;
  color: #4caf50;
}

.status-fail {
  background-color: #ffebee;
  color: #f44336;
}

.record-date {
  font-size: 30rpx;
  color: #666666;
}

/* 卡片 */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 信息网格 */
.info-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 0;
}

.info-item {
  width: 50%;
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 30rpx;
  color: #333333;
}

.info-value.grade {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c3e50;
}

/* 备注 */
.notes-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

/* 历史汇总（一条旧汇总只显示一条） */
.summary-card {
  background-color: #fff8e1;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.summary-text {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #8d6e63;
}

.summary-hint,
.summary-embedded,
.summary-note {
  display: block;
  font-size: 24rpx;
  color: #8d6e63;
  margin-top: 8rpx;
}

/* 只读说明 */
.read-only-notice {
  margin-top: 30rpx;
  padding: 24rpx;
  background-color: #f0f0f0;
  border-radius: 12rpx;
}

.read-only-text {
  font-size: 24rpx;
  color: #666666;
}

/* 图片网格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}
