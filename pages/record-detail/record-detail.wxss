/**
 * 记录详情页面样式
 */

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
}

/* 状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.status-tag {
  padding: 12rpx 30rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.status-success {
  background-color: #e8f5e9;
  color: #4caf50;
}

.status-fail {
  background-color: #ffebee;
  color: #f44336;
}

.record-date {
  font-size: 30rpx;
  color: #666666;
}

/* 卡片 */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 信息网格 */
.info-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 0;
}

.info-item {
  width: 50%;
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 30rpx;
  color: #333333;
}

.info-value.grade {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c3e50;
}

/* 备注 */
.notes-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

/* 图片网格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

/* 创建时间 */
.create-time {
  text-align: center;
  padding: 30rpx 0;
  color: #999999;
  font-size: 26rpx;
}

/* 操作按钮 */
.actions {
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}

.btn-delete {
  background-color: #ffffff;
  color: #f44336;
  border: 2rpx solid #f44336;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
}

.btn-delete::after {
  border: none;
}
