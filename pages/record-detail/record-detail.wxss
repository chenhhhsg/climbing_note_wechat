/**
 * 记录详情页面样式 - 攀岩 Session 详情
 */

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 80rpx 0;
  color: #999999;
  font-size: 26rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  display: block;
}

/* ========== Session 概览卡片 ========== */
.overview-card {
  margin-bottom: 24rpx;
}

.overview-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.overview-header-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.overview-date {
  font-size: 34rpx;
  font-weight: bold;
  color: #2c3e50;
}

.overview-location {
  font-size: 28rpx;
  color: #999999;
}

.overview-stats {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
}

.overview-stat {
  text-align: center;
}

.overview-stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.stat-success {
  color: #4caf50;
}

.stat-project {
  color: #2196f3;
}

.overview-stat-label {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

.overview-notes {
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

/* ========== 线路列表 ========== */
.routes-section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 16rpx;
}

.route-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.route-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.route-grade {
  font-size: 40rpx;
  font-weight: bold;
  color: #2c3e50;
}

.route-status-tag {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.route-status-success {
  background-color: #e8f5e9;
  color: #4caf50;
}

.route-status-project {
  background-color: #e3f2fd;
  color: #2196f3;
}

.route-status-fail {
  background-color: #ffebee;
  color: #f44336;
}

.route-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.route-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  background-color: #f5f5f5;
  color: #666666;
  border-radius: 8rpx;
}

.route-attempts {
  font-size: 24rpx;
  color: #999999;
}

.route-notes {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.route-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.route-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 10rpx;
}

/* ========== 操作按钮 ========== */
.actions {
  margin-top: 32rpx;
  padding-bottom: 60rpx;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
}

.btn-edit {
  flex: 2;
  background-color: #2c3e50;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 30rpx;
  border: none;
  font-weight: bold;
}

.btn-edit::after {
  border: none;
}

.btn-delete {
  flex: 1;
  background-color: #ffffff;
  color: #f44336;
  border: 2rpx solid #f44336;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 30rpx;
}

.btn-delete::after {
  border: none;
}
