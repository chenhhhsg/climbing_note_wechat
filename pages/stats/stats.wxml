<!--
  统计页面 - 基于 climbing_sessions 的攀岩统计
-->
<view class="container">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{isEmpty}}" class="empty-tip">
    <text class="empty-icon">📊</text>
    <text class="empty-text">还没有统计数据</text>
    <text class="empty-hint">先添加一次攀岩记录吧</text>
  </view>

  <view wx:else>

    <!-- 一、核心数据卡片 -->
    <view class="stats-grid">
      <view class="stat-card">
        <text class="stat-number">{{totalSessions}}</text>
        <text class="stat-label">总进馆次数</text>
      </view>
      <view class="stat-card">
        <text class="stat-number">{{totalRoutes}}</text>
        <text class="stat-label">总线路数</text>
      </view>
      <view class="stat-card">
        <text class="stat-number">{{monthSessions}}</text>
        <text class="stat-label">本月进馆</text>
      </view>
      <view class="stat-card">
        <text class="stat-number">{{monthRoutes}}</text>
        <text class="stat-label">本月线路</text>
      </view>
      <view class="stat-card highlight">
        <text class="stat-number">{{maxGrade}}</text>
        <text class="stat-label">最高难度</text>
      </view>
      <view class="stat-card">
        <text class="stat-number">{{completionRate}}%</text>
        <text class="stat-label">总完成率</text>
      </view>
    </view>

    <!-- 二、线路状态统计 -->
    <view class="section-card">
      <view class="section-title">线路状态</view>
      <view class="status-grid">
        <view class="status-item">
          <text class="status-icon">⚡</text>
          <text class="status-num status-flash">{{flashCount}}</text>
          <text class="status-label">Flash</text>
        </view>
        <view class="status-item">
          <text class="status-icon">✅</text>
          <text class="status-num status-completed">{{completedCount}}</text>
          <text class="status-label">完成</text>
        </view>
        <view class="status-item">
          <text class="status-icon">❌</text>
          <text class="status-num status-failed">{{failedCount}}</text>
          <text class="status-label">未完成</text>
        </view>
        <view class="status-item">
          <text class="status-icon">🎯</text>
          <text class="status-num status-project">{{projectCount}}</text>
          <text class="status-label">Project</text>
        </view>
      </view>
      <!-- 完成率进度条 -->
      <view class="progress-section">
        <view class="progress-bar-bg">
          <view class="progress-bar-fill" style="width: {{completionRate}}%"></view>
        </view>
        <text class="progress-text">{{completionRate}}%</text>
      </view>
    </view>

    <!-- 三、攀岩类型分布 -->
    <view wx:if="{{typeDistribution.length > 0}}" class="section-card">
      <view class="section-title">攀岩类型</view>
      <view class="type-list">
        <view wx:for="{{typeDistribution}}" wx:key="type" class="type-item">
          <view class="type-info">
            <text class="type-name">{{item.label}}</text>
            <text class="type-count">{{item.count}} 条 ({{item.percentage}}%)</text>
          </view>
          <view class="type-bar-bg">
            <view class="type-bar-fill" style="width: {{item.percentage}}%"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 四、常去岩馆 Top 5 -->
    <view wx:if="{{topLocations.length > 0}}" class="section-card">
      <view class="section-title">常去岩馆</view>
      <view class="location-list">
        <view wx:for="{{topLocations}}" wx:key="name" class="location-item">
          <text class="location-rank">{{index + 1}}</text>
          <text class="location-name">{{item.name}}</text>
          <text class="location-count">{{item.count}} 次</text>
        </view>
      </view>
    </view>

    <!-- 五、最近 6 个月趋势 -->
    <view wx:if="{{monthTrend.length > 0}}" class="section-card">
      <view class="section-title-row">
        <text class="section-title">月度趋势</text>
        <view class="trend-tabs">
          <text class="trend-tab {{trendMode === 'sessions' ? 'trend-tab-active' : ''}}" bindtap="onTrendModeChange" data-mode="sessions">进馆</text>
          <text class="trend-tab {{trendMode === 'routes' ? 'trend-tab-active' : ''}}" bindtap="onTrendModeChange" data-mode="routes">线路</text>
        </view>
      </view>

      <view class="trend-chart">
        <view wx:for="{{monthTrend}}" wx:key="month" class="trend-item">
          <view class="trend-bar-bg">
            <view
              wx:if="{{trendMode === 'sessions'}}"
              class="trend-bar-fill"
              style="height: {{item.sessions > 0 ? (item.sessions / monthTrendSessionsMax * 100) : 0}}%"
            ></view>
            <view
              wx:else
              class="trend-bar-fill trend-bar-routes"
              style="height: {{item.routes > 0 ? (item.routes / monthTrendRoutesMax * 100) : 0}}%"
            ></view>
          </view>
          <text class="trend-count">{{trendMode === 'sessions' ? item.sessions : item.routes}}</text>
          <text class="trend-month">{{item.month}}</text>
        </view>
      </view>
    </view>

  </view>
</view>
