<!--
  统计页面 - 完整统计数据展示
-->
<view class="container">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <view wx:else>
    <!-- 核心数据卡片 -->
    <view class="stats-grid">
      <view class="stat-card">
        <text class="stat-number">{{totalClimbs}}</text>
        <text class="stat-label">总攀岩次数</text>
      </view>
      <view class="stat-card">
        <text class="stat-number">{{monthClimbs}}</text>
        <text class="stat-label">本月攀岩</text>
      </view>
      <view class="stat-card highlight">
        <text class="stat-number">{{maxGrade}}</text>
        <text class="stat-label">最高难度</text>
      </view>
      <view class="stat-card">
        <text class="stat-number">{{completionRate}}%</text>
        <text class="stat-label">完成率</text>
      </view>
    </view>

    <!-- 次要数据 -->
    <view class="stats-row">
      <view class="stat-mini">
        <text class="stat-mini-number">{{flashCount}}</text>
        <text class="stat-mini-label">Flash 次数</text>
      </view>
      <view class="stat-mini">
        <text class="stat-mini-number">{{projectCount}}</text>
        <text class="stat-mini-label">Project 总数</text>
      </view>
    </view>

    <!-- Project 统计 -->
    <view wx:if="{{projectCount > 0}}" class="stats-row">
      <view class="stat-mini">
        <text class="stat-mini-number stat-active">{{projectActive}}</text>
        <text class="stat-mini-label">进行中</text>
      </view>
      <view class="stat-mini">
        <text class="stat-mini-number stat-completed">{{projectCompleted}}</text>
        <text class="stat-mini-label">已完成</text>
      </view>
      <view class="stat-mini">
        <text class="stat-mini-number stat-abandoned">{{projectAbandoned}}</text>
        <text class="stat-mini-label">已放弃</text>
      </view>
    </view>

    <!-- 完成率进度条 -->
    <view class="section-card">
      <view class="section-title">完成率</view>
      <view class="progress-section">
        <view class="progress-bar-bg">
          <view class="progress-bar-fill" style="width: {{completionRate}}%"></view>
        </view>
        <text class="progress-text">{{completionRate}}%</text>
      </view>
      <view class="progress-detail">
        <text class="progress-info">共 {{totalClimbs}} 次攀岩，其中 {{flashCount}} 次 Flash</text>
      </view>
    </view>

    <!-- 月度趋势 -->
    <view wx:if="{{monthTrend.length > 0}}" class="section-card">
      <view class="section-title">月度趋势</view>
      <view class="trend-chart">
        <view wx:for="{{monthTrend}}" wx:key="month" class="trend-item">
          <view class="trend-bar-bg">
            <view
              class="trend-bar-fill"
              style="height: {{item.count > 0 ? (item.count / monthTrendMax * 100) : 0}}%"
            ></view>
          </view>
          <text class="trend-count">{{item.count}}</text>
          <text class="trend-month">{{item.month}}</text>
        </view>
      </view>
    </view>

    <!-- 攀岩类型分布 -->
    <view wx:if="{{typeDistribution.length > 0}}" class="section-card">
      <view class="section-title">攀岩类型</view>
      <view class="type-list">
        <view
          wx:for="{{typeDistribution}}"
          wx:key="type"
          class="type-item"
        >
          <view class="type-info">
            <text class="type-name">{{item.label}}</text>
            <text class="type-count">{{item.count}}次 ({{item.percentage}}%)</text>
          </view>
          <view class="type-bar-bg">
            <view class="type-bar-fill" style="width: {{item.percentage}}%"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 常去地点 -->
    <view wx:if="{{topLocations.length > 0}}" class="section-card">
      <view class="section-title">常去地点</view>
      <view class="location-list">
        <view
          wx:for="{{topLocations}}"
          wx:key="name"
          class="location-item"
        >
          <text class="location-rank">{{index + 1}}</text>
          <text class="location-name">{{item.name}}</text>
          <text class="location-count">{{item.count}}次</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{totalClimbs === 0}}" class="empty-tip">
      <text class="empty-icon">📊</text>
      <text class="empty-text">还没有攀岩记录</text>
      <text class="empty-hint">快去添加第一条记录吧！</text>
    </view>
  </view>
</view>
