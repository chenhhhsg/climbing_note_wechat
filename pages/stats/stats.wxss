/**
 * 统计页面样式
 */

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
}

/* 核心数据网格 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.stat-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.stat-card.highlight {
  background-color: #2c3e50;
}

.stat-number {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 10rpx;
}

.stat-card.highlight .stat-number {
  color: #ffffff;
}

.stat-label {
  display: block;
  font-size: 26rpx;
  color: #999999;
}

.stat-card.highlight .stat-label {
  color: rgba(255, 255, 255, 0.8);
}

/* 区域卡片 */
.section-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 30rpx;
}

/* 完成状态条 */
.status-bars {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.status-bar-item {
  display: flex;
  flex-direction: column;
}

.bar-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.bar-label {
  font-size: 28rpx;
  color: #333333;
}

.bar-count {
  font-size: 28rpx;
  color: #666666;
}

.bar-bg {
  height: 24rpx;
  background-color: #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 12rpx;
  transition: width 0.3s ease;
}

.bar-success {
  background-color: #4caf50;
}

.bar-fail {
  background-color: #f44336;
}

/* 攀岩类型分布 */
.type-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.type-item {
  display: flex;
  flex-direction: column;
}

.type-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.type-name {
  font-size: 28rpx;
  color: #333333;
}

.type-count {
  font-size: 28rpx;
  color: #666666;
}

.type-bar-bg {
  height: 20rpx;
  background-color: #f0f0f0;
  border-radius: 10rpx;
  overflow: hidden;
}

.type-bar-fill {
  height: 100%;
  background-color: #2c3e50;
  border-radius: 10rpx;
  transition: width 0.3s ease;
}

/* 常去地点 */
.location-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.location-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.location-item:last-child {
  border-bottom: none;
}

.location-rank {
  width: 50rpx;
  height: 50rpx;
  background-color: #2c3e50;
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.location-name {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

.location-count {
  font-size: 28rpx;
  color: #666666;
}

/* 空状态提示 */
.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #999999;
  font-size: 28rpx;
}
