/**
 * 统计页面样式
 */

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
}

/* 核心数据网格 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.stat-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.stat-card.highlight {
  background-color: #2c3e50;
}

.stat-number {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 10rpx;
}

.stat-card.highlight .stat-number {
  color: #ffffff;
}

.stat-label {
  display: block;
  font-size: 26rpx;
  color: #999999;
}

.stat-card.highlight .stat-label {
  color: rgba(255, 255, 255, 0.8);
}

/* 次要数据行 */
.stats-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.stat-mini {
  flex: 1;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.stat-mini-number {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.stat-mini-label {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

/* Project 状态颜色 */
.stat-active {
  color: #2196f3;
}

.stat-completed {
  color: #4caf50;
}

.stat-abandoned {
  color: #999999;
}

/* 区域卡片 */
.section-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 24rpx;
}

/* 完成率进度条 */
.progress-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.progress-bar-bg {
  flex: 1;
  height: 24rpx;
  background-color: #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #4caf50, #2c3e50);
  border-radius: 12rpx;
  transition: width 0.5s ease;
}

.progress-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
  min-width: 80rpx;
  text-align: right;
}

.progress-detail {
  margin-top: 8rpx;
}

.progress-info {
  font-size: 24rpx;
  color: #999999;
}

/* 月度趋势 */
.trend-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 300rpx;
  padding-top: 20rpx;
}

.trend-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.trend-bar-bg {
  flex: 1;
  width: 40rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.trend-bar-fill {
  width: 100%;
  background-color: #2c3e50;
  border-radius: 8rpx;
  transition: height 0.5s ease;
  min-height: 4rpx;
}

.trend-count {
  font-size: 22rpx;
  color: #666666;
  margin-top: 8rpx;
}

.trend-month {
  font-size: 20rpx;
  color: #999999;
  margin-top: 4rpx;
}

/* 攀岩类型分布 */
.type-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.type-item {
  display: flex;
  flex-direction: column;
}

.type-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.type-name {
  font-size: 28rpx;
  color: #333333;
}

.type-count {
  font-size: 28rpx;
  color: #666666;
}

.type-bar-bg {
  height: 20rpx;
  background-color: #f0f0f0;
  border-radius: 10rpx;
  overflow: hidden;
}

.type-bar-fill {
  height: 100%;
  background-color: #2c3e50;
  border-radius: 10rpx;
  transition: width 0.3s ease;
}

/* 常去地点 */
.location-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.location-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.location-item:last-child {
  border-bottom: none;
}

.location-rank {
  width: 50rpx;
  height: 50rpx;
  background-color: #2c3e50;
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.location-name {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

.location-count {
  font-size: 28rpx;
  color: #666666;
}

/* 空状态提示 */
.empty-tip {
  text-align: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666666;
  display: block;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999999;
  display: block;
}
