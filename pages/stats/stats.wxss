/**
 * 统计页面样式
 */

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 100rpx 0;
  color: #606d61;
}

/* 核心数据网格 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.stat-card {
  background-color: #fffcf3;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: none;
}

.stat-card.highlight {
  background-color: #173d32;
}

.stat-number {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #173d32;
  margin-bottom: 10rpx;
}

.stat-card.highlight .stat-number {
  color: #fffcf3;
}

.stat-label {
  display: block;
  font-size: 26rpx;
  color: #606d61;
}

.stat-card.highlight .stat-label {
  color: rgba(255, 255, 255, 0.8);
}

/* 区域卡片 */
.section-card {
  background-color: #fffcf3;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: none;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #173d32;
  margin-bottom: 30rpx;
}

/* 完成状态条 */
.status-bars {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.status-bar-item {
  display: flex;
  flex-direction: column;
}

.bar-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.bar-label {
  font-size: 28rpx;
  color: #22372f;
}

.bar-count {
  font-size: 28rpx;
  color: #526157;
}

.bar-bg {
  height: 24rpx;
  background-color: #dcdccc;
  border-radius: 12rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 12rpx;
  transition: width 0.3s ease;
}

.bar-success {
  background-color: #2f6248;
}

.bar-fail {
  background-color: #9c3d22;
}

/* 攀岩类型分布 */
.type-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.type-item {
  display: flex;
  flex-direction: column;
}

.type-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.type-name {
  font-size: 28rpx;
  color: #22372f;
}

.type-count {
  font-size: 28rpx;
  color: #526157;
}

.type-bar-bg {
  height: 20rpx;
  background-color: #dcdccc;
  border-radius: 10rpx;
  overflow: hidden;
}

.type-bar-fill {
  height: 100%;
  background-color: #173d32;
  border-radius: 10rpx;
  transition: width 0.3s ease;
}

/* 常去地点 */
.location-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.location-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #dcdccc;
}

.location-item:last-child {
  border-bottom: none;
}

.location-rank {
  width: 50rpx;
  height: 50rpx;
  background-color: #173d32;
  color: #fffcf3;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.location-name {
  flex: 1;
  font-size: 30rpx;
  color: #22372f;
}

.location-count {
  font-size: 28rpx;
  color: #526157;
}

/* 空状态提示 */
.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #606d61;
  font-size: 28rpx;
}

/* 岩馆手册 */
.stat-number { color:#214d3b; font-family:Georgia,"SimSun",serif; font-weight:bold; }
.stat-card,.section-card { border:1px solid #d2d3c3; border-radius:8rpx; }
