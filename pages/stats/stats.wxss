/**
 * 统计页面样式
 */

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 80rpx 0;
  color: #999999;
  font-size: 26rpx;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  display: block;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999999;
  display: block;
}

/* ========== 核心数据网格 ========== */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stat-card.highlight {
  background-color: #2c3e50;
}

.stat-number {
  display: block;
  font-size: 42rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.stat-card.highlight .stat-number {
  color: #ffffff;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

.stat-card.highlight .stat-label {
  color: rgba(255, 255, 255, 0.8);
}

/* ========== 区域卡片通用 ========== */
.section-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 24rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

/* ========== 线路状态统计 ========== */
.status-grid {
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
}

.status-item {
  text-align: center;
}

.status-icon {
  display: block;
  font-size: 32rpx;
  margin-bottom: 6rpx;
}

.status-num {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.status-flash {
  color: #ff9800;
}

.status-completed {
  color: #4caf50;
}

.status-failed {
  color: #f44336;
}

.status-project {
  color: #2196f3;
}

.status-label {
  display: block;
  font-size: 22rpx;
  color: #999999;
}

/* 完成率进度条 */
.progress-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.progress-bar-bg {
  flex: 1;
  height: 20rpx;
  background-color: #f0f0f0;
  border-radius: 10rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #4caf50, #2c3e50);
  border-radius: 10rpx;
  transition: width 0.5s ease;
}

.progress-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #2c3e50;
  min-width: 70rpx;
  text-align: right;
}

/* ========== 攀岩类型分布 ========== */
.type-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.type-item {
  display: flex;
  flex-direction: column;
}

.type-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.type-name {
  font-size: 28rpx;
  color: #333333;
}

.type-count {
  font-size: 28rpx;
  color: #666666;
}

.type-bar-bg {
  height: 20rpx;
  background-color: #f0f0f0;
  border-radius: 10rpx;
  overflow: hidden;
}

.type-bar-fill {
  height: 100%;
  background-color: #2c3e50;
  border-radius: 10rpx;
  transition: width 0.3s ease;
}

/* ========== 常去岩馆 ========== */
.location-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.location-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.location-item:last-child {
  border-bottom: none;
}

.location-rank {
  width: 48rpx;
  height: 48rpx;
  background-color: #2c3e50;
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.location-name {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

.location-count {
  font-size: 28rpx;
  color: #666666;
}

/* ========== 月度趋势 ========== */
.trend-tabs {
  display: flex;
  gap: 8rpx;
}

.trend-tab {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: #999999;
  background-color: #f5f5f5;
  border-radius: 20rpx;
}

.trend-tab-active {
  background-color: #2c3e50;
  color: #ffffff;
}

.trend-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 280rpx;
  padding-top: 20rpx;
}

.trend-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.trend-bar-bg {
  flex: 1;
  width: 36rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.trend-bar-fill {
  width: 100%;
  background-color: #2c3e50;
  border-radius: 8rpx;
  transition: height 0.5s ease;
  min-height: 4rpx;
}

.trend-bar-routes {
  background-color: #3d566e;
}

.trend-count {
  font-size: 22rpx;
  color: #666666;
  margin-top: 8rpx;
}

.trend-month {
  font-size: 20rpx;
  color: #999999;
  margin-top: 4rpx;
}
