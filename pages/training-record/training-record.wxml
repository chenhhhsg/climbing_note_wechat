<!--
  单线记录页（T036 / T041 现场照片入口 / T045 现场逐把同页 / T048 紧凑逐把 / T049 视频入口
  / T050 撤销）
  按 archiveId + sessionId + routeId 进入一条长期线路在某一场的记录：
  首屏一行线路照片入口、结果按钮、待保存重试，普通文档流下直接列本场本线把次
  （最新在前、一把一框），每行只编辑所点那一把。
  最新一把右侧给一个文字「撤销」：按一下直接撤回当前这一把；已撤回的一把移出逐把列表，
  前一把只补位显示，下一次成功记把前不再出现撤销入口。现场不再有「更多」纠错菜单、
  「改为未完成」与撤销后的「恢复」按钮，较早把次也没有行内更正入口；更正仍在线路历史
  与本场逐把页按原范围处理。
  最新一把的备注右侧固定视频入口（无片「＋ 添加视频」、有片「回看视频」）；
  旧行收起仅在已有视频时显示小视频图标，展开后按该把的真实关联给同一入口。
  最新一把与展开的旧把统一用「备注」入口：点击仍在原把次打开输入区，有备注就带出原文，
  保存只更新该把；输入区标题「备注」，保存按钮「保存备注」。
  旧行展开（T048 返工）：头部保留原序、结果、时间与收起；有备注才显示原正文，下一行
  同排「备注」与视频入口；点备注入口时，就地编辑区紧接头部替换操作行，输入约
  两行、长文框内滚动，取消与保存紧随其后。
  照片、卡点与跨天历史仍在原来的二级大图标记页；现场不再有独立逐把与线路历史跳转。
  长按整张把次卡删除这一把（T054）：绑定在整卡根节点，序号、结果、时间、展开后的
  备注正文与卡片内边距都属于同一命中区；最新把、收起旧把与展开旧把都适用。
  长按先开「删除这一把」菜单，选中后才显示原把与视频删除范围；短按仍是展开/收起。
  备注入口、编辑区、视频入口与撤销各自保留独立输入，不触发父卡删除。确认后记录、
  备注与攀笔保存的视频副本一起删除，档案先移出记录，视频索引与文件按持久删除凭据
  继续清理；失败时可重试清理。
-->
<view class="page">
  <!-- 本机档案损坏或版本不支持：显示可见错误，不覆盖原数据 -->
  <view wx:if="{{loadError}}" id="load-error" class="card error-card">
    <text class="error-title">本机训练档案读取失败</text>
    <text class="error-text">{{loadError}}</text>
    <text class="error-hint">原档案保持原样，没有被改写。</text>
    <button id="retry-load" class="secondary-button" bindtap="retryLoad">重试读取</button>
  </view>

  <block wx:else>
    <!-- 入口缺参、串档或线路不属于这一场：显示原因与返回路径，不展示别场别线的把次，也不写盘 -->
    <view wx:if="{{contextError}}" id="record-context-error" class="card error-card">
      <text class="error-title">这个入口不能用来记录</text>
      <text class="error-text">{{contextError}}</text>
      <text class="error-hint">没有改动任何数据；请从本场线路列表重新进入。</text>
      <button id="record-back-to-list" class="secondary-button" bindtap="backToList">返回本场线路</button>
    </view>

    <block wx:if="{{ready && !contextError}}">
      <!-- 本次操作未落盘：不报已保存，重试沿用同一把 -->
      <view
        wx:if="{{storageError}}"
        id="storage-error"
        class="storage-error"
        bindtap="dismissStorageError"
      >
        <text class="storage-error-text">{{storageError}}</text>
        <text class="storage-error-hint">当前操作未生效，可重试；点击收起</text>
      </view>

      <view wx:if="{{notice}}" id="notice" class="notice" bindtap="dismissNotice">
        <text class="notice-text">{{notice}}</text>
        <text class="notice-hint">点击收起</text>
      </view>

      <!--
        长按删除后的本机视频副本清理（T048–T050 追加返工）：记录已移出档案但索引/文件
        还没有清理完时显示；失败可手动重试。没有未完成条目时不占位。
      -->
      <view wx:if="{{cleanupNotice}}" id="video-cleanup" class="video-cleanup">
        <text id="video-cleanup-text" class="video-cleanup-text">{{cleanupNotice}}</text>
        <button
          wx:if="{{cleanupRetryVisible}}"
          id="video-cleanup-retry"
          class="text-button video-cleanup-retry"
          bindtap="retryVideoCleanup"
        >重试清理</button>
      </view>

      <block wx:if="{{activeSession && selectedRoute}}">
        <!-- 当前线：只服务这一条线，不再提供页内换线列表 -->
        <view id="record-route" class="record-route">
          <view class="route-swatch" style="background: {{selectedRoute.colorHex}};"></view>
          <view class="record-route-info">
            <text class="record-route-grade">{{selectedRoute.grade}}</text>
            <text class="record-route-name">{{selectedRoute.name}}</text>
            <text class="record-route-meta">{{selectedRoute.climbType}} · 本场 {{routeCountText}}</text>
            <view class="record-route-state-slot">
              <text
                wx:if="{{routeStateText}}"
                id="selected-route-state"
                class="route-state {{routeCompleted ? 'route-state-done' : 'route-state-pending'}}"
              >{{routeStateText}}</text>
            </view>
            <text id="record-session-meta" class="record-session-meta">{{activeSession.dateText}} · {{activeSession.gymName}} · {{activeSession.label}}</text>
          </view>
        </view>

        <!--
          线路照片（T041）：现场记把时就地留一张，一行紧凑入口，不铺第二套照片卡。
          无图时给拍照 / 相册；有图时显示缩略图与当前照片版本的标记数量，整行进原来的
          二级大图标记页。选图后先预览，确认才由同一个照片控制器写入，取消或写失败都保留
          之前的状态（原图、索引与卡点都不动）。
        -->
        <view wx:if="{{recordPhoto}}" id="record-photo" class="record-photo">
          <!-- 有图：紧凑缩略图 + 当前照片版本的标记数量，整行进二级标记页 -->
          <block wx:if="{{recordPhoto.status === 'saved' || recordPhoto.status === 'missing'}}">
            <view
              id="record-photo-entry"
              class="record-photo-main record-photo-open"
              data-archive-id="{{archiveId}}"
              data-route-id="{{selectedRoute.id}}"
              data-photo-id="{{recordPhoto.photoId}}"
              bindtap="openRoutePhotoMarks"
            >
              <image
                wx:if="{{recordPhoto.status === 'saved'}}"
                id="record-photo-thumb"
                class="record-photo-thumb"
                src="{{recordPhoto.thumbnailPath}}"
                mode="aspectFill"
              />
              <view class="record-photo-text">
                <text id="record-photo-status" class="record-photo-title">{{recordPhoto.statusText}}</text>
                <text
                  wx:if="{{recordPhoto.photoId}}"
                  id="record-photo-marks-entry"
                  class="record-photo-link"
                >{{photoMarkCountText || '照片动作标记'}} ›</text>
                <text wx:else class="record-photo-hint">可重新添加一张；历史把次与备注不变。</text>
              </view>
              <text class="record-photo-arrow">›</text>
            </view>
            <!-- 主图文件被系统清理：仍可打开该版本已写的卡点，也可重新添加一张 -->
            <view wx:if="{{recordPhoto.status === 'missing'}}" class="record-photo-actions">
              <button
                id="record-photo-album"
                class="record-photo-source"
                data-source="album"
                data-route-id="{{selectedRoute.id}}"
                bindtap="chooseRecordPhoto"
              >重新添加照片</button>
            </view>
            <text wx:if="{{photoMarksError}}" id="record-photo-marks-error" class="record-photo-error">{{photoMarksError}}</text>
          </block>

          <!-- 预览：确认前不写照片索引与文件；取消回到之前的状态 -->
          <block wx:elif="{{recordPhoto.status === 'preview'}}">
            <image
              id="record-photo-preview-image"
              class="record-photo-preview"
              src="{{recordPhoto.previewPath}}"
              mode="aspectFit"
            />
            <text id="record-photo-preview-status" class="record-photo-status">{{recordPhoto.statusText}}</text>
            <view class="record-photo-actions">
              <button
                id="record-photo-cancel"
                class="record-photo-source"
                data-route-id="{{selectedRoute.id}}"
                bindtap="cancelRecordPhoto"
              >取消</button>
              <button
                id="record-photo-confirm"
                class="record-photo-confirm"
                data-route-id="{{selectedRoute.id}}"
                bindtap="confirmRecordPhoto"
              >确认保存</button>
            </view>
          </block>

          <!-- 保存中 / 失败：文件与关联都写入后才提示成功；失败保留原图并可重试 -->
          <block wx:elif="{{recordPhoto.status === 'saving'}}">
            <text id="record-photo-saving" class="record-photo-status">{{recordPhoto.statusText}}</text>
            <text class="record-photo-hint">照片文件和关联都写入后才提示成功。</text>
          </block>

          <block wx:elif="{{recordPhoto.status === 'failed'}}">
            <text id="record-photo-error" class="record-photo-status record-photo-status-error">{{recordPhoto.statusText}}</text>
            <text class="record-photo-error">{{recordPhoto.errorText}}</text>
            <view class="record-photo-actions">
              <button
                id="record-photo-retry"
                class="record-photo-source"
                data-route-id="{{selectedRoute.id}}"
                bindtap="retryRecordPhoto"
              >{{recordPhoto.retryText}}</button>
              <button
                id="record-photo-dismiss"
                class="record-photo-source"
                data-route-id="{{selectedRoute.id}}"
                bindtap="dismissRecordPhotoFailure"
              >收起</button>
            </view>
          </block>

          <!-- 无图 / 读取失败：一行「添加线路照片」，拍照与相册都可；失败给重试 -->
          <block wx:else>
            <view class="record-photo-main">
              <view class="record-photo-text">
                <text id="record-photo-status" class="record-photo-title">{{recordPhoto.status === 'none' ? '添加线路照片' : recordPhoto.statusText}}</text>
                <text wx:if="{{recordPhoto.status === 'none'}}" class="record-photo-hint">现场就地留一张；线路历史与动作标记共用这一张。</text>
              </view>
            </view>
            <view wx:if="{{recordPhoto.status === 'error'}}" class="record-photo-actions">
              <button
                id="record-photo-reload"
                class="record-photo-source"
                data-route-id="{{selectedRoute.id}}"
                bindtap="reloadRecordPhoto"
              >重试读取</button>
            </view>
            <view wx:elif="{{recordPhoto.sourceVisible}}" class="record-photo-actions">
              <button
                id="record-photo-camera"
                class="record-photo-source"
                data-source="camera"
                data-route-id="{{selectedRoute.id}}"
                bindtap="chooseRecordPhoto"
              >{{recordPhoto.cameraText}}</button>
              <button
                id="record-photo-album"
                class="record-photo-source"
                data-source="album"
                data-route-id="{{selectedRoute.id}}"
                bindtap="chooseRecordPhoto"
              >{{recordPhoto.albumText}}</button>
            </view>
          </block>
        </view>

        <!--
          结果按钮：抱石完攀后收起；有未保存的把次时先重试那一把。
          按钮把渲染时的档案、场次与线路一并带下来：迟到点击与当前不一致时整条拒掉。
        -->
        <view class="result-footer">
          <block wx:if="{{routeCompleted}}">
            <view id="route-completed-panel" class="route-completed-panel">
              <text class="route-completed-title">已完攀</text>
              <text class="route-completed-hint">不再新增把次</text>
            </view>
          </block>
          <block wx:elif="{{routeClosed}}">
            <view id="route-pending-panel" class="route-pending-panel">
              <text class="route-pending-title">完攀待确认</text>
              <text class="route-pending-hint">先在下方「待保存」行重试保存</text>
            </view>
          </block>
          <block wx:else>
            <text wx:if="{{resultLocked}}" id="result-locked-hint" class="result-lock-hint">{{resultLockHint}}</text>
            <button
              id="record-fail"
              class="result-button result-fail"
              data-result="fail"
              data-archive-id="{{archiveId}}"
              data-session-id="{{activeSession.id}}"
              data-route-id="{{selectedRoute.id}}"
              disabled="{{resultLocked}}"
              bindtap="recordAttempt"
            >未完成</button>
            <button
              id="record-send"
              class="result-button result-send"
              data-result="send"
              data-archive-id="{{archiveId}}"
              data-session-id="{{activeSession.id}}"
              data-route-id="{{selectedRoute.id}}"
              disabled="{{resultLocked}}"
              bindtap="recordAttempt"
            >完攀</button>
          </block>
        </view>

        <!-- 待保存：重试沿用同一操作 ID，只多出预期的一把 -->
        <view
          wx:for="{{pendingRows}}"
          wx:key="opId"
          id="pending-{{item.opId}}"
          class="attempt-item pending-attempt"
        >
          <view class="attempt-main">
            <text class="attempt-label">{{item.label || '待保存'}}</text>
            <text class="attempt-result">{{item.resultText}}</text>
          </view>
          <view class="pending-footer">
            <text class="pending-status">{{item.statusText}}</text>
            <button
              id="retry-{{item.opId}}"
              class="text-button pending-retry"
              data-archive-id="{{item.archiveId}}"
              data-session-id="{{item.sessionId}}"
              data-route-id="{{item.routeId}}"
              data-op-id="{{item.opId}}"
              bindtap="retryPendingAttempt"
            >重试保存</button>
          </view>
        </view>

        <!--
          本场本线把次（T045 / T048）：普通文档流里直接列出，原序号倒序，最新在前。
          最新一把完整展示结果、时间与一行备注；更早的把次各占一条紧凑短行，保留边框、
          原序号、结果色（墨绿完攀／岩橙未完成）与时间，点行只展开/收起这一把。
          卡框沿用 T044 的配色与边框；每行只用这一行带下来的原把次 ID 与归属：
          - 最新一把与展开的旧把统一用「备注」入口，保存/取消只改这一把；备注为空也显示同一入口；
          - 视频入口沿用原把次视频页（四个 ID 再核对）；
          - 最新一把右侧只给一个文字「撤销」；写失败时同一位置换成「重试撤销」并保留原把。
            撤销成功后这一把离开列表，前一把只补位显示；现场没有更正菜单或「恢复」按钮。
        -->
        <view wx:if="{{hasAttemptCards}}" id="record-attempts" class="record-attempts">
          <view class="record-attempts-head">
            <text class="record-attempts-title">本场逐把</text>
            <text class="record-attempts-hint">最新在前 · 共 {{attempts.length}} 把</text>
          </view>

          <!--
            T054：长按绑定在整卡根节点，六项原身份也都在这里。序号、结果、时间、
            展开后的备注正文以及卡片内边距都落在同一命中区；短按仍只由头部展开/收起。
            卡内备注入口、编辑区、视频入口与撤销各自 catchlongpress，触碰这些控件
            不会发起这张卡的删除，也不吞掉它们本来的点按/输入。
          -->
          <view
            wx:for="{{attemptCards}}"
            wx:key="id"
            id="record-attempt-{{item.id}}"
            class="record-attempt {{item.isSend ? 'record-attempt-send' : 'record-attempt-fail'}}{{item.isLatest ? ' record-attempt-latest' : ' record-attempt-older'}}{{item.expanded ? ' record-attempt-open' : ' record-attempt-compact'}}"
            data-attempt-id="{{item.id}}"
            data-archive-id="{{item.archiveId}}"
            data-session-id="{{item.sessionId}}"
            data-route-id="{{item.routeId}}"
            data-delete-rev="{{item.deleteRev}}"
            data-page-token="{{pageToken}}"
            catchlongpress="requestDeleteAttempt"
          >
            <view class="record-attempt-main">
              <view
                class="record-attempt-headline{{item.canToggle ? ' record-attempt-headline-toggle' : ''}}"
                data-attempt-id="{{item.id}}"
                data-archive-id="{{item.archiveId}}"
                data-session-id="{{item.sessionId}}"
                data-route-id="{{item.routeId}}"
                bindtap="toggleAttemptRow"
              >
                <!-- T054：序号框仍是看得见的原序，但长按入口已经上移到整张卡根节点；
                     这里不再单独挂手势，序号文字与内边距随整卡命中。 -->
                <view
                  id="record-attempt-label-{{item.id}}"
                  class="record-attempt-label"
                >
                  <text class="record-attempt-label-text">{{item.label}}</text>
                </view>
                <text
                  class="record-attempt-result {{item.isSend ? 'record-attempt-result-send' : 'record-attempt-result-fail'}}"
                >{{item.resultText}}</text>
                <text class="record-attempt-time">{{item.timeText}}</text>
                <!-- T050 返工：最新一把右侧只留一个小号文字「撤销」；按一下直接撤回当前这一把。
                     44×44 的最小命中区不随文案变短而缩小，也不与整行展开、视频图标抢坐标。
                     撤销成功后这一把离开列表，前一把补位时不会再渲染撤销入口。 -->
                <button
                  wx:if="{{item.showWithdraw}}"
                  id="record-attempt-withdraw-{{item.id}}"
                  class="record-attempt-withdraw{{item.undoText === '重试撤销' ? ' record-attempt-withdraw-retry' : ''}}"
                  data-attempt-id="{{item.id}}"
                  data-archive-id="{{item.archiveId}}"
                  data-session-id="{{item.sessionId}}"
                  data-route-id="{{item.routeId}}"
                  data-expected="{{item.expected}}"
                  data-expected-rev="{{item.expectedRev}}"
                  catchtap="undoLatestAttempt"
                  catchlongpress="ignoreLongPress"
                >{{item.undoText}}</button>
                <!-- T049：旧行收起时只有这一把已有本机视频才出现小视频图标；
                     图标不单独接收点按，点按仍落到整行展开原把详情。 -->
                <text
                  wx:if="{{item.showVideoIcon}}"
                  catchlongpress="ignoreLongPress"
                  id="record-attempt-video-icon-{{item.id}}"
                  class="record-attempt-video-icon"
                >▶</text>
                <text
                  wx:if="{{item.canToggle}}"
                  id="record-attempt-toggle-{{item.id}}"
                  class="record-attempt-caret"
                >{{item.expanded ? '▾' : '›'}}</text>
              </view>

              <block wx:if="{{item.expanded}}">
              <!--
                开备注（T048 返工）：就地编辑区紧接这一把的头部，替换原来的详情操作行
                （原备注正文与「备注」「添加/回看视频」不再重复渲染）。输入框约两行高，
                长内容在框内滚动；「取消」「保存备注」紧跟输入框，保留常用可点高度。
              -->
              <view
                wx:if="{{noteEditor && noteEditor.attemptId === item.id}}"
                id="note-editor"
                class="note-editor"
                catchlongpress="ignoreLongPress"
              >
                <text id="note-editor-title" class="note-title">备注 · {{noteEditor.attemptLabel}}</text>
                <textarea
                  id="note-input"
                  class="note-input"
                  style="height: 132rpx;"
                  data-attempt-id="{{noteEditor.attemptId}}"
                  data-edit-version="{{noteEditor.version}}"
                  value="{{noteEditor.text}}"
                  placeholder="例如：抓到后向右摆"
                  maxlength="120"
                  cursor-spacing="24"
                  bindinput="onNoteInput"
                  catchlongpress="ignoreLongPress"
                ></textarea>
                <view class="button-row">
                  <button
                    id="cancel-note"
                    class="secondary-button"
                    data-attempt-id="{{noteEditor.attemptId}}"
                    data-edit-version="{{noteEditor.version}}"
                    bindtap="cancelNote"
                    catchlongpress="ignoreLongPress"
                  >取消</button>
                  <button
                    id="save-note"
                    class="primary-button"
                    data-attempt-id="{{noteEditor.attemptId}}"
                    data-edit-version="{{noteEditor.version}}"
                    bindtap="saveNote"
                    catchlongpress="ignoreLongPress"
                  >保存备注</button>
                </view>
              </view>

              <!--
                平常态：只有真有备注时显示原正文；下一行同排「备注」与
                「＋ 添加视频／回看视频」。已有视频用「回看视频」本身表达，不再另挂状态文字。
                最新一把的备注仍是单行摘要、入口靠右；较早把次备注换行、两个入口在下一行。
              -->
              <block wx:else>
                <view class="record-attempt-detail{{item.isLatest ? '' : ' record-attempt-detail-older'}}">
                  <text
                    wx:if="{{item.hasNote}}"
                    id="record-attempt-note-{{item.id}}"
                    class="record-attempt-note{{item.isLatest ? ' record-attempt-note-summary' : ''}}"
                  >{{item.note}}</text>

                  <view class="record-attempt-detail-actions">
                    <!-- T050 返工：最新一把与展开的旧把都用「备注」：点击只打开这一把，
                         有备注就带出原文；空备注也给同一个入口。 -->
                    <button
                      wx:if="{{item.canEditNote}}"
                      id="edit-note-{{item.id}}"
                      class="text-button record-attempt-edit"
                      data-attempt-id="{{item.id}}"
                      catchlongpress="ignoreLongPress"
                      catchtap="openNoteEditor"
                    >{{item.noteActionText}} ›</button>

                    <!-- T049：视频入口固定在同一槽位，无片「＋ 添加视频」，有片「回看视频」。 -->
                    <view wx:if="{{item.canOpenVideo}}" class="record-attempt-video">
                      <text
                        id="record-open-video-{{item.id}}"
                        class="record-attempt-video-action {{item.hasVideo ? ' record-attempt-video-saved' : ''}}"
                        data-attempt-id="{{item.id}}"
                        data-archive-id="{{item.archiveId}}"
                        data-session-id="{{item.sessionId}}"
                        data-route-id="{{item.routeId}}"
                        catchlongpress="ignoreLongPress"
                        catchtap="openAttemptVideo"
                      >{{item.videoEntryText}}</text>
                    </view>
                  </view>
                </view>
              </block>
              </block>
            </view>

            <!-- 撤销未保存：原行保留这一把，撤销入口在同一位置换成「重试撤销」。 -->
            <view wx:if="{{item.stateText}}" class="record-attempt-fix">
              <text
                id="record-attempt-state-{{item.id}}"
                class="record-attempt-status"
              >{{item.stateText}}</text>
            </view>
          </view>
        </view>

        <view wx:else id="record-attempts-empty" class="record-attempts-empty">
          <text>这一场这一条线还没有把次。用上方「未完成 / 完攀」记下第一把。</text>
        </view>

        <text class="record-foot-hint">点旧行展开原把详情；最新一把完整展示，较早把次收成短行，有片的旧行收起时显示 ▶。展开后，有备注才显示原正文；最新一把和旧把都用「备注」入口，点开就在原把头部下方编辑这一把，保存只改这一把。视频入口无片「＋ 添加视频」、有片「回看视频」，都进原把次视频页，副本只保存在这台手机的攀笔中。最新一把右侧的「撤销」按一下就撤回这一把（本场少 1 把）；撤销成功后这一把移出列表，前一把只补位显示，再成功记一把才出现新的撤销入口，写失败时原行保留「重试撤销」。长按整张把次卡（序号、结果、时间、正文与卡内空白）先开「删除这一把」菜单，选中后才显示原把与视频删除范围；记录、备注与攀笔保存的视频副本一起删除（相册原片保留），取消不写；删除失败或视频副本未清理时可重试。备注入口、编辑区、回看视频与撤销有各自的手势，不会触发整卡删除。照片与卡点在照片缩略图里。</text>
      </block>
    </block>
  </block>
</view>
