/**
 * 单线记录页样式（T036 / T037 视觉对齐）
 *
 * T037：白色内容区 #FFFFFF、浅灰页底 #F2F4F3、深墨标题与正文 #182421、
 * 墨绿 #1F5948 标主操作、橙色 #FF793F 只标完攀；常用命中区（结果、撤回/恢复、
 * 明细与资料入口）在 320/390 两个视口下都至少 44×44 逻辑像素，因此这里用 px 兜底。
 */

page {
  background-color: #F2F4F3;
}

.page {
  padding: 12px 12px 32px;
  background-color: #F2F4F3;
}

.card {
  background-color: #FFFFFF;
  border: 1px solid #D7DED9;
  border-radius: 8rpx;
  padding: 16px;
  margin-bottom: 12px;
}

.section-title,
.card-title {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans CJK SC",
    "Source Han Sans SC", "Microsoft YaHei", sans-serif;
  line-height: 1.35;
  font-weight: 700;
  font-size: 32rpx;
  color: #182421;
  margin-bottom: 16rpx;
}

/* 错误与提示 */
.error-card {
  background-color: #F7E6DB;
}

.error-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #943A23;
  margin-bottom: 12rpx;
}

.error-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #813323;
  margin-bottom: 10rpx;
}

.error-hint {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #745241;
  margin-bottom: 16rpx;
}

.storage-error,
.notice {
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.storage-error {
  background-color: #F7E6DB;
  color: #943A23;
}

.notice {
  background-color: #F7F1E2;
  color: #745241;
}

.storage-error-text,
.notice-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.5;
}

.storage-error-hint,
.notice-hint {
  display: block;
  font-size: 22rpx;
  margin-top: 8rpx;
  opacity: 0.75;
}

/* 当前线：与场内统一列表同一套行样式（白内容 + 深字 + 等级槽），不是另一套控件 */
.record-route {
  position: relative;
  display: flex;
  align-items: stretch;
  margin: 0 0 14rpx;
  overflow: hidden;
  background: #FFFFFF;
  border: 1px solid #D7DED9;
  border-radius: 8rpx;
}

.record-route .route-swatch {
  width: 9rpx;
  height: auto;
  flex: none;
  border: 0;
  border-radius: 0;
  margin: 0;
}

.record-route-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
  padding: 16rpx 22rpx 18rpx;
}

/* 等级槽：与场内列表行同一个槽（V 级与 YDS 同宽同位，不随位数跳动） */
.record-route-grade {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 52px;
  min-height: 44px;
  box-sizing: border-box;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: #E9EFEC;
  color: #1F5948;
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  word-break: break-all;
}

.record-route-name {
  margin: 8rpx 0 4rpx;
  color: #182421;
  font-size: 34rpx;
  font-weight: 700;
  word-break: break-all;
}

.record-route-meta {
  color: #53615B;
  font-size: 24rpx;
  line-height: 1.5;
}

.record-route-state-slot {
  display: flex;
  align-items: center;
  min-height: 42rpx;
  margin-top: 6rpx;
}

.route-state {
  display: inline-block;
  font-size: 22rpx;
  line-height: 1.4;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.route-state-done {
  background-color: #E9EFEC;
  color: #1F5948;
}

.route-state-pending {
  background-color: #F7F1E2;
  color: #8A442E;
}

.record-session-meta {
  margin-top: 8rpx;
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-variant-numeric: tabular-nums;
  font-size: 22rpx;
  line-height: 1.5;
  color: #53615B;
  word-break: break-all;
}

/* 结果区：正常态、已完攀与待确认三种面板同一行高 */
.result-footer {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  align-items: stretch;
  min-height: 48px;
  box-sizing: border-box;
  margin: 12rpx 0 24rpx;
}

.result-lock-hint {
  display: block;
  width: 100%;
  box-sizing: border-box;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8A442E;
  margin-bottom: 4rpx;
}

.result-button {
  width: auto;
  flex: 1;
  min-height: 48px;
  padding: 20rpx 10rpx;
  margin: 0;
  border: none;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #FFFFFF;
}

.result-button::after {
  border: none;
}

.result-fail {
  color: #1F5948;
  background: #E9EFEC;
}

.result-send {
  color: #182421;
  background: #FF793F;
}

.result-button[disabled] {
  opacity: 0.5;
}

.route-completed-panel,
.route-pending-panel {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 48px;
  padding: 14rpx 22rpx;
  border-left: 8rpx solid #1F5948;
  border-radius: 4rpx;
  background: #E9EFEC;
}

.route-pending-panel {
  border-left-color: #B7683D;
  background: #F7F1E2;
}

.route-completed-title,
.route-pending-title {
  flex: none;
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #182421;
}

.route-completed-hint,
.route-pending-hint {
  flex: 1;
  min-width: 0;
  display: block;
  font-size: 26rpx;
  color: #53615B;
  text-align: right;
}

/* 最近一把：两个并排的交互槽，各占一半、等高；不可用的一边留非交互空位 */
.recent-attempt {
  border-top: 1px solid #D7DED9;
  padding-top: 14rpx;
  margin: 0 0 24rpx;
}

.recent-attempt-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.recent-attempt-title {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans CJK SC",
    "Source Han Sans SC", "Microsoft YaHei", sans-serif;
  font-weight: 700;
  font-size: 28rpx;
  color: #182421;
}

.recent-attempt-note {
  flex: none;
  font-size: 22rpx;
  color: #53615B;
}

.recent-attempt-row {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  min-height: 44px;
  margin-top: 12rpx;
}

.recent-attempt-slot,
.recent-attempt-recovery {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  align-items: stretch;
  min-height: 44px;
}

.recent-attempt-action,
.recent-attempt-restore {
  flex: 1 1 0;
  min-width: 0;
  margin: 0;
}

.recent-attempt-idle {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 44px;
  padding: 0 18rpx;
  border: 2rpx dashed #D7DED9;
  border-radius: 8rpx;
}

.recent-attempt-idle-text {
  font-size: 24rpx;
  line-height: 1.4;
  color: #53615B;
  text-align: center;
}

.recent-attempt-info {
  display: flex;
  flex-direction: column;
  margin-top: 10rpx;
}

.recent-attempt-text {
  font-size: 28rpx;
  color: #182421;
  word-break: break-all;
}

.recent-attempt-meta {
  margin-top: 4rpx;
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-variant-numeric: tabular-nums;
  font-size: 22rpx;
  line-height: 1.5;
  color: #53615B;
}

.recent-attempt-status {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #1F5948;
}

.recent-attempt-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #53615B;
}

/* 结果状态的固定说明槽：撤回/恢复前后都占同样的高度（32px = 4px 的整数倍） */
.recent-attempt-guidance-slot {
  margin-top: 8rpx;
  min-height: 32px;
}

.recent-attempt-guidance-text {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  color: #53615B;
}

/* 待保存 */
.attempt-item {
  background: transparent;
  border-bottom: 1px solid #D7DED9;
  padding: 20rpx 0;
}

.pending-attempt {
  background: #F7F1E2;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.attempt-main {
  display: flex;
  align-items: baseline;
}

.attempt-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #182421;
  margin-right: 20rpx;
}

.attempt-result {
  font-size: 28rpx;
  color: #182421;
  margin-right: 20rpx;
}

.pending-footer {
  display: flex;
  flex-direction: column;
  margin-top: 12rpx;
}

.pending-status {
  font-size: 24rpx;
  line-height: 1.5;
  color: #8A442E;
}

.pending-retry {
  margin-top: 12rpx;
}

/* 明细与资料入口 */
.record-links {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 8rpx 0 24rpx;
}

.record-link {
  width: 100%;
  box-sizing: border-box;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  text-align: center;
}

/* 按把更正 */
.route-correction {
  background-color: #FFFFFF;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.route-correction-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #182421;
  margin-bottom: 10rpx;
}

.route-correction-hint {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #53615B;
  margin-bottom: 12rpx;
}

.route-correction-status {
  display: block;
  font-size: 24rpx;
  color: #8A442E;
  margin-bottom: 12rpx;
}

.route-correction-row {
  border-top: 2rpx solid #F2F4F3;
  padding: 16rpx 0;
}

/* 每行下半槽固定 44px：按钮、只读回读与撤回后的惰性行占同样的高度 */
.route-correction-slot {
  display: flex;
  align-items: center;
  min-height: 44px;
  box-sizing: border-box;
}

.route-correction-idle .route-corrected-text {
  color: #53615B;
}

.route-correction-target {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: #53615B;
  margin-bottom: 10rpx;
}

.route-corrected-text {
  display: block;
  font-size: 26rpx;
  color: #1F5948;
}

.record-foot-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #53615B;
}

/* 通用按钮：min-height 保证常用触控目标 */
.primary-button,
.secondary-button,
.text-button {
  min-height: 44px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
}

.primary-button::after,
.secondary-button::after,
.text-button::after {
  border: none;
}

.primary-button {
  background-color: #1F5948;
  color: #FFFFFF;
  border-radius: 8rpx;
  font-size: 30rpx;
  padding: 22rpx;
  border: none;
}

.secondary-button {
  background-color: #FFFFFF;
  color: #1F5948;
  border: 2rpx solid #1F5948;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 18rpx;
}

.text-button {
  background-color: transparent;
  color: #1F5948;
  font-size: 26rpx;
  padding: 8rpx 0;
}
