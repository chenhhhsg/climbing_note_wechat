/**
 * 单线记录页样式（T036 / T037 视觉对齐 / T045 现场逐把同页）
 *
 * T037：白色内容区 #FFFFFF、浅灰页底 #F2F4F3、深墨标题与正文 #182421、
 * 墨绿 #1F5948 标主操作、橙色 #FF793F 只标完攀；常用命中区（结果、逐把行内动作）
 * 在 320/390 两个视口下都至少 44×44 逻辑像素，因此这里用 px 兜底。
 * T045：本场本线把次直接排在普通文档流里，一把一框；卡框描边/底色与结果色
 * 复用 T044（完攀深绿、未完成深橙），长备注换行不截断。
 * T050：最新一把右侧「更多」菜单纵向排列，每项独立 48px 命中区；撤回后原行给
 * 「恢复」。菜单和恢复按钮都用普通文档流，不用绝对定位叠放，320/390 宽度都不重叠。
 */

page {
  background-color: #F2F4F3;
}

.page {
  padding: 12px 12px 32px;
  background-color: #F2F4F3;
}

.card {
  background-color: #FFFFFF;
  border: 1px solid #D7DED9;
  border-radius: 8rpx;
  padding: 16px;
  margin-bottom: 12px;
}

.section-title,
.card-title {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans CJK SC",
    "Source Han Sans SC", "Microsoft YaHei", sans-serif;
  line-height: 1.35;
  font-weight: 700;
  font-size: 32rpx;
  color: #182421;
  margin-bottom: 16rpx;
}

/* 错误与提示 */
.error-card {
  background-color: #F7E6DB;
}

.error-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #943A23;
  margin-bottom: 12rpx;
}

.error-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #813323;
  margin-bottom: 10rpx;
}

.error-hint {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #745241;
  margin-bottom: 16rpx;
}

.storage-error,
.notice {
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.storage-error {
  background-color: #F7E6DB;
  color: #943A23;
}

.notice {
  background-color: #F7F1E2;
  color: #745241;
}

.storage-error-text,
.notice-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.5;
}

.storage-error-hint,
.notice-hint {
  display: block;
  font-size: 22rpx;
  margin-top: 8rpx;
  opacity: 0.75;
}

/* 当前线：与场内统一列表同一套行样式（白内容 + 深字 + 等级槽），不是另一套控件 */
.record-route {
  position: relative;
  display: flex;
  align-items: stretch;
  margin: 0 0 14rpx;
  overflow: hidden;
  background: #FFFFFF;
  border: 1px solid #D7DED9;
  border-radius: 8rpx;
}

.record-route .route-swatch {
  width: 9rpx;
  height: auto;
  flex: none;
  border: 0;
  border-radius: 0;
  margin: 0;
}

.record-route-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
  padding: 16rpx 22rpx 18rpx;
}

/* 等级槽：与场内列表行同一个槽（V 级与 YDS 同宽同位，不随位数跳动） */
.record-route-grade {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 52px;
  min-height: 44px;
  box-sizing: border-box;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: #E9EFEC;
  color: #1F5948;
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  word-break: break-all;
}

.record-route-name {
  margin: 8rpx 0 4rpx;
  color: #182421;
  font-size: 34rpx;
  font-weight: 700;
  word-break: break-all;
}

.record-route-meta {
  color: #53615B;
  font-size: 24rpx;
  line-height: 1.5;
}

.record-route-state-slot {
  display: flex;
  align-items: center;
  min-height: 42rpx;
  margin-top: 6rpx;
}

.route-state {
  display: inline-block;
  font-size: 22rpx;
  line-height: 1.4;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.route-state-done {
  background-color: #E9EFEC;
  color: #1F5948;
}

.route-state-pending {
  background-color: #F7F1E2;
  color: #8A442E;
}

.record-session-meta {
  margin-top: 8rpx;
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-variant-numeric: tabular-nums;
  font-size: 22rpx;
  line-height: 1.5;
  color: #53615B;
  word-break: break-all;
}

/* 线路照片（T041）：首屏一行紧凑入口——有图时缩略图 + 标记数量，无图时添加入口 */
.record-photo {
  box-sizing: border-box;
  background-color: #FFFFFF;
  border: 1px solid #D7DED9;
  border-radius: 8rpx;
  padding: 12px;
  margin: 0 0 12px;
}

.record-photo-main {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 44px;
  min-width: 0;
}

/* 整行即入口：缩略图与标记数量都属于同一次点击（行高由缩略图与 44px 兜底） */
.record-photo-open {
  border-radius: 6rpx;
}

.record-photo-thumb {
  flex: none;
  width: 56px;
  height: 56px;
  border-radius: 6rpx;
  background-color: #E9EFEC;
}

.record-photo-text {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.record-photo-title {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans CJK SC",
    "Source Han Sans SC", "Microsoft YaHei", sans-serif;
  font-weight: 700;
  font-size: 28rpx;
  line-height: 1.4;
  color: #182421;
  word-break: break-all;
}

.record-photo-link {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #1F5948;
}

.record-photo-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #53615B;
}

.record-photo-arrow {
  flex: none;
  font-size: 30rpx;
  line-height: 1.4;
  color: #53615B;
}

.record-photo-preview {
  display: block;
  width: 100%;
  height: 160px;
  border-radius: 6rpx;
  background-color: #F2F4F3;
}

.record-photo-status {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #182421;
}

.record-photo-status-error {
  color: #943A23;
}

.record-photo-error {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #943A23;
}

.record-photo-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.record-photo-source,
.record-photo-confirm {
  flex: 1 1 0;
  min-width: 0;
  min-height: 44px;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

.record-photo-source {
  background-color: #FFFFFF;
  color: #1F5948;
  border: 2rpx solid #1F5948;
}

.record-photo-confirm {
  background-color: #1F5948;
  color: #FFFFFF;
  border: none;
}

.record-photo-source::after,
.record-photo-confirm::after {
  border: none;
}

/* 结果区：正常态、已完攀与待确认三种面板同一行高 */
.result-footer {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  align-items: stretch;
  min-height: 48px;
  box-sizing: border-box;
  margin: 12rpx 0 24rpx;
}

.result-lock-hint {
  display: block;
  width: 100%;
  box-sizing: border-box;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8A442E;
  margin-bottom: 4rpx;
}

.result-button {
  width: auto;
  flex: 1;
  min-height: 48px;
  padding: 20rpx 10rpx;
  margin: 0;
  border: none;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #FFFFFF;
}

.result-button::after {
  border: none;
}

.result-fail {
  color: #1F5948;
  background: #E9EFEC;
}

.result-send {
  color: #182421;
  background: #FF793F;
}

.result-button[disabled] {
  opacity: 0.5;
}

.route-completed-panel,
.route-pending-panel {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 48px;
  padding: 14rpx 22rpx;
  border-left: 8rpx solid #1F5948;
  border-radius: 4rpx;
  background: #E9EFEC;
}

.route-pending-panel {
  border-left-color: #B7683D;
  background: #F7F1E2;
}

.route-completed-title,
.route-pending-title {
  flex: none;
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #182421;
}

.route-completed-hint,
.route-pending-hint {
  flex: 1;
  min-width: 0;
  display: block;
  font-size: 26rpx;
  color: #53615B;
  text-align: right;
}

/* 本场本线把次（T045）：普通文档流，最新在前，一把一框；卡框复用 T044 配色与边框 */
.record-attempts {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin: 4rpx 0 24rpx;
}

.record-attempts-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  padding: 0 2rpx;
}

.record-attempts-title {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans CJK SC",
    "Source Han Sans SC", "Microsoft YaHei", sans-serif;
  font-weight: 700;
  font-size: 28rpx;
  color: #182421;
}

.record-attempts-hint {
  flex: none;
  font-size: 22rpx;
  color: #53615B;
}

.record-attempts-empty {
  padding: 24rpx 0;
  font-size: 26rpx;
  line-height: 1.6;
  color: #53615B;
}

/* 一张卡就是一把：中性细边框兜底，结果色由 -send / -fail 覆盖（T044 同一套色）。
   T048：最新一把保持完整卡（约 100px 起），更早的把次收成约 48px 的短行。 */
.record-attempt {
  background-color: #FFFFFF;
  border: 1px solid #D7DED9;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
}

/* 最新一把：结果、时间与一行备注完整展示，明显高于旧把次的短行。
   平常态就两行（标题 + 备注/入口），上下内边距略收，实测约 100px。 */
.record-attempt-latest {
  box-sizing: border-box;
  min-height: 100px;
  padding-top: 12rpx;
  padding-bottom: 12rpx;
}

/* 最新一把标题行固定为一行：时间靠右，不能被「更多」的默认按钮宽度挤到第二行。 */
.record-attempt-latest .record-attempt-headline {
  flex-wrap: nowrap;
}

/* 详情行紧接标题行，不再额外留上下间距；旧把展开仍用默认间距。 */
.record-attempt-latest .record-attempt-detail {
  margin: 0;
}

/* 旧把次短行：保留边框、序号、结果、时间；结果色仍是墨绿／岩橙，左侧加粗边缘标记。
   点行只展开/收起这一把（状态在页面内按原把次 ID 管理），不写任何数据。 */
.record-attempt-compact {
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
  min-height: 48px;
  padding: 0 12px;
  border-left-width: 4px;
}

.record-attempt-compact .record-attempt-main {
  justify-content: center;
}

.record-attempt-compact .record-attempt-headline {
  flex-wrap: nowrap;
  min-height: 44px;
}

/* 旧把次的展开／收起标记：只在短行出现，最新一把没有收起态 */
.record-attempt-caret {
  flex: none;
  margin-left: 8rpx;
  font-size: 28rpx;
  line-height: 1;
  color: #53615B;
}

/* T049：旧行收起时仅有本机视频才出现的小视频图标；只作提示，点按仍由整行展开原把 */
.record-attempt-video-icon {
  flex: none;
  box-sizing: border-box;
  min-width: 40rpx;
  padding: 2rpx 8rpx;
  border: 1rpx solid #B7683D;
  border-radius: 6rpx;
  font-size: 20rpx;
  line-height: 1.4;
  text-align: center;
  color: #B7683D;
}

.record-attempt-send {
  background-color: #EAF2EC;
  border-color: #1F5948;
}

.record-attempt-fail {
  background-color: #FBEEE3;
  border-color: #B04A1C;
}

/* 已撤回的那一把仍在原框：卡框回到中性色，旁边写明「已撤回」。 */
.record-attempt-undone {
  background-color: #F2F4F3;
  border-color: #D7DED9;
}

.record-attempt-main {
  display: flex;
  flex-direction: column;
}

.record-attempt-headline {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  min-height: 44px;
  box-sizing: border-box;
}

.record-attempt-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #182421;
}

/* 结果状态：深底白字、写明「完攀 / 未完成」；颜色与文字同时区分两种结果。 */
.record-attempt-result {
  flex: none;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #FFFFFF;
}

.record-attempt-result-send {
  background-color: #1F5948;
}

.record-attempt-result-fail {
  background-color: #B04A1C;
}

.record-attempt-undone-tag {
  flex: none;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #53615B;
  background-color: #FFFFFF;
  border: 1rpx solid #D7DED9;
}

.record-attempt-time {
  margin-left: auto;
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-variant-numeric: tabular-nums;
  font-size: 24rpx;
  color: #53615B;
}

/* 最新一把右侧「更多」（T050）：固定 44px 命中区；展开/收起只改本页展示，不写盘。
   宽度必须用内容宽度：微信按钮的默认宽度会把同一行的时间挤到下一行。 */
.record-attempt-more {
  flex: none;
  width: auto;
  box-sizing: border-box;
  min-width: 44px;
  min-height: 44px;
  margin: 0 0 0 8rpx;
  padding: 0 8rpx;
  background-color: transparent;
  color: #1F5948;
  font-size: 26rpx;
  line-height: 1.4;
  white-space: nowrap;
}

.record-attempt-more::after {
  border: none;
}

/* 长备注换行，不截断：原文与输入框里看到的是同一段话 */
.record-attempt-note {
  display: block;
  border-left: 4rpx solid #B7683D;
  padding: 3rpx 0 3rpx 16rpx;
  margin: 4rpx 0 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #53615B;
  word-break: break-all;
}

/* 最新一把的备注摘要只占一行（T048）：超出用省略号，展开旧把次详情才看全文 */
.record-attempt-note-summary {
  display: block;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: normal;
}

.record-attempt-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 4rpx;
}

.record-attempt-edit {
  margin: 0;
  padding: 10rpx 0;
  min-height: 44px;
}

/* 最新一把的「编辑」与视频入口同组：按内容宽度，避免默认按钮宽度独占一行；
   较早把次展开后的编辑入口保持原样。 */
.record-attempt-latest .record-attempt-edit {
  flex: none;
  width: auto;
  padding: 0 8rpx;
  white-space: nowrap;
}

.record-attempt-note-locked {
  font-size: 22rpx;
  line-height: 1.5;
  color: #53615B;
}

/* 备注与视频入口同一行（T049）：备注占满左侧，入口固定在右侧同一个槽位；
   无备注时入口仍靠右，添加与回看只换文字、不换位置也不换高度。 */
.record-attempt-detail {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 4rpx 0 8rpx;
}

.record-attempt-detail .record-attempt-note {
  flex: 1 1 auto;
  min-width: 0;
  margin: 0;
}

/* 较早把次展开（T048 返工）：备注正文在上，下一行同排「补备注／改备注」与
   「＋ 添加视频／回看视频」。备注入口靠左、视频入口靠右，两个都是独立可点目标；
   有片时入口自己写「回看视频」，不再另挂视频状态文字。 */
.record-attempt-detail-older {
  flex-direction: column;
  align-items: stretch;
}

.record-attempt-detail-older .record-attempt-note {
  margin: 0 0 4rpx;
}

.record-attempt-detail-older .record-attempt-detail-actions {
  width: 100%;
  margin-left: 0;
  justify-content: space-between;
  flex-wrap: nowrap;
}

/* 旧行的两个文字入口都按内容宽度排在同一行，320 宽也不换行、不互相覆盖。
   「补备注／改备注」三字文字实测只有 39px 宽（T048–T050 R1 原生点按区返工），
   这里按已知实际布局补最小宽度，保证至少 44×44 的常用点按目标；min-width 不打乱
   同一行的内容宽度排布，也不影响最新一把的「编辑 ›」。 */
.record-attempt-detail-older .record-attempt-edit {
  flex: none;
  width: auto;
  min-width: 44px;
  padding: 0 8rpx;
  white-space: nowrap;
}

/* 视频入口同排右侧：实测 49px 已够，仍写死最小宽度做保护，避免文案变短后掉到 44 以下。 */
.record-attempt-detail-older .record-attempt-video-action {
  min-width: 44px;
}

/* 「编辑」与视频入口同属右侧一组：备注占剩余宽度，缩窄时只省略备注，两个入口不重叠。 */
.record-attempt-detail-actions {
  flex: none;
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: auto;
}

/* 视频文字入口（T023 / T049）：入口独立于备注入口，靠右同一个槽位；
   有片「回看视频」、无片「＋ 添加视频」，不再另外渲染一行关联状态。 */
.record-attempt-video {
  flex: none;
  display: flex;
  align-items: center;
  margin-left: auto;
}

.record-attempt-video-action {
  display: block;
  min-height: 44px;
  box-sizing: border-box;
  padding: 10rpx 0 10rpx 12rpx;
  font-size: 26rpx;
  line-height: 1.4;
  color: #1F5948;
}

.record-attempt-video-saved {
  color: #B7683D;
  font-weight: 700;
}

.record-attempt-fix {
  margin-top: 8rpx;
}

/* 「改成未完成」：固定高槽，可更正时是按钮，刚改好/不可改时是只读文字 */
.record-attempt-correct-slot {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 44px;
}

.record-attempt-correct {
  width: 100%;
  margin: 0;
}

.record-attempt-correct-state {
  display: block;
  padding: 10rpx 0;
  font-size: 24rpx;
  line-height: 1.5;
  color: #1F5948;
}

.record-attempt-correct-idle {
  display: block;
  padding: 10rpx 0;
  font-size: 24rpx;
  line-height: 1.5;
  color: #53615B;
}

/* 最近一把：T050 起改为右侧「更多」展开的纵向菜单（见 .record-attempt-menu-item），
   不再使用两个并排槽；已撤回时原行直接给「恢复」按钮。 */
.record-attempt-change {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 8rpx;
}

/* 菜单项各自独占一整行、独立可点：320/390 宽度下也不重叠、不共用命中区 */
.record-attempt-menu-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
  min-height: 48px;
  margin: 0;
  padding: 12rpx 20rpx;
  background-color: #FFFFFF;
  border: 2rpx solid #D7DED9;
  border-radius: 8rpx;
  text-align: left;
}

.record-attempt-menu-item::after {
  border: none;
}

.record-attempt-menu-title {
  display: block;
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #1F5948;
}

.record-attempt-menu-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #53615B;
}

.record-attempt-restore {
  width: 100%;
  margin: 0;
}

.record-attempt-status {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #1F5948;
}

/* 两种动作对把数的影响：固定说明槽（32px = 4px 的整数倍），动作切换不改高度 */
.record-attempt-hint-slot {
  margin-top: 8rpx;
  min-height: 32px;
}

.record-attempt-hint {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  color: #53615B;
}

/* 行内备注编辑（T045）：编辑器紧挨所点那一把，不主动滚动、不挪刚点过的坐标 */
.note-editor {
  margin: 12rpx 0 4rpx;
  padding: 20rpx;
  background: #FFFFFF;
  border-left: 8rpx solid #1F5948;
  border-radius: 8rpx;
}

.note-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #182421;
}

.note-context {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: #53615B;
  margin-bottom: 12rpx;
}

.note-input {
  width: 100%;
  /* 微信原生 textarea 自带 150px 默认高度：这里由行内 height（约两行）覆盖；
     长内容在输入框内部滚动，「取消」「保存备注」始终跟在下面。 */
  min-height: 0;
  background-color: #F2F4F3;
  border: 1px solid #D7DED9;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
  word-break: break-all;
}

.button-row {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.button-row .secondary-button,
.button-row .primary-button {
  flex: 1;
  margin: 0 8rpx;
}

/* 待保存 */
.attempt-item {
  background: transparent;
  border-bottom: 1px solid #D7DED9;
  padding: 20rpx 0;
}

.pending-attempt {
  background: #F7F1E2;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.attempt-main {
  display: flex;
  align-items: baseline;
}

.attempt-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #182421;
  margin-right: 20rpx;
}

.attempt-result {
  font-size: 28rpx;
  color: #182421;
  margin-right: 20rpx;
}

.pending-footer {
  display: flex;
  flex-direction: column;
  margin-top: 12rpx;
}

.pending-status {
  font-size: 24rpx;
  line-height: 1.5;
  color: #8A442E;
}

.pending-retry {
  margin-top: 12rpx;
}

.record-foot-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #53615B;
}

/* 通用按钮：min-height 保证常用触控目标 */
.primary-button,
.secondary-button,
.text-button {
  min-height: 44px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
}

.primary-button::after,
.secondary-button::after,
.text-button::after {
  border: none;
}

.primary-button {
  background-color: #1F5948;
  color: #FFFFFF;
  border-radius: 8rpx;
  font-size: 30rpx;
  padding: 22rpx;
  border: none;
}

.secondary-button {
  background-color: #FFFFFF;
  color: #1F5948;
  border: 2rpx solid #1F5948;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 18rpx;
}

.text-button {
  background-color: transparent;
  color: #1F5948;
  font-size: 26rpx;
  padding: 8rpx 0;
}
