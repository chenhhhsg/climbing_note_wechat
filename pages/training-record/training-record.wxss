/**
 * 单线记录页样式（T036）
 * 与场内页、线路资料页保持同一套配色；结果按钮与撤回/恢复按拇指可及排版。
 */

.page {
  padding: 20rpx 32rpx 55rpx;
}

.card {
  background-color: #fffcf3;
  border-radius: 8rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.section-title,
.card-title {
  font-family: "Songti SC", "Noto Serif CJK SC", "SimSun", serif;
  line-height: 1.35;
  font-weight: 700;
  font-size: 32rpx;
  color: #173d32;
  margin-bottom: 16rpx;
}

/* 错误与提示 */
.error-card {
  background-color: #f7e6db;
}

.error-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #943a23;
  margin-bottom: 12rpx;
}

.error-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #813323;
  margin-bottom: 10rpx;
}

.error-hint {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #745241;
  margin-bottom: 16rpx;
}

.storage-error,
.notice {
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.storage-error {
  background-color: #f7e6db;
  color: #943a23;
}

.notice {
  background-color: #f3edda;
  color: #745241;
}

.storage-error-text,
.notice-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.5;
}

.storage-error-hint,
.notice-hint {
  display: block;
  font-size: 22rpx;
  margin-top: 8rpx;
  opacity: 0.75;
}

/* 当前线 */
.record-route {
  position: relative;
  display: flex;
  align-items: stretch;
  margin: 0 0 14rpx;
  overflow: hidden;
  background: #173d32;
  color: #fffcf3;
  border-radius: 8rpx;
}

.record-route .route-swatch {
  width: 9rpx;
  height: auto;
  flex: none;
  border: 0;
  border-radius: 0;
  margin: 0;
}

.record-route-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
  padding: 16rpx 22rpx 18rpx;
}

.record-route-grade {
  font: italic 700 76rpx/0.98 Georgia, "Times New Roman", serif;
  letter-spacing: -4rpx;
  color: #ff986c;
}

.record-route-name {
  margin: 8rpx 0 4rpx;
  color: #fffcf3;
  font-size: 34rpx;
  font-family: "Songti SC", "SimSun", serif;
  word-break: break-all;
}

.record-route-meta {
  color: #dbe7d6;
  font-size: 24rpx;
  line-height: 1.5;
}

.record-route-state-slot {
  display: flex;
  align-items: center;
  min-height: 42rpx;
  margin-top: 6rpx;
}

.route-state {
  display: inline-block;
  font-size: 22rpx;
  line-height: 1.4;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.route-state-done {
  background-color: #e2ebda;
  color: #2f6248;
}

.route-state-pending {
  background-color: #f3edda;
  color: #f9a825;
}

.record-session-meta {
  margin-top: 8rpx;
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-variant-numeric: tabular-nums;
  font-size: 22rpx;
  line-height: 1.5;
  color: #dbe7d6;
  word-break: break-all;
}

/* 结果区：正常态、已完攀与待确认三种面板同一行高 */
.result-footer {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  align-items: stretch;
  min-height: 96rpx;
  box-sizing: border-box;
  margin: 12rpx 0 24rpx;
}

.result-lock-hint {
  display: block;
  width: 100%;
  box-sizing: border-box;
  font-size: 24rpx;
  line-height: 1.6;
  color: #804b27;
  margin-bottom: 4rpx;
}

.result-button {
  width: auto;
  flex: 1;
  min-height: 96rpx;
  padding: 20rpx 10rpx;
  margin: 0;
  border: none;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #fffcf3;
}

.result-button::after {
  border: none;
}

.result-fail {
  color: #214637;
  background: #ebeadd;
}

.result-send {
  color: #1b3128;
  background: #ff793f;
}

.result-button[disabled] {
  opacity: 0.5;
}

.route-completed-panel,
.route-pending-panel {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 14rpx 22rpx;
  border-left: 8rpx solid #315d40;
  border-radius: 4rpx;
  background: #e7eddf;
}

.route-pending-panel {
  border-left-color: #b7683d;
  background: #f3ead7;
}

.route-completed-title,
.route-pending-title {
  flex: none;
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #173d32;
}

.route-completed-hint,
.route-pending-hint {
  flex: 1;
  min-width: 0;
  display: block;
  font-size: 26rpx;
  color: #526157;
  text-align: right;
}

/* 最近一把：两个并排的交互槽，各占一半、等高；不可用的一边留非交互空位 */
.recent-attempt {
  border-top: 1px solid #c4c8b9;
  padding-top: 14rpx;
  margin: 0 0 24rpx;
}

.recent-attempt-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.recent-attempt-title {
  font-family: "Songti SC", "Noto Serif CJK SC", "SimSun", serif;
  font-weight: 700;
  font-size: 28rpx;
  color: #173d32;
}

.recent-attempt-note {
  flex: none;
  font-size: 22rpx;
  color: #606d61;
}

.recent-attempt-row {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  min-height: 88rpx;
  margin-top: 12rpx;
}

.recent-attempt-slot,
.recent-attempt-recovery {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  align-items: stretch;
  min-height: 88rpx;
}

.recent-attempt-action,
.recent-attempt-restore {
  flex: 1 1 0;
  min-width: 0;
  margin: 0;
}

.recent-attempt-idle {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 0 18rpx;
  border: 2rpx dashed #cbd0bf;
  border-radius: 8rpx;
}

.recent-attempt-idle-text {
  font-size: 24rpx;
  line-height: 1.4;
  color: #7a8578;
  text-align: center;
}

.recent-attempt-info {
  display: flex;
  flex-direction: column;
  margin-top: 10rpx;
}

.recent-attempt-text {
  font-size: 28rpx;
  color: #173d32;
  word-break: break-all;
}

.recent-attempt-meta {
  margin-top: 4rpx;
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-variant-numeric: tabular-nums;
  font-size: 22rpx;
  line-height: 1.5;
  color: #606d61;
}

.recent-attempt-status {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #2f6248;
}

.recent-attempt-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #606d61;
}

/* 待保存 */
.attempt-item {
  background: transparent;
  border-bottom: 1px solid #cbd0bf;
  padding: 20rpx 0;
}

.pending-attempt {
  background: #f3edda;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.attempt-main {
  display: flex;
  align-items: baseline;
}

.attempt-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #173d32;
  margin-right: 20rpx;
}

.attempt-result {
  font-size: 28rpx;
  color: #173d32;
  margin-right: 20rpx;
}

.pending-footer {
  display: flex;
  flex-direction: column;
  margin-top: 12rpx;
}

.pending-status {
  font-size: 24rpx;
  line-height: 1.5;
  color: #804b27;
}

.pending-retry {
  margin-top: 12rpx;
}

/* 明细与资料入口 */
.record-links {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 8rpx 0 24rpx;
}

.record-link {
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  text-align: center;
}

/* 按把更正 */
.route-correction {
  background-color: #fffcf3;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.route-correction-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #173d32;
  margin-bottom: 10rpx;
}

.route-correction-hint {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #606d61;
  margin-bottom: 12rpx;
}

.route-correction-status {
  display: block;
  font-size: 24rpx;
  color: #804b27;
  margin-bottom: 12rpx;
}

.route-correction-row {
  border-top: 2rpx solid #f7f4ea;
  padding: 16rpx 0;
}

.route-correction-target {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: #526157;
  margin-bottom: 10rpx;
}

.route-corrected-text {
  display: block;
  font-size: 26rpx;
  color: #2f6248;
}

.record-foot-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #606d61;
}

/* 通用按钮：min-height 保证常用触控目标 */
.primary-button,
.secondary-button,
.text-button {
  min-height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
}

.primary-button::after,
.secondary-button::after,
.text-button::after {
  border: none;
}

.primary-button {
  background-color: #173d32;
  color: #fffcf3;
  border-radius: 8rpx;
  font-size: 30rpx;
  padding: 22rpx;
  border: none;
}

.secondary-button {
  background-color: #fffcf3;
  color: #173d32;
  border: 2rpx solid #173d32;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 18rpx;
}

.text-button {
  background-color: transparent;
  color: #173d32;
  font-size: 26rpx;
  padding: 8rpx 0;
}
