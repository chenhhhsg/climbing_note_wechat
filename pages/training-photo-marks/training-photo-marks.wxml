<!--
  线路照片大图 · 照片动作标记（T040）
  从线路历史的缩略图 / 「照片动作标记 · N 个」进入，只处理入口带来的那张照片：
  主图、已有标记、换图、移除与标记的新增/移动/改字/删除都在本页，返回后历史重新读数量。
  照片与标记只写本机；打开本页不写盘，所有写入都由用户明确点按触发。
-->
<view class="page">
  <!-- 本机档案损坏或版本不支持：显示可见错误，保留原数据 -->
  <view wx:if="{{loadError}}" id="load-error" class="card error-card">
    <text class="error-title">本机训练档案读取失败</text>
    <text class="error-text">{{loadError}}</text>
    <text class="error-hint">原档案保持原样，没有被改写。</text>
    <button id="retry-load" class="secondary-button" bindtap="retryLoad">重试读取</button>
  </view>

  <block wx:else>
    <view wx:if="{{notice}}" id="notice" class="notice" bindtap="dismissNotice">
      <text class="notice-text">{{notice}}</text>
      <text class="notice-hint">点击收起</text>
    </view>

    <view
      wx:if="{{photoNotice}}"
      id="photo-notice"
      class="notice"
      bindtap="dismissPhotoNotice"
    >
      <text class="notice-text">{{photoNotice}}</text>
      <text class="notice-hint">点击收起</text>
    </view>

    <view
      wx:if="{{photoChangedNotice}}"
      id="photo-changed-notice"
      class="notice"
      bindtap="dismissPhotoChangedNotice"
    >
      <text class="notice-text">{{photoChangedNotice}}</text>
      <text class="notice-hint">点击收起</text>
    </view>

    <!-- 入口归属不符：不展示线路内容，也不受理写入 -->
    <view wx:if="{{claimError}}" id="claim-error" class="card error-card">
      <text class="error-title">这个入口不属于现在的本机档案</text>
      <text id="claim-error-text" class="error-text">{{claimError}}</text>
      <text class="error-hint">原档案、照片与卡点都没有被改写；请从当前的线路历史重新打开。</text>
      <button id="claim-back" class="secondary-button" bindtap="backToList">返回上一页</button>
    </view>

    <!-- 这条线路不在本机档案里：不猜、不建 -->
    <view wx:elif="{{notFound}}" id="not-found" class="card empty-card">
      <text class="empty-title">找不到这条线路</text>
      <text class="empty-hint">本机档案里没有这条长期线路，可能来自旧云记录；旧记录请从「旧记录」入口按原 ID 回看。</text>
    </view>

    <block wx:elif="{{route}}">
      <!-- 这张照片属于哪条线路：只读展示，避免在同名线路之间串图 -->
      <view id="route-header" class="card route-header">
        <view class="route-title-row">
          <view class="route-swatch" style="background: {{route.colorHex}};"></view>
          <view class="route-title-info">
            <text class="route-grade-display">{{route.grade}}</text>
            <text class="route-name">{{route.name}}</text>
            <text class="route-meta">{{route.climbType}}{{route.colorName ? ' · ' + route.colorName : ''}}</text>
            <text class="route-gym">{{route.gymName}}</text>
          </view>
        </view>
      </view>

      <!--
        线路主照片：保存必须由用户确认；取消预览不改动已保存照片，
        取消更换后仍显示原来的主图。照片只在本机保存一份。
      -->
      <view wx:if="{{routePhoto}}" id="route-photo-card" class="card photo-card">
        <view class="photo-head">
          <text class="photo-title">线路照片</text>
          <text class="photo-note">只保存在本机</text>
        </view>

        <block wx:if="{{routePhoto.status === 'saved'}}">
          <!--
            标记模式：点岩点位置落一个卡点；非标记模式点照片打开完整大图。
            位置按原图归一化保存，指示点由当前显示框布局换算成像素后叠加在原图上。
          -->
          <view
            id="route-photo-stage"
            class="photo-mark-stage {{markMode ? 'photo-mark-stage-active' : ''}}"
            data-route-id="{{route.id}}"
            bindtap="tapPhotoStage"
          >
            <image
              id="route-photo-main"
              class="photo-main"
              src="{{routePhoto.mainPath}}"
              mode="aspectFit"
              bindload="onMarkImageLoad"
            />
            <view
              wx:for="{{markPoints}}"
              wx:key="markId"
              id="photo-mark-{{item.markId}}"
              class="mark-pin mark-pin-{{item.kind}}{{item.isSelected ? ' mark-pin-selected' : ''}}{{item.isDraft ? ' mark-pin-draft' : ''}}"
              style="left:{{item.leftPx}}px; top:{{item.topPx}}px;"
              data-mark-id="{{item.markId}}"
              catchtap="selectMarkPoint"
            >{{item.index}}</view>
          </view>
          <text id="route-photo-status" class="photo-status">{{routePhoto.statusText}}</text>
          <text wx:if="{{routePhoto.bytesText}}" class="photo-meta">{{routePhoto.bytesText}}</text>
          <text wx:if="{{!markMode}}" class="photo-hint">点击照片打开完整主图，可双指缩放。</text>
          <text wx:else class="photo-hint">标记模式：点照片上的岩点落点；点图上的编号可改字、移动或删除。</text>
          <view class="photo-actions">
            <button
              id="route-photo-preview"
              class="secondary-button photo-action"
              data-route-id="{{route.id}}"
              bindtap="previewRoutePhoto"
            >看大图</button>
            <button
              id="route-photo-remove"
              class="text-button photo-remove"
              data-route-id="{{route.id}}"
              bindtap="removeRoutePhoto"
            >移除</button>
          </view>
          <button
            wx:if="{{!routePhoto.thumbnailAvailable}}"
            id="route-photo-rebuild-thumb"
            class="secondary-button photo-action"
            data-route-id="{{route.id}}"
            bindtap="rebuildRoutePhoto"
          >重建缩略图</button>
        </block>

        <block wx:elif="{{routePhoto.status === 'preview'}}">
          <image
            id="route-photo-preview-image"
            class="photo-preview"
            src="{{routePhoto.previewPath}}"
            mode="aspectFit"
          />
          <text id="route-photo-preview-status" class="photo-status">{{routePhoto.statusText}}</text>
          <view class="photo-actions">
            <button
              id="route-photo-cancel"
              class="secondary-button photo-action"
              data-route-id="{{route.id}}"
              bindtap="cancelRoutePhoto"
            >取消</button>
            <button
              id="route-photo-confirm"
              class="primary-button photo-action"
              data-route-id="{{route.id}}"
              bindtap="confirmRoutePhoto"
            >确认保存</button>
          </view>
        </block>

        <block wx:elif="{{routePhoto.status === 'saving'}}">
          <image
            wx:if="{{routePhoto.mainPath}}"
            class="photo-thumb"
            src="{{routePhoto.mainPath}}"
            mode="aspectFit"
          />
          <text id="route-photo-saving" class="photo-status photo-status-busy">{{routePhoto.statusText}}</text>
          <text class="photo-hint">照片文件和关联都写入后才提示成功。</text>
        </block>

        <block wx:elif="{{routePhoto.status === 'failed'}}">
          <image
            wx:if="{{routePhoto.mainPath}}"
            class="photo-thumb"
            src="{{routePhoto.mainPath}}"
            mode="aspectFit"
            data-route-id="{{route.id}}"
            bindtap="previewRoutePhoto"
          />
          <text id="route-photo-error" class="photo-status photo-status-error">{{routePhoto.statusText}}</text>
          <text class="photo-error-detail">{{routePhoto.errorText}}</text>
          <view class="photo-actions">
            <button
              id="route-photo-retry"
              class="secondary-button photo-action"
              data-route-id="{{route.id}}"
              bindtap="retryRoutePhoto"
            >{{routePhoto.retryText}}</button>
            <button
              id="route-photo-dismiss"
              class="text-button photo-remove"
              data-route-id="{{route.id}}"
              bindtap="dismissRoutePhotoFailure"
            >收起</button>
          </view>
          <button
            wx:if="{{routePhoto.manageSpaceVisible}}"
            id="route-photo-space-manage"
            class="secondary-button photo-action"
            bindtap="goToClearCache"
          >去「我的」清除可重建缓存</button>
        </block>

        <block wx:elif="{{routePhoto.status === 'missing'}}">
          <text id="route-photo-missing" class="photo-status photo-status-error">本机照片不可用，可重新添加</text>
          <text class="photo-hint">照片文件可能已被系统清理；重新添加会替换原关联，历史尝试与备注不变。</text>
        </block>

        <block wx:elif="{{routePhoto.status === 'error'}}">
          <text id="route-photo-read-error" class="photo-status photo-status-error">{{routePhoto.statusText}}</text>
          <button
            id="route-photo-reload"
            class="secondary-button photo-action"
            data-route-id="{{route.id}}"
            bindtap="reloadRoutePhoto"
          >重试读取</button>
        </block>

        <block wx:else>
          <text id="route-photo-loading" class="photo-status">{{routePhoto.statusText}}</text>
        </block>

        <view wx:if="{{routePhoto.sourceVisible}}" class="photo-source-row">
          <button
            id="route-photo-camera"
            class="secondary-button photo-source"
            data-source="camera"
            data-route-id="{{route.id}}"
            bindtap="chooseRoutePhoto"
          >{{routePhoto.cameraText}}</button>
          <button
            id="route-photo-album"
            class="secondary-button photo-source"
            data-source="album"
            data-route-id="{{route.id}}"
            bindtap="chooseRoutePhoto"
          >{{routePhoto.albumText}}</button>
        </view>
      </view>

      <!--
        照片动作标记：只读写本机标记记录这一份独立数据，主图字节、把次、备注
        与体测都不动，也不烧进照片、不上传。位置按原图归一化保存，换屏、旋转或跨天
        重开仍指向原图上的同一个岩点；点在照片外的留白上不生成卡点。
      -->
      <view wx:if="{{routePhoto}}" id="mark-card" class="card mark-card">
        <view class="mark-head">
          <text class="mark-title">照片动作标记</text>
          <text wx:if="{{markCountText}}" id="mark-count" class="mark-count">{{markCountText}}</text>
        </view>

        <text wx:if="{{marksError}}" id="mark-error" class="mark-error">{{marksError}}</text>
        <text wx:elif="{{markHiddenText}}" id="mark-hidden" class="mark-hint">{{markHiddenText}}</text>

        <block wx:if="{{marksReady}}">
          <view wx:if="{{routePhoto.status === 'saved'}}" class="mark-actions">
            <button
              wx:if="{{!markMode}}"
              id="mark-enter"
              class="secondary-button mark-action"
              bindtap="enterMarkMode"
            >标记卡点</button>
            <button
              wx:else
              id="mark-exit"
              class="secondary-button mark-action"
              bindtap="exitMarkMode"
            >完成标记</button>
          </view>
          <text
            wx:elif="{{routePhoto.status === 'missing'}}"
            id="mark-photo-missing"
            class="mark-hint"
          >本机照片不可用（文件可能已被清理），重新添加后才能在上面标记；下面仍可读回已写的提示。</text>
          <text wx:else id="mark-no-photo" class="mark-hint">还没有主照片。先从相册或拍照添加一张，再在照片上标记。</text>
        </block>

        <text wx:if="{{markLayoutError}}" id="mark-layout-error" class="mark-warn">{{markLayoutError}}</text>
        <button
          wx:if="{{markLayoutError && routePhoto.status === 'saved'}}"
          id="mark-reload-image"
          class="text-button"
          bindtap="reloadMarkImage"
        >重新测量照片尺寸</button>

        <text wx:if="{{markNotice}}" id="mark-notice" class="mark-notice" bindtap="dismissMarkNotice">{{markNotice}}</text>
        <text wx:if="{{markSaveError}}" id="mark-save-error" class="mark-error" bindtap="dismissMarkSaveError">{{markSaveError}}</text>

        <text wx:if="{{markMode && routePhoto.status === 'saved'}}" id="mark-stage-hint" class="mark-hint">{{markMoving ? '点照片上的新位置，把选中的卡点移过去。' : markEditable ? '可以直接点图上已有的编号，改字、移动或删除。' : '点照片上的岩点位置落一个卡点；点在照片外的留白上不会生成。'}}</text>

        <!-- 编辑区：新草稿点，或选中的已有卡点 -->
        <view wx:if="{{markEditable}}" id="mark-editor" class="mark-editor">
          <text wx:if="{{markDraft}}" id="mark-editor-draft-title" class="mark-editor-title">新卡点（还没保存）</text>
          <text wx:else id="mark-editor-title" class="mark-editor-title">编辑第 {{markSelected.index}} 条卡点</text>
          <view class="mark-kind-row">
            <button
              wx:for="{{markKinds}}"
              wx:key="value"
              id="mark-kind-{{item.value}}"
              class="mark-kind {{markKind === item.value ? 'mark-kind-active' : ''}}"
              data-kind="{{item.value}}"
              bindtap="pickMarkKind"
            >{{item.text}}</button>
          </view>
          <input
            id="mark-text-input"
            class="mark-input"
            value="{{markText}}"
            maxlength="{{markTextMax}}"
            placeholder="例如：左脚踩这里"
            bindinput="onMarkTextInput"
          />
          <view class="mark-actions">
            <button
              wx:if="{{markDraft}}"
              id="mark-save-draft"
              class="primary-button mark-action"
              bindtap="saveMarkDraft"
            >保存卡点</button>
            <block wx:else>
              <button
                wx:if="{{!markMoving}}"
                id="mark-save-edit"
                class="primary-button mark-action"
                bindtap="saveMarkEdit"
              >保存修改</button>
              <button
                wx:if="{{!markMoving && routePhoto.status === 'saved'}}"
                id="mark-move"
                class="secondary-button mark-action"
                bindtap="startMarkMove"
              >移动</button>
              <button
                wx:if="{{markMoving}}"
                id="mark-cancel-move"
                class="secondary-button mark-action"
                bindtap="cancelMarkMove"
              >取消移动</button>
              <button
                id="mark-delete"
                class="text-button mark-delete"
                bindtap="deleteMarkPoint"
              >删除这条卡点</button>
            </block>
          </view>
        </view>

        <!-- 文字清单：原图缺失或离线时也能读回已写的提示 -->
        <view wx:if="{{markList.length > 0}}" id="mark-list" class="mark-list">
          <text class="mark-list-title">已写的卡点</text>
          <view
            wx:for="{{markList}}"
            wx:key="markId"
            id="mark-item-{{item.markId}}"
            class="mark-item"
            data-mark-id="{{item.markId}}"
            bindtap="selectMarkPoint"
          >
            <text class="mark-item-index">{{item.index}}</text>
            <text class="mark-item-kind">{{item.kindText}}</text>
            <text class="mark-item-text">{{item.textText}}</text>
          </view>
        </view>
        <text wx:else id="mark-empty" class="mark-hint">还没有卡点。进入标记模式，在主照片的岩点位置点一下。</text>
      </view>

      <text wx:if="{{routePhoto && routePhoto.status === 'missing'}}" class="page-hint">照片缺失时仍可读回已写的提示文字；重新添加照片后再回到大图，原有标记会按原图位置重新定位。</text>
    </block>
  </block>
</view>
