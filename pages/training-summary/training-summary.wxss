/**
 * 本次小结独立页样式（T034）
 *
 * 与场内页同一套配色与排版（墨绿主色 #173d32、橙 #ff793f、粉笔白 #fffcf3），
 * 只保留这一页真正用到的规则：小结读数、只读回看选择器、各线分项与勾选入口。
 */

.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.card {
  background-color: #fffcf3;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.section {
  margin-bottom: 30rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #173d32;
  margin-bottom: 16rpx;
}

/* 错误与提示 */
.error-card {
  background-color: #f7e6db;
}

.error-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #943a23;
  margin-bottom: 12rpx;
}

.error-text {
  display: block;
  font-size: 26rpx;
  color: #813323;
  margin-bottom: 10rpx;
}

.error-hint {
  display: block;
  font-size: 24rpx;
  color: #745241;
  margin-bottom: 16rpx;
}

.storage-error,
.notice {
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.storage-error {
  background-color: #f7e6db;
  color: #943a23;
}

.notice {
  background-color: #f3edda;
  color: #745241;
}

.storage-error-text,
.notice-text {
  display: block;
  font-size: 26rpx;
}

.storage-error-hint,
.notice-hint {
  display: block;
  font-size: 22rpx;
  margin-top: 8rpx;
  opacity: 0.75;
}

/* 按钮 */
.secondary-button {
  background-color: #fffcf3;
  color: #173d32;
  border: 2rpx solid #173d32;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 18rpx;
}

.text-button {
  background-color: transparent;
  color: #173d32;
  font-size: 26rpx;
  padding: 8rpx 0;
}

.secondary-button::after,
.text-button::after {
  border: none;
}

/* 线路色标：只表示线路颜色，不表示状态 */
.route-swatch {
  width: 28rpx;
  height: 28rpx;
  border-radius: 6rpx;
  margin-right: 16rpx;
  border: 2rpx solid #e0e0e0;
}

.empty-attempts {
  font-size: 26rpx;
  color: #606d61;
  padding: 24rpx 0;
}

/* 小结 */
.session-summary .section-title { margin-bottom: 20rpx; }
.summary-error-card { background: #f7e6db; border-radius: 12rpx; padding: 20rpx 24rpx; }
.summary-error-text { display: block; font-size: 26rpx; color: #943a23; }
.summary-error-hint { display: block; font-size: 22rpx; color: #745241; margin-top: 8rpx; }
.summary-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.summary-count { font-family: "Songti SC", "Noto Serif CJK SC", "SimSun", serif; font-weight: 700; font-size: 34rpx; color: #173d32; }
.summary-send { flex: none; font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 26rpx; color: #ff793f; }
.summary-other, .summary-pending, .summary-hint { display: block; margin-top: 10rpx; font-size: 24rpx; line-height: 1.6; color: #526157; }
.summary-pending { color: #9c5222; }
.summary-return { margin-top: 16rpx; margin-left: 0; margin-right: 0; }

.summary-session-picker { margin-top: 16rpx; padding: 18rpx 20rpx; background: #f3f1e6; border: 1px solid #d6d5c6; border-radius: 8rpx; }
.summary-session-title { display: block; font-size: 24rpx; color: #526157; }
.summary-session-value { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 10rpx; padding: 14rpx 18rpx; background: #fffcf3; border: 1px solid #c9c8b8; border-radius: 8rpx; }
.summary-session-value-text { flex: 1; min-width: 0; font-size: 28rpx; color: #173d32; word-break: break-all; }
.summary-session-arrow { flex: none; font-size: 26rpx; color: #d2784f; }
.summary-session-hint { display: block; margin-top: 10rpx; font-size: 22rpx; line-height: 1.6; color: #606d61; }
.summary-row { background: #fffcf3; border: 1px solid #d6d5c6; border-radius: 8rpx; padding: 20rpx; margin-top: 12rpx; }
.summary-row-main { display: flex; align-items: flex-start; }
.summary-row .route-swatch { flex: none; margin-top: 6rpx; }
.summary-row-info { flex: 1; min-width: 0; }
.summary-row-head { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; }
.summary-name { font-size: 30rpx; font-weight: 700; color: #173d32; word-break: break-all; }
.summary-grade { flex: none; font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 26rpx; color: #ff793f; }
.summary-state { flex: none; font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; background: #e4ebdf; color: #355e50; }
.summary-state-done { background: #dfebd9; color: #204b34; }
.summary-state-sent { background: #f3e2d4; color: #8a4a24; }
.summary-meta { display: block; font-size: 24rpx; color: #606d61; margin-top: 6rpx; }
.summary-note { display: block; font-size: 24rpx; color: #526157; margin-top: 6rpx; border-left: 4rpx solid #d2784f; padding-left: 14rpx; line-height: 1.5; word-break: break-all; }
.summary-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.summary-actions .summary-pick { flex: 1; min-width: 280rpx; margin: 0; }
.summary-pick-on { background: #e7eddf; color: #204b34; }
.summary-pick-state { font-size: 24rpx; color: #526157; }
.summary-actions .summary-open { flex: none; margin: 0; padding: 0 8rpx; font-size: 26rpx; color: #173d32; }

/* 岩馆手册：与场内页共用的字号与触控尺寸（拇指可及至少 88rpx ≈ 44px 逻辑像素） */
.page { padding: 20rpx 32rpx 55rpx; }
.section-title, .card-title { font-family: "Songti SC", "Noto Serif CJK SC", "SimSun", serif; line-height: 1.35; font-weight: 700; }
.section-title { font-size: 39rpx; border-bottom: 2rpx solid #173d32; padding: 0 0 14rpx; }
.card { border-radius: 8rpx; box-shadow: none; }
.secondary-button, .text-button { min-height: 88rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; line-height: 1.4; }
.secondary-button { border-radius: 8rpx; }
.summary-back-section { margin-top: 10rpx; }
