/**
 * 场内页样式（T017 开场 / T030 加线 / T036 入口收敛 / T037 统一线路列表 / T044 一线一卡）
 *
 * 视觉规格（T037 起，整条训练动线共用这一套；T044 把本场线路改成一条线一张中性细边框卡）：
 * - 白色内容区 #FFFFFF、浅灰页底 #F2F4F3、深墨标题与正文 #182421、次级文字 #53615B；
 * - 墨绿 #1F5948 标主操作与当前线，橙色 #FF793F 只标完攀；
 * - 中性细边框 #D7DED9 承接每一张线路卡与表单分区，卡间留 12px 间距；
 *   岩点颜色只表示线路色（小色块）；
 * - 标题与正文用设备中文黑体，间距按 4 像素体系（rpx 排版），
 *   常用命中区在原生视口下至少 44×44 逻辑像素，因此行高与按钮高度用 px 兜底
 *   （rpx 会随屏宽缩放：88rpx 在 390 宽是 45.8px，在 320 宽只有 37.5px，不够 44）。
 */

page {
  background-color: #F2F4F3;
}

.page {
  padding: 12px 12px 32px;
  background-color: #F2F4F3;
}

.card {
  background-color: #FFFFFF;
  border: 1px solid #D7DED9;
  border-radius: 8rpx;
  padding: 16px;
  margin-bottom: 12px;
}

.card-title {
  display: block;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans CJK SC",
    "Source Han Sans SC", "Microsoft YaHei", sans-serif;
  font-size: 32rpx;
  font-weight: 700;
  color: #182421;
  margin-bottom: 16rpx;
}

.section {
  margin-bottom: 16px;
}

.section-title {
  display: block;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans CJK SC",
    "Source Han Sans SC", "Microsoft YaHei", sans-serif;
  font-size: 34rpx;
  font-weight: 700;
  color: #182421;
  margin-bottom: 16rpx;
}

/* ---- 错误、未落盘与说明性提示 ---- */

.error-card {
  background-color: #F7E6DB;
  border-color: #E2C3B4;
}

.error-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #943A23;
  margin-bottom: 12rpx;
}

.error-text {
  display: block;
  font-size: 26rpx;
  color: #813323;
  margin-bottom: 10rpx;
  word-break: break-all;
}

.error-hint {
  display: block;
  font-size: 24rpx;
  color: #745241;
  margin-bottom: 16rpx;
}

.storage-error,
.notice {
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.storage-error {
  background-color: #F7E6DB;
  border-left: 8rpx solid #943A23;
  color: #943A23;
}

.notice {
  background-color: #F7F1E2;
  border-left: 8rpx solid #B7683D;
  color: #745241;
}

.storage-error-text,
.notice-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  word-break: break-all;
}

.storage-error-hint,
.notice-hint {
  display: block;
  font-size: 22rpx;
  margin-top: 8rpx;
  opacity: 0.75;
}

/* T053：清理重试是行内链接，320/390 宽下随文字换行，不挤掉说明。 */
.retry-link {
  display: inline-block;
  min-height: 44px;
  line-height: 44px;
  margin-top: 8rpx;
  color: #173d32;
  font-size: 26rpx;
  font-weight: bold;
}

.field-error {
  display: block;
  font-size: 24rpx;
  color: #9C3D22;
  margin-bottom: 12rpx;
  word-break: break-all;
}

/* ---- 表单 ---- */

.field {
  margin-bottom: 20rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #53615B;
  margin-bottom: 10rpx;
}

.text-input,
.picker-value {
  background-color: #F2F4F3;
  border: 1px solid #D7DED9;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #182421;
}

.text-input {
  min-height: 44px;
  box-sizing: border-box;
}

.picker-value {
  display: flex;
  align-items: center;
  min-height: 44px;
  box-sizing: border-box;
}

/* ---- 按钮：墨绿主操作；命中区至少 44 逻辑像素高 ---- */

.primary-button,
.secondary-button,
.text-button {
  min-height: 44px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
  border-radius: 8rpx;
}

.primary-button::after,
.secondary-button::after,
.text-button::after {
  border: none;
}

.primary-button {
  background-color: #1F5948;
  color: #FFFFFF;
  border: none;
  font-size: 30rpx;
  font-weight: 650;
  padding: 22rpx;
}

.secondary-button {
  background-color: #FFFFFF;
  color: #1F5948;
  border: 2rpx solid #1F5948;
  font-size: 28rpx;
  padding: 18rpx;
}

.text-button {
  background-color: transparent;
  color: #1F5948;
  font-size: 26rpx;
  padding: 0 8rpx;
}

/* ---- 场次 ---- */

.session-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  column-gap: 12rpx;
}

.session-heading {
  flex: 1;
  min-width: 0;
}

.session-heading .card-title {
  font-size: 34rpx;
  margin-bottom: 4rpx;
  word-break: break-all;
}

.session-meta {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: #53615B;
  font-variant-numeric: tabular-nums;
}

.session-new {
  flex: none;
  margin: 0;
  font-size: 24rpx;
}

.session-switch {
  margin-top: 20rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 同日多场的场次切换：每个可选一幕都是可点控件，命中区按 44 逻辑像素起。 */
.chip {
  display: flex;
  align-items: center;
  min-height: 44px;
  box-sizing: border-box;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background-color: #F2F4F3;
  border: 1px solid #D7DED9;
  color: #53615B;
  font-size: 26rpx;
}

.chip-active {
  background-color: #1F5948;
  border-color: #1F5948;
  color: #FFFFFF;
  font-weight: 650;
}

/* ---- 本场线路：标题行、空态与重试入口 ---- */

.session-routes {
  margin-bottom: 24rpx;
}

.route-section-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.route-section-head .section-title {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.routes-count {
  flex: none;
  font-size: 24rpx;
  color: #53615B;
  font-variant-numeric: tabular-nums;
}

.add-route-inline {
  flex: none;
  font-size: 28rpx;
  font-weight: 700;
  color: #1F5948;
}

.first-route-hint {
  display: block;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #53615B;
}

.add-route-first {
  width: 100%;
}

/* 关联成功但选中失败：不报成功，留可点的重试入口 */
.link-retry-card {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: #F7F1E2;
  border-left: 8rpx solid #B7683D;
  border-radius: 8rpx;
}

.link-retry-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #943A23;
  word-break: break-all;
}

.link-retry-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #745241;
}

.link-retry-button {
  width: 100%;
  margin-top: 14rpx;
}

/* ---- 加线面板：本馆已有 / 新建线路两个来源 ---- */

.add-route-panel {
  margin-top: 16rpx;
}

.add-route-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.add-route-tab {
  flex: 1;
  min-height: 44px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 10rpx;
  font-size: 28rpx;
  color: #53615B;
  background: #F2F4F3;
  border: 1px solid #D7DED9;
  border-radius: 8rpx;
  text-align: center;
}

.add-route-tab-on {
  background: #1F5948;
  border-color: #1F5948;
  color: #FFFFFF;
  font-weight: 700;
}

/* 本馆已有的线路：整行可点，一行一条 */
.gym-route-item {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 44px;
  box-sizing: border-box;
  padding: 16rpx 0;
  border-bottom: 1px solid #D7DED9;
}

.gym-route-item:last-child {
  border-bottom: none;
}

.gym-route-name {
  display: block;
  font-size: 28rpx;
  color: #182421;
  word-break: break-all;
}

.gym-route-meta {
  display: block;
  font-size: 24rpx;
  color: #53615B;
  margin-top: 6rpx;
}

.empty-attempts {
  font-size: 26rpx;
  line-height: 1.6;
  color: #53615B;
  padding: 24rpx 0;
}

.quick-route-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin: 20rpx 0;
}

.quick-route-row picker {
  flex: 1;
  min-width: 0;
}

.color-toggle {
  justify-content: flex-start;
  font-size: 26rpx;
  color: #1F5948;
}

.color-clear {
  justify-content: flex-start;
  color: #745241;
}

.add-route-cancel {
  width: 100%;
  margin-top: 14rpx;
  color: #745241;
}

.photo-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #53615B;
}

/* ---- 统一线路列表（T037 / T044）：一线一卡，整行点入单线记录 ---- */

/* 列表只负责纵向排布与卡间距；卡框落在每一条线自己的行上，相邻条目靠间距区分。 */
.route-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* 同一套卡样式：0 把、1 条、4 条以上都一样；卡宽占满，不随名称长短变化。 */
.route-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  min-height: 72px;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  background: #FFFFFF;
  border: 1px solid #D7DED9;
  border-radius: 8rpx;
}

/* 当前线：左侧墨绿边缘标记 + 标题旁的「当前」短文字，位置不动，行序不变。 */
.route-row-on {
  background: #F3F8F5;
  box-shadow: inset 8rpx 0 0 #1F5948;
}

.route-row-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.route-row-current {
  flex: none;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #1F5948;
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 1.4;
  font-weight: 650;
}

/* 等级槽：V 级与 YDS 都用同一个槽，槽宽不随等级位数跳动。 */
.route-grade {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 52px;
  min-height: 44px;
  box-sizing: border-box;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: #E9EFEC;
  color: #1F5948;
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  text-align: center;
  word-break: break-all;
}

.route-row-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

/* 长名换行，不截断、不省略：行高由内容决定，行宽始终占满。 */
.route-row-name {
  display: block;
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.35;
  color: #182421;
  word-break: break-all;
}

.route-row-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

/* 岩点颜色只表示线路色：一个小色块，不是状态。 */
.route-color {
  flex: none;
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
  border: 1px solid #D7DED9;
}

.route-row-type {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.4;
  color: #53615B;
  word-break: break-all;
}

/* 读数槽：本场有效把数 + 适用的文字状态（已完攀 / 完攀待确认），靠右、不断行。 */
.route-row-state {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  max-width: 38%;
  text-align: right;
}

.route-row-count {
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
  line-height: 1.3;
  color: #182421;
  font-variant-numeric: tabular-nums;
}

.route-row-status {
  font-size: 24rpx;
  line-height: 1.3;
}

.route-row-status-done {
  color: #FF793F;
  font-weight: 650;
}

.route-row-status-pending {
  color: #8A442E;
}

.route-row-chev {
  flex: none;
  font-size: 34rpx;
  line-height: 1;
  color: #53615B;
}

/* ---- 本次小结入口（T034）：完整小结在独立页 pages/training-summary ---- */

.session-summary .section-title {
  margin-bottom: 20rpx;
}

.summary-entry-card {
  background: #FFFFFF;
  border: 1px solid #D7DED9;
  border-radius: 8rpx;
  padding: 20rpx;
}

.summary-entry-target {
  display: block;
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-variant-numeric: tabular-nums;
  font-size: 26rpx;
  color: #182421;
}

.summary-entry-other {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #53615B;
}

.summary-entry-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #53615B;
}

.summary-entry-button {
  margin: 16rpx 0 0;
}

/* ---- 窄屏（320 逻辑像素宽）：行内间距收紧，等级槽占宽减小，长名仍然换行 ---- */

@media (max-width: 350px) {
  .page {
    padding: 8px 8px 20px;
  }

  .card {
    padding: 12px;
  }

  .route-row {
    gap: 8rpx;
    padding: 16rpx 12rpx;
  }

  .route-grade {
    min-width: 44px;
    font-size: 26rpx;
  }

  .route-row-state {
    max-width: 34%;
  }
}
