<!--
  正式场内记录页（T017）
  开始/继续场次 → 选原线或新建三类线路 → 逐把记录结果与备注 → 抱石误点完攀按把更正。
  只读写 T016 的正式本机档案，不接云、不引用试用工程。
-->
<view class="page">
  <!-- 本机档案损坏或版本不支持：显示可见错误，不覆盖原数据 -->
  <view wx:if="{{loadError}}" id="load-error" class="card error-card">
    <text class="error-title">本机训练档案读取失败</text>
    <text class="error-text">{{loadError}}</text>
    <text class="error-hint">原档案保持原样，没有被改写。</text>
    <button id="retry-load" class="secondary-button" bindtap="retryLoad">重试读取</button>
  </view>

  <block wx:else>
    <!-- 本次操作未落盘：不报已保存，重试沿用同一把 -->
    <view
      wx:if="{{storageError}}"
      id="storage-error"
      class="storage-error"
      bindtap="dismissStorageError"
    >
      <text class="storage-error-text">{{storageError}}</text>
      <text class="storage-error-hint">当前操作未生效，可重试；点击收起</text>
    </view>

    <view wx:if="{{notice}}" id="notice" class="notice" bindtap="dismissNotice">
      <text class="notice-text">{{notice}}</text>
      <text class="notice-hint">点击收起</text>
    </view>

    <view
      wx:if="{{photoNotice}}"
      id="photo-notice"
      class="notice"
      bindtap="dismissPhotoNotice"
    >
      <text class="notice-text">{{photoNotice}}</text>
      <text class="notice-hint">点击收起</text>
    </view>

    <!-- 开始场次：填自己的岩馆，日期默认本地今天 -->
    <view wx:if="{{sessionFormVisible}}" id="session-form" class="card session-form">
      <text class="card-title">{{sessionFormTitle}}</text>
      <view class="field">
        <text class="field-label">岩馆</text>
        <input
          id="gym-name-input"
          class="text-input"
          placeholder="例如：我今天去的岩馆"
          value="{{gymName}}"
          maxlength="40"
          bindinput="onGymNameInput"
        />
      </view>
      <view class="field">
        <text class="field-label">日期</text>
        <picker mode="date" value="{{sessionDate}}" bindchange="onSessionDateChange">
          <view class="picker-value">{{sessionDate}}</view>
        </picker>
      </view>
      <text wx:if="{{formError}}" id="form-error" class="field-error">{{formError}}</text>
      <button id="start-session" class="primary-button" bindtap="startSession">开始场次</button>
      <button
        wx:if="{{activeSession}}"
        id="cancel-session-form"
        class="text-button"
        bindtap="cancelSessionForm"
      >取消</button>
    </view>

    <block wx:if="{{activeSession}}">
      <view class="card session-card">
        <view class="session-top">
          <view class="session-heading">
            <text class="card-title">{{activeSession.gymName}}</text>
            <text class="session-meta">{{activeSession.dateText}} · {{activeSession.label}}</text>
          </view>
          <button id="open-session-form" class="text-button session-new" bindtap="openSessionForm">
            开始新场次
          </button>
        </view>

        <!-- 同日多场：只切换归属，不新建场次 -->
        <view wx:if="{{sameDaySessions.length > 1}}" class="session-switch">
          <text class="field-label">本日场次</text>
          <view class="chip-row">
            <view
              wx:for="{{sameDaySessions}}"
              wx:key="id"
              id="session-chip-{{item.id}}"
              class="chip {{item.isActive ? 'chip-active' : ''}}"
              data-session-id="{{item.id}}"
              bindtap="switchSession"
            >{{item.label}}</view>
          </view>
        </view>
      </view>

      <!--
        本场线路与加线入口（T030）：常驻首屏。
        空场首屏直接是「添加第一条线路」；有线时在「本场线路」旁常驻「＋ 加线」。
        加线面板只有两个来源：本馆已有线路（同一个 routeId 关联进本场并选中）与新建线路
        （沿用原有的类型/等级校验与本机保存）。打开与取消面板都不写盘。
      -->
      <view id="session-routes" class="section session-routes">
        <view class="route-section-head">
          <text class="section-title">本场线路</text>
          <button
            wx:if="{{routes.length > 0}}"
            id="add-route"
            class="text-button add-route-inline"
            bindtap="openAddRoute"
          >＋ 加线</button>
        </view>

        <!-- 本场已有线路：点名字即切为当前记录目标 -->
        <view wx:if="{{routes.length > 0}}" class="route-list">
          <view
            wx:for="{{routes}}"
            wx:key="id"
            id="route-{{item.id}}"
            class="route-item {{item.isSelected ? 'route-selected' : ''}}"
            data-route-id="{{item.id}}"
            bindtap="selectRoute"
          >
            <view class="route-main">
              <view class="route-swatch" style="background: {{item.colorHex}};"></view>
              <view class="route-info">
                <text class="route-name">{{item.name}}</text>
                <text class="route-meta">{{item.climbType}} {{item.grade}}{{item.colorName ? ' · ' + item.colorName : ''}}</text>
              </view>
              <text
                wx:if="{{item.completionText}}"
                id="route-state-{{item.id}}"
                class="route-state {{item.isCompleted ? 'route-state-done' : 'route-state-pending'}}"
              >{{item.completionText}}</text>
              <text wx:if="{{item.isSelected}}" class="route-check">已选</text>
            </view>
          </view>
        </view>

        <block wx:else>
          <text class="first-route-hint">本场还没有线路，先加一条再记结果。</text>
          <button
            id="add-first-route"
            class="primary-button add-route-first"
            bindtap="openAddRoute"
          >添加第一条线路</button>
        </block>

        <!-- 已有线关联成功、选中失败：不报成功，在这里留可点的重试入口 -->
        <view wx:if="{{linkRetry}}" id="add-route-link-retry" class="link-retry-card">
          <text class="link-retry-text">「{{linkRetry.routeName}}」已加入本场，但还没选中：{{linkRetry.error}}</text>
          <text class="link-retry-hint">本场只会有一条关联；点下面的按钮按同一条线路重试选中。</text>
          <button
            id="add-route-link-retry-button"
            class="secondary-button link-retry-button"
            data-route-id="{{linkRetry.routeId}}"
            bindtap="retryLinkSelection"
          >重试选中</button>
        </view>

        <view wx:if="{{addRouteVisible}}" id="add-route-panel" class="card add-route-panel">
          <text class="card-title">加线</text>
          <view class="add-route-tabs">
            <view
              id="add-route-tab-existing"
              class="add-route-tab {{addRouteMode === 'existing' ? 'add-route-tab-on' : ''}}"
              data-mode="existing"
              bindtap="switchAddRouteMode"
            >本馆已有</view>
            <view
              id="add-route-tab-new"
              class="add-route-tab {{addRouteMode === 'new' ? 'add-route-tab-on' : ''}}"
              data-mode="new"
              bindtap="switchAddRouteMode"
            >新建线路</view>
          </view>

          <!-- 本馆已有：本岩馆里还没进本场次的线路，点一条就关联并选中 -->
          <block wx:if="{{addRouteMode === 'existing'}}">
            <block wx:if="{{gymRoutes.length > 0}}">
              <text class="field-label">本馆已有线路（点一条加入本场）</text>
              <view
                wx:for="{{gymRoutes}}"
                wx:key="id"
                id="gym-route-{{item.id}}"
                class="gym-route-item"
                data-route-id="{{item.id}}"
                bindtap="pickGymRoute"
              >
                <text class="gym-route-name">{{item.name}}</text>
                <text class="gym-route-meta">{{item.climbType}} {{item.grade}}{{item.colorName ? ' · ' + item.colorName : ''}}</text>
              </view>
            </block>
            <view wx:else id="add-route-no-existing" class="empty-attempts">
              <text>本馆还没有别的线路可以加入本场，用「新建线路」加一条。</text>
            </view>
          </block>

          <block wx:else>
            <!-- 新建线路：名称、类型、等级在首层；颜色可展开；没有照片也能创建 -->
            <input
              id="new-route-name"
              class="text-input"
              placeholder="线路名称，例如：蓝色动态线"
              value="{{newRouteName}}"
              maxlength="40"
              bindinput="onNewRouteNameInput"
            />

            <!-- 攀岩类型在左、等级在右；等级选项随类型重算，失效时显示「请选择等级」 -->
            <view class="quick-route-row">
              <picker
                mode="selector"
                range="{{newRouteTypes}}"
                value="{{newRouteTypeIndex}}"
                bindchange="onNewRouteTypeChange"
              >
                <view id="new-route-type" class="picker-value">攀岩类型：{{newRouteType}}</view>
              </picker>
              <picker
                mode="selector"
                range="{{newRouteGrades}}"
                value="{{newRouteGradeIndex}}"
                bindchange="onNewRouteGradeChange"
              >
                <view id="new-route-grade" class="picker-value">等级：{{newRouteGradeText}}</view>
              </picker>
            </view>

            <!-- 颜色是可选属性：默认收起（按「不指定」保存），展开后才填写 -->
            <button
              id="toggle-new-route-color"
              class="text-button color-toggle"
              bindtap="toggleNewRouteColor"
            >{{newRouteColorToggleText}}</button>
            <view wx:if="{{newRouteColorVisible}}" class="field">
              <text class="field-label">颜色</text>
              <picker
                mode="selector"
                range="{{newRouteColors}}"
                range-key="name"
                value="{{newRouteColorIndex}}"
                bindchange="onNewRouteColorChange"
              >
                <view id="new-route-color" class="picker-value">{{newRouteColorText}}</view>
              </picker>
              <button
                id="new-route-color-clear"
                class="text-button color-clear"
                bindtap="clearNewRouteColor"
              >清除颜色</button>
            </view>

            <!-- 新建线路可选一张照片；跳过也能创建，照片失败不回滚线路 -->
            <view class="quick-route-photo">
              <text class="field-label">线路照片（可选）</text>
              <view wx:if="{{newRoutePhoto}}" class="quick-photo-preview">
                <image
                  id="new-route-photo-preview"
                  class="photo-preview"
                  src="{{newRoutePhoto.path}}"
                  mode="aspectFit"
                />
                <text class="photo-status">{{newRoutePhoto.statusText}}</text>
                <button
                  id="new-route-photo-cancel"
                  class="text-button photo-remove"
                  bindtap="cancelNewRoutePhoto"
                >取消照片</button>
              </view>
              <view wx:else class="photo-source-row">
                <button
                  id="new-route-photo-camera"
                  class="secondary-button photo-source"
                  data-source="camera"
                  bindtap="chooseNewRoutePhoto"
                >拍照</button>
                <button
                  id="new-route-photo-album"
                  class="secondary-button photo-source"
                  data-source="album"
                  bindtap="chooseNewRoutePhoto"
                >从相册选择</button>
              </view>
              <text class="photo-hint">不添加照片也能创建线路；保存后还能从当前线路补照片。</text>
            </view>

            <text wx:if="{{newRouteError}}" id="new-route-error" class="field-error">{{newRouteError}}</text>
            <button id="create-route" class="secondary-button" bindtap="createRoute">创建并选中</button>
          </block>

          <button
            id="cancel-add-route"
            class="text-button add-route-cancel"
            bindtap="cancelAddRoute"
          >取消加线</button>
        </view>
      </view>

      <!-- 本场记录：已选线路、逐把结果、待保存行与按把更正 -->
      <view wx:if="{{selectedRoute}}" class="section current-route">
        <text class="section-title">本场记录</text>
        <view class="selected-route">
          <view class="route-swatch" style="background: {{selectedRoute.colorHex}};"></view>
          <view class="selected-route-info">
            <text class="selected-route-grade">{{selectedRoute.grade}}</text>
            <text class="selected-route-name">{{selectedRoute.name}}</text>
            <text class="selected-route-meta">{{selectedRoute.climbType}} · 本场 {{routeCountText}}</text>
            <text
              wx:if="{{routeStateText}}"
              id="selected-route-state"
              class="route-state {{routeCompleted ? 'route-state-done' : 'route-state-pending'}}"
            >{{routeStateText}}</text>
          </view>
        </view>

        <!--
          结果按钮旁换线（T031）：不用滚回页顶的「本场线路」就能换线，换完就地记结果。
          1–3 条时直接列出本场全部线路；超过 3 条时只列当前线与最多两条不重复的近期线路，
          其余由「全部 N 条」展开（N 是真实的本场关联数）。点线路名走的就是原来那一个
          selectRoute —— 只改当前选择，不新建线路、不加关联、不产生把次；别的场次独有的
          线路不在本场列表里，因此不会出现。展开与收起只切本页展示，不改当前线。
        -->
        <view wx:if="{{routes.length > 0}}" id="route-switch" class="route-switch">
          <view class="route-switch-head">
            <text class="route-switch-title">换线</text>
            <text class="route-switch-count">本场 {{routeSwitchTotal}} 条</text>
          </view>

          <!-- 展开：本场全部线路，每条一整行，长名称换行显示 -->
          <block wx:if="{{routeSwitchExpanded}}">
            <view class="route-switch-list">
              <view
                wx:for="{{routeSwitchAllRows}}"
                wx:key="id"
                id="route-switch-row-{{item.id}}"
                class="route-switch-row {{item.isSelected ? 'route-switch-row-on' : ''}}"
                data-route-id="{{item.id}}"
                bindtap="selectRoute"
              >
                <view class="route-swatch" style="background: {{item.colorHex}};"></view>
                <view class="route-switch-row-info">
                  <text class="route-switch-name">{{item.name}}</text>
                  <text class="route-switch-meta">{{item.climbType}} {{item.grade}}{{item.colorName ? ' · ' + item.colorName : ''}}</text>
                </view>
                <text wx:if="{{item.isSelected}}" class="route-switch-check">已选</text>
              </view>
            </view>
            <button
              id="route-switch-close"
              class="text-button route-switch-close"
              bindtap="closeRouteSwitch"
            >收起（不改当前线）</button>
          </block>

          <!-- 收起：短列表；超过 3 条时留下「全部 N 条」 -->
          <block wx:else>
            <view class="route-switch-chips">
              <view
                wx:for="{{routeSwitchRows}}"
                wx:key="id"
                id="route-switch-{{item.id}}"
                class="route-switch-chip {{item.isSelected ? 'route-switch-on' : ''}}"
                data-route-id="{{item.id}}"
                bindtap="selectRoute"
              >
                <view class="route-switch-dot" style="background: {{item.colorHex}};"></view>
                <text class="route-switch-chip-name">{{item.name}}</text>
                <text class="route-switch-chip-grade">{{item.grade}}</text>
                <text wx:if="{{item.isSelected}}" class="route-switch-check">已选</text>
              </view>
              <view
                wx:if="{{routeSwitchHasMore}}"
                id="route-switch-all"
                class="route-switch-all"
                bindtap="expandRouteSwitch"
              >{{routeSwitchMoreText}}</view>
            </view>
          </block>
        </view>

        <!-- 结果按钮：抱石完攀后收起；有未保存的把次时先重试那一把 -->
        <view class="result-footer">
          <block wx:if="{{routeCompleted}}">
            <view id="route-completed-panel" class="route-completed-panel">
              <text class="route-completed-title">已完攀</text>
              <text class="route-completed-hint">这条抱石线路已完攀，不再新增把次；把次与备注都保留在本机。</text>
              <text class="route-completed-hint">如需更正，在下方「点错了完攀？」中找到这一把，点「改为未完成」。</text>
            </view>
          </block>
          <block wx:elif="{{routeClosed}}">
            <view id="route-pending-panel" class="route-pending-panel">
              <text class="route-pending-title">完攀待确认</text>
              <text class="route-pending-hint">这一把的完攀还没保存：先在「待保存」行点「重试保存」。</text>
            </view>
          </block>
          <block wx:else>
            <text wx:if="{{resultLocked}}" id="result-locked-hint" class="result-lock-hint">{{resultLockHint}}</text>
            <button
              id="record-fail"
              class="result-button result-fail"
              data-result="fail"
              disabled="{{resultLocked}}"
              bindtap="recordAttempt"
            >未完成</button>
            <button
              id="record-send"
              class="result-button result-send"
              data-result="send"
              disabled="{{resultLocked}}"
              bindtap="recordAttempt"
            >完攀</button>
          </block>
        </view>

        <!--
          最近一把的撤回与恢复（T033）：结果按钮下方固定一段，写明当前场次、当前线路最新
          那一把的线路名、原序号与结果，并给出撤回动作。目标只认这一行带下来的原把次 ID
          与归属（bindtap 的 dataset），不看行下标、名称或当前可见行。
          撤回后这一行留在原处变成「已撤回」，撤回按钮的位置留空（行高由样式固定），
          因此刚才点过的坐标不会被另一把或相反动作接管；「恢复这一把」在下方独立一行，
          是另一个按钮，须有意点击。这条线还有未落盘的把次时整段收起。
        -->
        <view wx:if="{{recentAttempt}}" id="recent-attempt" class="recent-attempt">
          <view class="recent-attempt-head">
            <text class="recent-attempt-title">最近一把</text>
            <text class="recent-attempt-note">撤回只减本场一把</text>
          </view>
          <view class="recent-attempt-row">
            <view class="recent-attempt-info">
              <text id="recent-attempt-text" class="recent-attempt-text">{{recentAttempt.titleText}}</text>
              <text class="recent-attempt-meta">{{recentAttempt.metaText}}</text>
            </view>
            <button
              wx:if="{{recentAttempt.canUndo}}"
              id="undo-attempt-{{recentAttempt.attemptId}}"
              class="text-button recent-attempt-action"
              data-attempt-id="{{recentAttempt.attemptId}}"
              data-route-id="{{recentAttempt.routeId}}"
              data-session-id="{{recentAttempt.sessionId}}"
              data-expected="{{recentAttempt.expected}}"
              bindtap="undoLatestAttempt"
            >{{recentAttempt.undoText}}</button>
          </view>
          <text
            wx:if="{{recentAttempt.stateText}}"
            id="recent-attempt-state"
            class="recent-attempt-status"
          >{{recentAttempt.stateText}}</text>
          <view wx:if="{{recentAttempt.canRestore}}" class="recent-attempt-recovery">
            <button
              id="restore-attempt-{{recentAttempt.attemptId}}"
              class="secondary-button recent-attempt-restore"
              data-attempt-id="{{recentAttempt.attemptId}}"
              data-route-id="{{recentAttempt.routeId}}"
              data-session-id="{{recentAttempt.sessionId}}"
              data-expected="{{recentAttempt.expected}}"
              bindtap="restoreLatestAttempt"
            >{{recentAttempt.restoreText}}</button>
          </view>
          <text class="recent-attempt-hint">原把次的备注、照片与时间都保留；恢复后回到原来的位置。</text>
        </view>

        <!--
          当前线路主照片（T019）：保存必须由用户确认；取消预览不改动已保存照片，
          取消更换后仍显示原来的主图。同色线路与其他档案的照片各自独立。
        -->
        <view wx:if="{{routePhoto}}" id="route-photo-card" class="photo-card">
          <view class="photo-head">
            <text class="photo-title">线路照片</text>
            <text class="photo-note">只保存在本机</text>
          </view>

          <block wx:if="{{routePhoto.status === 'saved'}}">
            <image
              id="route-photo-thumb"
              class="photo-thumb"
              src="{{routePhoto.thumbnailPath}}"
              mode="aspectFit"
              data-route-id="{{selectedRoute.id}}"
              bindtap="previewRoutePhoto"
            />
            <text id="route-photo-status" class="photo-status">{{routePhoto.statusText}}</text>
            <text wx:if="{{routePhoto.bytesText}}" class="photo-meta">{{routePhoto.bytesText}}</text>
            <view class="photo-actions">
              <button
                id="route-photo-preview"
                class="secondary-button photo-action"
                data-route-id="{{selectedRoute.id}}"
                bindtap="previewRoutePhoto"
              >看大图</button>
              <button
                id="route-photo-remove"
                class="text-button photo-remove"
                data-route-id="{{selectedRoute.id}}"
                bindtap="removeRoutePhoto"
              >移除</button>
            </view>
            <button
              wx:if="{{!routePhoto.thumbnailAvailable}}"
              id="route-photo-rebuild-thumb"
              class="secondary-button photo-action"
              data-route-id="{{selectedRoute.id}}"
              bindtap="rebuildRoutePhoto"
            >重建缩略图</button>
          </block>

          <block wx:elif="{{routePhoto.status === 'preview'}}">
            <image
              id="route-photo-preview-image"
              class="photo-preview"
              src="{{routePhoto.previewPath}}"
              mode="aspectFit"
            />
            <text id="route-photo-preview-status" class="photo-status">{{routePhoto.statusText}}</text>
            <view class="photo-actions">
              <button
                id="route-photo-cancel"
                class="secondary-button photo-action"
                data-route-id="{{selectedRoute.id}}"
                bindtap="cancelRoutePhoto"
              >取消</button>
              <button
                id="route-photo-confirm"
                class="primary-button photo-action"
                data-route-id="{{selectedRoute.id}}"
                bindtap="confirmRoutePhoto"
              >确认保存</button>
            </view>
          </block>

          <block wx:elif="{{routePhoto.status === 'saving'}}">
            <image
              wx:if="{{routePhoto.mainPath}}"
              class="photo-thumb"
              src="{{routePhoto.mainPath}}"
              mode="aspectFit"
            />
            <text id="route-photo-saving" class="photo-status photo-status-busy">{{routePhoto.statusText}}</text>
            <text class="photo-hint">照片文件和关联都写入后才提示成功。</text>
          </block>

          <block wx:elif="{{routePhoto.status === 'failed'}}">
            <image
              wx:if="{{routePhoto.mainPath}}"
              class="photo-thumb"
              src="{{routePhoto.mainPath}}"
              mode="aspectFit"
              data-route-id="{{selectedRoute.id}}"
              bindtap="previewRoutePhoto"
            />
            <text id="route-photo-error" class="photo-status photo-status-error">{{routePhoto.statusText}}</text>
            <text class="photo-error-detail">{{routePhoto.errorText}}</text>
            <view class="photo-actions">
              <button
                id="route-photo-retry"
                class="secondary-button photo-action"
                data-route-id="{{selectedRoute.id}}"
                bindtap="retryRoutePhoto"
              >{{routePhoto.retryText}}</button>
              <button
                id="route-photo-dismiss"
                class="text-button photo-remove"
                data-route-id="{{selectedRoute.id}}"
                bindtap="dismissRoutePhotoFailure"
              >收起</button>
            </view>
            <button
              wx:if="{{routePhoto.manageSpaceVisible}}"
              id="route-photo-space-manage"
              class="secondary-button photo-action"
              bindtap="goToClearCache"
            >去「我的」清除可重建缓存</button>
          </block>

          <block wx:elif="{{routePhoto.status === 'missing'}}">
            <text id="route-photo-missing" class="photo-status photo-status-error">本机照片不可用，可重新添加</text>
            <text class="photo-hint">照片文件可能已被系统清理；重新添加会替换原关联，本场把次与备注不变。</text>
          </block>

          <block wx:elif="{{routePhoto.status === 'error'}}">
            <text id="route-photo-read-error" class="photo-status photo-status-error">{{routePhoto.statusText}}</text>
            <button
              id="route-photo-reload"
              class="secondary-button photo-action"
              data-route-id="{{selectedRoute.id}}"
              bindtap="reloadRoutePhoto"
            >重试读取</button>
          </block>

          <block wx:else>
            <text id="route-photo-loading" class="photo-status">{{routePhoto.statusText}}</text>
          </block>

          <view wx:if="{{routePhoto.sourceVisible}}" class="photo-source-row">
            <button
              id="route-photo-camera"
              class="secondary-button photo-source"
              data-source="camera"
              data-route-id="{{selectedRoute.id}}"
              bindtap="chooseRoutePhoto"
            >{{routePhoto.cameraText}}</button>
            <button
              id="route-photo-album"
              class="secondary-button photo-source"
              data-source="album"
              data-route-id="{{selectedRoute.id}}"
              bindtap="chooseRoutePhoto"
            >{{routePhoto.albumText}}</button>
          </view>
        </view>

        <view wx:if="{{noteEditor}}" id="note-editor" class="card note-editor">
          <text class="card-title">补备注</text>
          <text class="note-context">{{noteEditor.routeName}} · {{noteEditor.attemptLabel}} · {{noteEditor.resultText}}</text>
          <textarea
            id="note-input"
            class="note-input"
            value="{{noteEditor.text}}"
            placeholder="例如：抓到后向右摆"
            maxlength="120"
            bindinput="onNoteInput"
          ></textarea>
          <view class="button-row">
            <button class="secondary-button" bindtap="cancelNote">取消</button>
            <button id="save-note" class="primary-button" bindtap="saveNote">保存备注</button>
          </view>
        </view>

        <block wx:else>
          <view wx:if="{{!hasAttempts && !hasPending}}" class="empty-attempts">
            <text>还没有记录，从墙上下来后点一次结果。</text>
          </view>

          <view wx:for="{{attempts}}" wx:key="id" class="attempt-item">
            <view class="attempt-main">
              <text class="attempt-label">{{item.label}}</text>
              <text class="attempt-result">{{item.resultText}}</text>
              <text class="attempt-time">{{item.timeText}}</text>
            </view>
            <text wx:if="{{item.note}}" class="attempt-note">{{item.note}}</text>
            <button
              id="note-{{item.id}}"
              class="text-button attempt-note-button"
              data-attempt-id="{{item.id}}"
              bindtap="openNoteEditor"
            >{{item.hasNote ? '改备注' : '补备注'}}</button>
          </view>

          <!-- 待保存：这条操作未落盘，重试沿用同一操作 ID，只多出预期的一把 -->
          <view
            wx:for="{{pendingRows}}"
            wx:key="opId"
            id="pending-{{item.opId}}"
            class="attempt-item pending-attempt"
          >
            <view class="attempt-main">
              <text class="attempt-label">{{item.label || '待保存'}}</text>
              <text class="attempt-result">{{item.resultText}}</text>
            </view>
            <view class="pending-footer">
              <text class="pending-status">{{item.statusText}}</text>
              <button
                id="retry-{{item.opId}}"
                class="text-button pending-retry"
                data-op-id="{{item.opId}}"
                bindtap="retryPendingAttempt"
              >重试保存</button>
            </view>
          </view>
        </block>

        <!-- 按把「改为未完成」：每一把各占一行、各带自己的控件，写明日期/场次/第几把 -->
        <view wx:if="{{correctionRows.length > 0}}" id="route-correction" class="route-correction">
          <text class="route-correction-title">点错了完攀？</text>
          <text class="route-correction-hint">下面每一把各占一行：点哪一行就只改那一把，改另一把要再点它自己那一行。</text>
          <text wx:if="{{correctionStatusText}}" id="route-correction-status" class="route-correction-status">{{correctionStatusText}}</text>
          <view wx:for="{{correctionRows}}" wx:key="attemptId" class="route-correction-row">
            <text class="route-correction-target">改正原把次：{{item.label}} · {{item.contextText}}</text>
            <view class="route-correction-slot">
              <button
                wx:if="{{item.state !== 'corrected'}}"
                id="correct-{{item.attemptId}}"
                class="secondary-button route-correct-button"
                data-attempt-id="{{item.attemptId}}"
                data-route-id="{{item.routeId}}"
                data-session-id="{{item.sessionId}}"
                bindtap="correctSend"
              >{{item.buttonText}}</button>
              <text wx:else id="corrected-{{item.attemptId}}" class="route-corrected-text">{{item.statusText}}</text>
            </view>
          </view>
        </view>


      </view>

      <!--
        本次小结（T029）：离馆时按本场的原 sessionId 回看这一场爬了哪些线、共几把、
        哪些完攀，没爬完的线可以直接勾进本馆「下次想爬」。
        只算已提交把次：待保存、旧云汇总与自测成绩都不计入；打开本页不结束也不新建场次。
      -->
      <view id="session-summary" class="section session-summary">
        <text class="section-title">本次小结</text>

        <view wx:if="{{!summaryReady && summaryError}}" id="summary-error" class="summary-error-card">
          <text class="summary-error-text">{{summaryError}}</text>
          <text class="summary-error-hint">只读展示，原档案没有被改写。</text>
        </view>

        <block wx:else>
          <view class="summary-head">
            <text id="summary-count" class="summary-count">{{summaryCountText}}</text>
            <text wx:if="{{summarySendText}}" id="summary-send" class="summary-send">{{summarySendText}}</text>
          </view>

          <!--
            只读回看入口（T029）：直接选要看哪一场的小结（日期 · 岩馆 · 第 N 场），
            不必手工拼 ?sessionId=。选择只换所看的小结，不改正在记录的当前场次、
            不新建场次、不写训练；放在结果按钮下方的小结区里，不占上方首屏。
          -->
          <view
            wx:if="{{summarySessionPickerVisible}}"
            id="summary-session-picker"
            class="summary-session-picker"
          >
            <text class="summary-session-title">回看场次（只读）</text>
            <picker
              mode="selector"
              range="{{summarySessionOptions}}"
              range-key="label"
              value="{{summarySessionIndex}}"
              bindchange="onSummarySessionChange"
            >
              <view id="summary-session-value" class="summary-session-value">
                <text class="summary-session-value-text">{{summarySessionValue}}</text>
                <text class="summary-session-arrow">切换 ›</text>
              </view>
            </picker>
            <text class="summary-session-hint">只切换看哪一场小结：当前场次与正在记录的线路都不变。</text>
          </view>

          <text wx:if="{{summaryViewingOther}}" id="summary-other" class="summary-other">
            正在回看 {{summaryLabel}}（{{summaryGymName}} · {{summaryDate}}）；当前场次不变。
          </text>
          <text wx:if="{{summaryPendingText}}" id="summary-pending" class="summary-pending">{{summaryPendingText}}</text>
          <text wx:if="{{summaryWishlistError}}" id="summary-wishlist-error" class="summary-error-text">{{summaryWishlistError}}</text>

          <view wx:if="{{summaryEmpty}}" id="summary-empty" class="empty-attempts">
            <text>本场还没有已保存的把次；记完一把再回来看小结。</text>
          </view>
          <block wx:else>
            <text class="summary-hint">{{summaryHintText}}</text>
            <view
              wx:for="{{summaryRows}}"
              wx:key="routeId"
              id="summary-row-{{item.routeId}}"
              class="summary-row"
            >
              <view class="summary-row-main">
                <view class="route-swatch" style="background: {{item.colorHex}};"></view>
                <view class="summary-row-info">
                  <view class="summary-row-head">
                    <text class="summary-name">{{item.name}}</text>
                    <text class="summary-grade">{{item.grade}}</text>
                    <text
                      wx:if="{{item.stateText}}"
                      id="summary-state-{{item.routeId}}"
                      class="summary-state {{item.completed ? 'summary-state-done' : 'summary-state-sent'}}"
                    >{{item.stateText}}</text>
                  </view>
                  <text class="summary-meta">{{item.climbType}}{{item.colorName ? ' · ' + item.colorName : ''}} · 本场 {{item.attemptCountText}}{{item.sendCount > 0 ? ' · 完攀 ' + item.sendCount + ' 把' : ''}}</text>
                  <text wx:if="{{item.hasNote}}" class="summary-note">最近备注：{{item.latestNote}}</text>
                </view>
              </view>
              <view class="summary-actions">
                <button
                  wx:if="{{item.pickable}}"
                  id="summary-pick-{{item.routeId}}"
                  class="secondary-button summary-pick {{item.checked ? 'summary-pick-on' : ''}}"
                  disabled="{{!item.canPick}}"
                  data-route-id="{{item.routeId}}"
                  bindtap="toggleSummaryPick"
                >{{item.pickText}}</button>
                <text
                  wx:if="{{item.wishlistStateText}}"
                  id="summary-pick-state-{{item.routeId}}"
                  class="summary-pick-state"
                >{{item.wishlistStateText}}</text>
                <button
                  id="summary-open-{{item.routeId}}"
                  class="text-button summary-open"
                  data-route-id="{{item.routeId}}"
                  bindtap="openSummaryRoute"
                >回看原线 ›</button>
              </view>
            </view>
          </block>
        </block>
      </view>

      <!--
        下次想爬（T027）：本馆收藏过的长期线路按想爬 / 已完成 / 已归档排在这里，
        带照片或无图状态、累计把数与最近一条非空备注；点「续记」就是在原线的同一个
        线路 ID 上继续记，点「回看」回到线路详情看照片、把次与历史。
        加入、撤下与拆线归档只改清单这一份独立记录，不动线路、照片与把次。
      -->
      <view id="wishlist-section" class="section wishlist-section">
        <text class="section-title">下次想爬 · {{activeSession.gymName}}</text>

        <view wx:if="{{wishlistError}}" id="wishlist-error" class="wishlist-error-card">
          <text class="wishlist-error-text">{{wishlistError}}</text>
          <text class="wishlist-error-hint">原清单保持原样；本场记录与照片不受影响。</text>
        </view>

        <block wx:else>
          <!-- 当前线路的加入 / 撤下 / 拆线归档入口 -->
          <view wx:if="{{selectedWishlist}}" id="selected-wishlist" class="wishlist-card">
            <view class="wishlist-head">
              <text class="wishlist-title">{{selectedRoute.name}}</text>
              <text
                wx:if="{{selectedWishlist.statusText}}"
                id="selected-wishlist-state"
                class="wishlist-state wishlist-state-{{selectedWishlist.status}}"
              >{{selectedWishlist.statusText}}</text>
            </view>
            <text id="selected-wishlist-text" class="wishlist-state-text">{{selectedWishlist.stateText}}</text>
            <text wx:if="{{selectedWishlist.error}}" id="selected-wishlist-error" class="wishlist-error">{{selectedWishlist.error}}</text>
            <text wx:else class="wishlist-hint">{{selectedWishlist.hintText}}</text>
            <view wx:if="{{!selectedWishlist.error}}" class="wishlist-actions">
              <button
                wx:if="{{selectedWishlist.canAdd}}"
                id="wishlist-add-selected"
                class="secondary-button wishlist-action"
                bindtap="addSelectedToWishlist"
              >{{selectedWishlist.inList ? '重新加入下次想爬' : '加入下次想爬'}}</button>
              <button
                wx:if="{{selectedWishlist.canArchive}}"
                id="wishlist-archive-selected"
                class="text-button wishlist-archive"
                bindtap="archiveSelectedWishlist"
              >拆线归档</button>
              <button
                wx:if="{{selectedWishlist.canRemove}}"
                id="wishlist-remove-selected"
                class="text-button wishlist-remove"
                bindtap="removeSelectedFromWishlist"
              >撤下收藏</button>
            </view>
          </view>

          <view wx:if="{{!hasWishlist}}" id="wishlist-empty" class="empty-attempts">
            <text>本馆还没有想爬的线。从上一条线路加入清单后，下次进馆就能直接找到原线。</text>
          </view>
          <block wx:else>
            <text id="wishlist-count" class="wishlist-count">{{wishlistCountText}}</text>

            <!-- 想爬：点开就是在同一条长期线路 ID 上继续记 -->
            <view wx:if="{{wishlistWanted.length > 0}}" class="wishlist-group">
              <text class="wishlist-group-title">想爬</text>
              <view
                wx:for="{{wishlistWanted}}"
                wx:key="routeId"
                id="wishlist-row-{{item.routeId}}"
                class="wishlist-row"
                data-route-id="{{item.routeId}}"
                bindtap="continueWishlistRoute"
              >
                <image wx:if="{{item.hasPhoto}}" class="wishlist-thumb" src="{{item.thumbnailPath}}" mode="aspectFill" />
                <view wx:else class="wishlist-thumb wishlist-thumb-empty">
                  <text>{{item.photoStatusText}}</text>
                </view>
                <view class="wishlist-row-info">
                  <view class="wishlist-row-head">
                    <view class="route-swatch" style="background: {{item.colorHex}};"></view>
                    <text class="wishlist-name">{{item.name}}</text>
                    <text class="wishlist-grade">{{item.grade}}</text>
                  </view>
                  <text class="wishlist-meta">{{item.climbType}}{{item.colorName ? ' · ' + item.colorName : ''}} · 累计 {{item.attemptCountText}}</text>
                  <text wx:if="{{item.hasNote}}" class="wishlist-note">最近备注：{{item.latestNote}}</text>
                  <text wx:else class="wishlist-note wishlist-note-empty">还没有备注</text>
                </view>
                <text class="wishlist-open">续记 ›</text>
              </view>
            </view>

            <!-- 已完成：关注的抱石首次完攀；改成未完成后会回到想爬 -->
            <view wx:if="{{wishlistCompleted.length > 0}}" class="wishlist-group">
              <text class="wishlist-group-title">已完成</text>
              <view
                wx:for="{{wishlistCompleted}}"
                wx:key="routeId"
                id="wishlist-done-{{item.routeId}}"
                class="wishlist-row wishlist-row-done"
                data-route-id="{{item.routeId}}"
                bindtap="openWishlistRoute"
              >
                <image wx:if="{{item.hasPhoto}}" class="wishlist-thumb" src="{{item.thumbnailPath}}" mode="aspectFill" />
                <view wx:else class="wishlist-thumb wishlist-thumb-empty">
                  <text>{{item.photoStatusText}}</text>
                </view>
                <view class="wishlist-row-info">
                  <view class="wishlist-row-head">
                    <view class="route-swatch" style="background: {{item.colorHex}};"></view>
                    <text class="wishlist-name">{{item.name}}</text>
                    <text class="wishlist-grade">{{item.grade}}</text>
                  </view>
                  <text class="wishlist-meta">{{item.climbType}}{{item.colorName ? ' · ' + item.colorName : ''}} · 累计 {{item.attemptCountText}}</text>
                  <text class="wishlist-note">已完攀；把那一把改成未完成后回到想爬</text>
                </view>
                <text class="wishlist-open">回看 ›</text>
              </view>
            </view>

            <!-- 已归档：岩馆拆线；照片、把次与历史都保留 -->
            <view wx:if="{{wishlistArchived.length > 0}}" class="wishlist-group">
              <text class="wishlist-group-title">已归档（岩馆拆线）</text>
              <view
                wx:for="{{wishlistArchived}}"
                wx:key="routeId"
                id="wishlist-archived-{{item.routeId}}"
                class="wishlist-row wishlist-row-archived"
                data-route-id="{{item.routeId}}"
                bindtap="openWishlistRoute"
              >
                <image wx:if="{{item.hasPhoto}}" class="wishlist-thumb" src="{{item.thumbnailPath}}" mode="aspectFill" />
                <view wx:else class="wishlist-thumb wishlist-thumb-empty">
                  <text>{{item.photoStatusText}}</text>
                </view>
                <view class="wishlist-row-info">
                  <view class="wishlist-row-head">
                    <view class="route-swatch" style="background: {{item.colorHex}};"></view>
                    <text class="wishlist-name">{{item.name}}</text>
                    <text class="wishlist-grade">{{item.grade}}</text>
                  </view>
                  <text class="wishlist-meta">{{item.climbType}}{{item.colorName ? ' · ' + item.colorName : ''}} · 累计 {{item.attemptCountText}}</text>
                  <text class="wishlist-note">已从活跃清单归档；照片、把次与历史都保留</text>
                </view>
                <text class="wishlist-open">回看 ›</text>
              </view>
            </view>
          </block>
        </block>
      </view>

      <!--
        选线路与新建线路的入口已按 T030 移到首屏的「本场线路」区（见上方 session-routes）：
        这里不再保留第二份列表与第二份新建表单，避免同一入口有两份状态。
      -->
    </block>
  </block>
</view>
