/**
 * 下次想爬独立清单页样式（T035）
 *
 * 与场内页、本次小结同一套配色与排版（墨绿主色 #173d32、橙 #ff793f、粉笔白 #fffcf3），
 * 只保留这一页真正用到的规则：分组标题、线路行（色标 + 状态 + 累计把数 + 最近备注）、
 * 空态与失败重试。触控目标按至少 88rpx（≈44px 逻辑像素）留。
 */

.page {
  padding: 20rpx 32rpx 55rpx;
}

.card {
  background-color: #fffcf3;
  border-radius: 8rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

/* 标题与总览 */
.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  border-bottom: 2rpx solid #173d32;
  padding-bottom: 14rpx;
}

.list-title {
  font-family: "Songti SC", "Noto Serif CJK SC", "SimSun", serif;
  font-weight: 700;
  font-size: 39rpx;
  line-height: 1.35;
  color: #173d32;
}

.list-total {
  flex: none;
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
  color: #606d61;
}

.list-hint,
.empty-text,
.empty-hint,
.error-text,
.error-hint,
.error-title {
  display: block;
}

.list-hint {
  margin: 16rpx 0 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #526157;
}

/* 空态：还没有收藏过 */
.empty-list {
  padding: 40rpx 0 24rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #173d32;
}

.empty-hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #606d61;
}

/* 失败与重试 */
.error-card {
  background-color: #f7e6db;
}

.error-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #943a23;
  margin-bottom: 12rpx;
}

.error-text {
  font-size: 26rpx;
  color: #813323;
  margin-bottom: 10rpx;
}

.error-hint {
  font-size: 24rpx;
  color: #745241;
  margin-bottom: 16rpx;
}

/* 按钮 */
.secondary-button {
  background-color: #fffcf3;
  color: #173d32;
  border: 2rpx solid #173d32;
  border-radius: 8rpx;
  font-size: 28rpx;
  min-height: 88rpx;
  padding: 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
}

.secondary-button::after {
  border: none;
}

/* 按岩馆分组 */
.gym-group {
  background: #fffcf3;
  border-radius: 8rpx;
  padding: 22rpx 24rpx;
  margin-top: 16rpx;
}

.gym-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  border-bottom: 1px solid #dfe0d2;
  padding-bottom: 12rpx;
}

.gym-name {
  font-family: "Songti SC", "Noto Serif CJK SC", "SimSun", serif;
  font-weight: 700;
  font-size: 30rpx;
  color: #173d32;
}

.gym-count {
  flex: none;
  font-size: 24rpx;
  color: #606d61;
}

/* 线路行：整行可点，按原线路 ID 进资料 */
.route-row {
  display: flex;
  align-items: flex-start;
  min-height: 88rpx;
  padding: 18rpx 0;
  border-bottom: 1px solid #f2efe2;
}

.route-row:last-child {
  border-bottom: 0;
  padding-bottom: 4rpx;
}

.route-swatch {
  flex: none;
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  border: 2rpx solid #e0e0e0;
  margin: 6rpx 16rpx 0 0;
}

.route-info {
  flex: 1;
  min-width: 0;
}

.route-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
}

.route-name {
  font-size: 29rpx;
  font-weight: 700;
  color: #173d32;
  word-break: break-all;
}

.route-grade {
  flex: none;
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
  color: #ff793f;
}

/* 状态一律配文字：想爬 / 已完成 / 已归档（岩馆拆线） */
.route-state {
  flex: none;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #e4ebdf;
  color: #355e50;
}

.route-state-completed {
  background: #dfebd9;
  color: #204b34;
}

.route-state-archived {
  background: #ede6d7;
  color: #674b39;
}

.route-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #606d61;
}

.route-note {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #526157;
  border-left: 4rpx solid #d2784f;
  padding-left: 14rpx;
  line-height: 1.5;
  word-break: break-all;
}

.route-note-empty {
  border-left-color: #cbd0bf;
  color: #7a8578;
}

.route-open {
  flex: none;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #173d32;
}

.back-section {
  margin-top: 24rpx;
}
