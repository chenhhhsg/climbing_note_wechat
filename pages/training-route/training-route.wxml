<!--
  正式长期线路详情页（T018）
  按长期线路 ID 回看跨日、跨场次的逐把结果与备注；打开只读，只有「当天再记」与
  按把「改为未完成」会在本机档案上写，且都由用户明确点按触发。
-->
<view class="page">
  <!-- 本机档案损坏或版本不支持：显示可见错误，保留原数据 -->
  <view wx:if="{{loadError}}" id="load-error" class="card error-card">
    <text class="error-title">本机训练档案读取失败</text>
    <text class="error-text">{{loadError}}</text>
    <text class="error-hint">原档案保持原样，没有被改写。</text>
    <button id="retry-load" class="secondary-button" bindtap="retryLoad">重试读取</button>
  </view>

  <block wx:else>
    <view
      wx:if="{{storageError}}"
      id="storage-error"
      class="storage-error"
      bindtap="dismissStorageError"
    >
      <text class="storage-error-text">{{storageError}}</text>
      <text class="storage-error-hint">当前操作未生效，可重试；点击收起</text>
    </view>

    <view wx:if="{{notice}}" id="notice" class="notice" bindtap="dismissNotice">
      <text class="notice-text">{{notice}}</text>
      <text class="notice-hint">点击收起</text>
    </view>

    <!-- 这条线路不在本机档案里：不猜、不建 -->
    <view wx:if="{{notFound}}" id="not-found" class="card empty-card">
      <text class="empty-title">找不到这条线路</text>
      <text class="empty-hint">本机档案里没有这条长期线路，可能来自旧云记录；旧记录请从「旧记录」入口按原 ID 回看。</text>
    </view>

    <block wx:elif="{{route}}">
      <view id="route-header" class="card route-header">
        <view class="route-title-row">
          <view class="route-swatch" style="background: {{route.colorHex}};"></view>
          <view class="route-title-info">
            <text class="route-name">{{route.name}}</text>
            <text class="route-meta">{{route.climbType}} {{route.grade}}{{route.colorName ? ' · ' + route.colorName : ''}}</text>
            <text class="route-gym">{{route.gymName}}</text>
          </view>
          <text
            wx:if="{{routeStateText}}"
            id="route-state"
            class="route-state {{routeCompleted ? 'route-state-done' : 'route-state-pending'}}"
          >{{routeStateText}}</text>
        </view>
        <text id="route-summary" class="route-summary">{{summaryText}} · {{sendCount}} 次完攀</text>
      </view>

      <!-- 回看：按本地日期与场次分组，同一天多场各自保留原归属 -->
      <view class="section">
        <text class="section-title">本机逐把记录</text>

        <view wx:if="{{!hasAttempts}}" id="history-empty" class="empty-attempts">
          <text>这条线路在本机还没有逐把记录。点「当天再记」回场内页记第一把。</text>
        </view>

        <view wx:else>
          <view
            wx:for="{{groups}}"
            wx:key="sessionId"
            id="history-group-{{item.sessionId}}"
            class="history-group"
          >
            <view class="history-group-head">
              <text class="history-date">{{item.dateText}}</text>
              <text class="history-session">{{item.sessionLabel}} · {{item.gymName}}</text>
              <text class="history-count">{{item.countText}}</text>
            </view>
            <view wx:for="{{item.attempts}}" wx:for-item="attempt" wx:key="id" id="attempt-{{attempt.id}}" class="attempt-item">
              <view class="attempt-main">
                <text class="attempt-label">{{attempt.label}}</text>
                <text class="attempt-result {{attempt.isSend ? 'result-send' : 'result-fail'}}">{{attempt.resultText}}</text>
                <text class="attempt-time">{{attempt.timeText}}</text>
              </view>
              <text wx:if="{{attempt.hasNote}}" class="attempt-note">{{attempt.note}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 按把「改为未完成」：每一把各占一行、各带自己的控件，写明日期/场次/第几把 -->
      <view wx:if="{{correctionRows.length > 0}}" id="route-correction" class="route-correction">
        <text class="route-correction-title">点错了完攀？</text>
        <text class="route-correction-hint">下面每一把各占一行：点哪一行就只改那一把，改另一把要再点它自己那一行。</text>
        <text wx:if="{{correctionStatusText}}" id="route-correction-status" class="route-correction-status">{{correctionStatusText}}</text>
        <view wx:for="{{correctionRows}}" wx:key="attemptId" class="route-correction-row">
          <text class="route-correction-target">改正原把次：{{item.label}} · {{item.contextText}}</text>
          <view class="route-correction-slot">
            <button
              wx:if="{{item.state !== 'corrected'}}"
              id="correct-{{item.attemptId}}"
              class="secondary-button route-correct-button"
              data-attempt-id="{{item.attemptId}}"
              data-route-id="{{item.routeId}}"
              data-session-id="{{item.sessionId}}"
              bindtap="correctSend"
            >{{item.buttonText}}</button>
            <text wx:else id="corrected-{{item.attemptId}}" class="route-corrected-text">{{item.statusText}}</text>
          </view>
        </view>
      </view>

      <!-- 当天再记：只有用户点这一下才可能新建当日场次 -->
      <view class="record-again-footer">
        <block wx:if="{{canRecordAgain}}">
          <button id="record-again" class="primary-button" bindtap="recordAgain">当天再记</button>
          <text class="record-again-hint">回场内页在这条线上继续记：当日该岩馆已有场次就直接用，当日多场会先让你选一场。</text>
        </block>
        <block wx:else>
          <view id="route-closed-panel" class="route-completed-panel">
            <text class="route-completed-title">{{routeStateText || '暂不能新增把次'}}</text>
            <text class="route-completed-hint">这条抱石线路已完攀，不再新增把次；把次与备注都保留在本机。</text>
            <text class="route-completed-hint">点错了完攀？在上方「点错了完攀？」里点那一把自己那行改成未完成。</text>
          </view>
        </block>
      </view>

      <!-- 同日多场：先让用户明确选一场，取消不改归属 -->
      <view wx:if="{{sessionPicker}}" id="session-picker" class="card session-picker">
        <text class="card-title">当天再记：选一场</text>
        <text class="session-picker-meta">{{sessionPicker.dateText}} · {{sessionPicker.gymName}} · {{sessionPicker.routeName}}</text>
        <view
          wx:for="{{sessionPicker.sessions}}"
          wx:key="id"
          id="choose-session-{{item.id}}"
          class="session-option"
          data-session-id="{{item.id}}"
          bindtap="chooseSessionForAgain"
        >{{item.label}}{{item.isCurrent ? '（当前场次）' : ''}}</view>
        <button id="cancel-session-picker" class="text-button" bindtap="cancelSessionPicker">取消</button>
      </view>
    </block>
  </block>
</view>
