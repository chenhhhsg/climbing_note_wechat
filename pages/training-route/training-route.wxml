<!--
  正式长期线路详情页（T018 回看 / T019 主照片 / T040 照片入口）
  按长期线路 ID 回看跨日、跨场次的逐把结果与备注；打开只读，只有「当天再记」、按把
  「改为未完成」与没有照片时的添加确认会在本机写，且都由用户明确点按触发。
  有照片时本页只展示可点击缩略图与「照片动作标记 · N 个」；大图、换图、移除与标记的
  新增/移动/改字/删除都在二级页 pages/training-photo-marks，本页不铺第二套编辑。
  T023：跨日历史每一把还有视频关联状态与文字入口，选片在视频页，本页不碰视频文件。
  T039：完攀更正入口只在原场次那一把旁边，确认后才改这一把；不再另设独立更正区。
-->
<view class="page">
  <!-- 本机档案损坏或版本不支持：显示可见错误，保留原数据 -->
  <view wx:if="{{loadError}}" id="load-error" class="card error-card">
    <text class="error-title">本机训练档案读取失败</text>
    <text class="error-text">{{loadError}}</text>
    <text class="error-hint">原档案保持原样，没有被改写。</text>
    <button id="retry-load" class="secondary-button" bindtap="retryLoad">重试读取</button>
  </view>

  <block wx:else>
    <view
      wx:if="{{storageError}}"
      id="storage-error"
      class="storage-error"
      bindtap="dismissStorageError"
    >
      <text class="storage-error-text">{{storageError}}</text>
      <text class="storage-error-hint">当前操作未生效，可重试；点击收起</text>
    </view>

    <view wx:if="{{notice}}" id="notice" class="notice" bindtap="dismissNotice">
      <text class="notice-text">{{notice}}</text>
      <text class="notice-hint">点击收起</text>
    </view>

    <view
      wx:if="{{photoNotice}}"
      id="photo-notice"
      class="notice"
      bindtap="dismissPhotoNotice"
    >
      <text class="notice-text">{{photoNotice}}</text>
      <text class="notice-hint">点击收起</text>
    </view>

    <!--
      入口归属不符（T037）：这一下是另一份本机档案渲染时留下的入口，本档里同名的
      routeId 不能顶替它。只显示原因与返回路径，不展示任何线路内容，也不受理写入。
    -->
    <view wx:if="{{claimError}}" id="claim-error" class="card error-card">
      <text class="error-title">这个入口不属于现在的本机档案</text>
      <text id="claim-error-text" class="error-text">{{claimError}}</text>
      <text class="error-hint">原档案与照片都没有被改写；请从当前的场内页重新打开这条线。</text>
      <button id="claim-back" class="secondary-button" bindtap="backToList">返回本场线路</button>
    </view>

    <!-- 这条线路不在本机档案里：不猜、不建 -->
    <view wx:elif="{{notFound}}" id="not-found" class="card empty-card">
      <text class="empty-title">找不到这条线路</text>
      <text class="empty-hint">本机档案里没有这条长期线路，可能来自旧云记录；旧记录请从「旧记录」入口按原 ID 回看。</text>
    </view>

    <block wx:elif="{{route}}">
      <view id="route-header" class="card route-header">
        <view class="route-title-row">
          <view class="route-swatch" style="background: {{route.colorHex}};"></view>
          <view class="route-title-info">
            <text class="route-grade-display">{{route.grade}}</text>
            <text class="route-name">{{route.name}}</text>
            <text class="route-meta">{{route.climbType}}{{route.colorName ? ' · ' + route.colorName : ''}}</text>
            <text class="route-gym">{{route.gymName}}</text>
          </view>
          <text
            wx:if="{{routeStateText}}"
            id="route-state"
            class="route-state {{routeCompleted ? 'route-state-done' : 'route-state-pending'}}"
          >{{routeStateText}}</text>
        </view>
        <text id="route-summary" class="route-summary">{{summaryText}} · {{sendCount}} 次完攀</text>
      </view>

      <!--
        下次想爬（T027）：加入、撤下与拆线归档都只改清单这一份独立记录，
        线路、照片、把次与备注都不动；拆线归档后仍可按原线路 ID 回看。
      -->
      <view wx:if="{{wishlistState}}" id="wishlist-card" class="card wishlist-card">
        <view class="wishlist-head">
          <text class="wishlist-title">下次想爬</text>
          <text
            wx:if="{{wishlistState.statusText}}"
            id="wishlist-state"
            class="wishlist-state wishlist-state-{{wishlistState.status}}"
          >{{wishlistState.statusText}}</text>
        </view>
        <text id="wishlist-state-text" class="wishlist-state-text">{{wishlistState.stateText}}</text>
        <text wx:if="{{wishlistState.error}}" id="wishlist-error" class="wishlist-error">{{wishlistState.error}}</text>
        <text wx:else class="wishlist-hint">{{wishlistState.hintText}}</text>
        <view wx:if="{{!wishlistState.error}}" class="wishlist-actions">
          <button
            wx:if="{{wishlistState.canAdd}}"
            id="wishlist-add"
            class="secondary-button wishlist-action"
            bindtap="addToWishlist"
          >{{wishlistState.inList ? '重新加入下次想爬' : '加入下次想爬'}}</button>
          <button
            wx:if="{{wishlistState.canArchive}}"
            id="wishlist-archive"
            class="text-button wishlist-archive"
            bindtap="archiveWishlistItem"
          >拆线归档</button>
          <button
            wx:if="{{wishlistState.canRemove}}"
            id="wishlist-remove"
            class="text-button wishlist-remove"
            bindtap="removeFromWishlist"
          >撤下收藏</button>
        </view>
      </view>

      <!--
        线路主照片（T019）：保存必须由用户确认；取消预览不改动已保存照片，
        取消更换后仍显示原来的主图。照片只在本机保存一份。
      -->
      <view wx:if="{{routePhoto}}" id="route-photo-card" class="card photo-card">
        <view class="photo-head">
          <text class="photo-title">线路照片</text>
          <text class="photo-note">只保存在本机</text>
        </view>

        <!--
          T040：有照片时历史只展示可点击缩略图与当前照片版本的标记数量。
          大图、换图、移除与标记编辑都在二级页；缩略图入口带着渲染这一刻的档案、
          线路与照片 ID，照片已变化时二级页会按最新版本核对，不落到另一张图上。
        -->
        <block wx:if="{{routePhoto.status === 'saved'}}">
          <view
            id="route-photo-thumb-link"
            class="photo-thumb-link"
            data-archive-id="{{archiveId}}"
            data-route-id="{{route.id}}"
            data-photo-id="{{routePhoto.photoId}}"
            bindtap="openPhotoMarks"
          >
            <image
              id="route-photo-thumb"
              class="photo-thumb photo-thumb-tap"
              src="{{routePhoto.thumbnailPath}}"
              mode="aspectFill"
            />
            <text class="photo-hint">点缩略图进入大图标记</text>
          </view>
          <text id="route-photo-status" class="photo-status">{{routePhoto.statusText}}</text>
          <text wx:if="{{routePhoto.bytesText}}" class="photo-meta">{{routePhoto.bytesText}}</text>
          <button
            id="photo-marks-entry"
            class="secondary-button photo-marks-entry"
            data-archive-id="{{archiveId}}"
            data-route-id="{{route.id}}"
            data-photo-id="{{routePhoto.photoId}}"
            bindtap="openPhotoMarks"
          >{{photoMarkCountText || '照片动作标记'}}</button>
          <text wx:if="{{photoMarksError}}" id="photo-marks-error" class="photo-error-detail">{{photoMarksError}}</text>
          <button
            wx:if="{{!routePhoto.thumbnailAvailable}}"
            id="route-photo-rebuild-thumb"
            class="secondary-button photo-action"
            data-route-id="{{route.id}}"
            bindtap="rebuildRoutePhoto"
          >重建缩略图</button>
        </block>

        <block wx:elif="{{routePhoto.status === 'preview'}}">
          <image
            id="route-photo-preview-image"
            class="photo-preview"
            src="{{routePhoto.previewPath}}"
            mode="aspectFit"
          />
          <text id="route-photo-preview-status" class="photo-status">{{routePhoto.statusText}}</text>
          <view class="photo-actions">
            <button
              id="route-photo-cancel"
              class="secondary-button photo-action"
              data-route-id="{{route.id}}"
              bindtap="cancelRoutePhoto"
            >取消</button>
            <button
              id="route-photo-confirm"
              class="primary-button photo-action"
              data-route-id="{{route.id}}"
              bindtap="confirmRoutePhoto"
            >确认保存</button>
          </view>
        </block>

        <block wx:elif="{{routePhoto.status === 'saving'}}">
          <image
            wx:if="{{routePhoto.mainPath}}"
            class="photo-thumb"
            src="{{routePhoto.mainPath}}"
            mode="aspectFit"
          />
          <text id="route-photo-saving" class="photo-status photo-status-busy">{{routePhoto.statusText}}</text>
          <text class="photo-hint">照片文件和关联都写入后才提示成功。</text>
        </block>

        <block wx:elif="{{routePhoto.status === 'failed'}}">
          <image
            wx:if="{{routePhoto.mainPath}}"
            class="photo-thumb"
            src="{{routePhoto.mainPath}}"
            mode="aspectFit"
            data-route-id="{{route.id}}"
            bindtap="previewRoutePhoto"
          />
          <text id="route-photo-error" class="photo-status photo-status-error">{{routePhoto.statusText}}</text>
          <text class="photo-error-detail">{{routePhoto.errorText}}</text>
          <view class="photo-actions">
            <button
              id="route-photo-retry"
              class="secondary-button photo-action"
              data-route-id="{{route.id}}"
              bindtap="retryRoutePhoto"
            >{{routePhoto.retryText}}</button>
            <button
              id="route-photo-dismiss"
              class="text-button photo-remove"
              data-route-id="{{route.id}}"
              bindtap="dismissRoutePhotoFailure"
            >收起</button>
          </view>
          <button
            wx:if="{{routePhoto.manageSpaceVisible}}"
            id="route-photo-space-manage"
            class="secondary-button photo-action"
            bindtap="goToClearCache"
          >去「我的」清除可重建缓存</button>
        </block>

        <block wx:elif="{{routePhoto.status === 'missing'}}">
          <text id="route-photo-missing" class="photo-status photo-status-error">本机照片不可用，可重新添加</text>
          <text class="photo-hint">照片文件可能已被系统清理；重新添加会替换原关联，历史尝试与备注不变。</text>
          <!-- 图暂不可用时仍可进入大图页读回该版本已写的提示文字 -->
          <button
            wx:if="{{routePhoto.photoId}}"
            id="photo-marks-entry"
            class="secondary-button photo-marks-entry"
            data-archive-id="{{archiveId}}"
            data-route-id="{{route.id}}"
            data-photo-id="{{routePhoto.photoId}}"
            bindtap="openPhotoMarks"
          >{{photoMarkCountText || '照片动作标记'}}</button>
          <text wx:if="{{photoMarksError}}" id="photo-marks-error" class="photo-error-detail">{{photoMarksError}}</text>
        </block>

        <block wx:elif="{{routePhoto.status === 'error'}}">
          <text id="route-photo-read-error" class="photo-status photo-status-error">{{routePhoto.statusText}}</text>
          <button
            id="route-photo-reload"
            class="secondary-button photo-action"
            data-route-id="{{route.id}}"
            bindtap="reloadRoutePhoto"
          >重试读取</button>
        </block>

        <block wx:else>
          <text id="route-photo-loading" class="photo-status">{{routePhoto.statusText}}</text>
        </block>

        <!-- T040：有照片时的换图与移除入口在大图二级页；这里只保留没有照片时的添加入口。 -->
        <view wx:if="{{routePhoto.sourceVisible && !routePhoto.hasPhoto}}" class="photo-source-row">
          <button
            id="route-photo-camera"
            class="secondary-button photo-source"
            data-source="camera"
            data-route-id="{{route.id}}"
            bindtap="chooseRoutePhoto"
          >{{routePhoto.cameraText}}</button>
          <button
            id="route-photo-album"
            class="secondary-button photo-source"
            data-source="album"
            data-route-id="{{route.id}}"
            bindtap="chooseRoutePhoto"
          >{{routePhoto.albumText}}</button>
        </view>
      </view>


      <!-- 回看：按本地日期与场次分组，同一天多场各自保留原归属 -->
      <view class="section">
        <text class="section-title">本机逐把记录</text>

        <view wx:if="{{!hasAttempts}}" id="history-empty" class="empty-attempts">
          <text>这条线路在本机还没有逐把记录。点「当天再记」进单线记录记第一把。</text>
        </view>

        <view wx:else>
          <view
            wx:for="{{groups}}"
            wx:key="sessionId"
            id="history-group-{{item.sessionId}}"
            class="history-group"
          >
            <!--
              分组标题即回到那一条记录（T036）：按这一组渲染时的原 sessionId 与当前长期
              routeId 打开单线记录；同日两场各自保留原归属，不会并到别的场次。
            -->
            <view
              class="history-group-head history-group-open"
              data-session-id="{{item.sessionId}}"
              data-route-id="{{route.id}}"
              bindtap="openRecordFromHistory"
            >
              <text class="history-date">{{item.dateText}}</text>
              <text class="history-session">{{item.sessionLabel}} · {{item.gymName}}</text>
              <text class="history-count">{{item.countText}}</text>
              <text class="history-open-hint">回到这一场记录 ›</text>
            </view>
            <view wx:for="{{item.attempts}}" wx:for-item="attempt" wx:key="id" id="attempt-{{attempt.id}}" class="attempt-item">
              <view class="attempt-main">
                <text class="attempt-label">{{attempt.label}}</text>
                <text class="attempt-result {{attempt.isSend ? 'result-send' : 'result-fail'}}">{{attempt.resultText}}</text>
                <text class="attempt-time">{{attempt.timeText}}</text>
              </view>
              <text wx:if="{{attempt.hasNote}}" class="attempt-note">{{attempt.note}}</text>
              <!-- 逐把视频（T023）：关联状态与文字入口；按这一组的原场次与这一把的原 ID 进入 -->
              <view class="history-attempt-video">
                <text id="video-state-{{attempt.id}}" class="history-attempt-video-state">{{attempt.videoStateText}}</text>
                <text
                  id="open-video-{{attempt.id}}"
                  class="history-attempt-video-action {{attempt.hasVideo ? 'history-attempt-video-saved' : ''}}"
                  data-attempt-id="{{attempt.id}}"
                  data-session-id="{{item.sessionId}}"
                  data-route-id="{{route.id}}"
                  bindtap="openAttemptVideoFromHistory"
                >{{attempt.videoEntryText}}</text>
              </view>
              <!--
                完攀更正（T039）：入口就在原场次这一把旁边；资格沿用 routeCorrectionRows
                的既有有效抱石完攀条件。点「更正」先确认日期、场次、原序号与原结果，
                确认后才按这一行的四个 ID 重新核对并只改这一把。
              -->
              <view wx:if="{{attempt.correctionState}}" class="history-attempt-correct">
                <button
                  wx:if="{{attempt.correctionState !== 'corrected'}}"
                  id="correct-attempt-{{attempt.id}}"
                  class="secondary-button history-correct-button"
                  data-attempt-id="{{attempt.id}}"
                  data-route-id="{{route.id}}"
                  data-session-id="{{item.sessionId}}"
                  data-archive-id="{{attempt.archiveId}}"
                  bindtap="confirmCorrectSend"
                >{{attempt.correctionButtonText}}</button>
                <text
                  wx:else
                  id="corrected-attempt-{{attempt.id}}"
                  class="history-corrected-text"
                >{{attempt.correctionStatusText}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 当天再记：只有用户点这一下才可能新建当日场次 -->
      <view class="record-again-footer">
        <block wx:if="{{canRecordAgain}}">
          <button id="record-again" class="primary-button" bindtap="recordAgain">当天再记</button>
          <text class="record-again-hint">进这条线在本场/当日的单线记录继续记：当日该岩馆已有场次就直接用，当日多场会先让你选一场。</text>
        </block>
        <block wx:else>
          <view id="route-closed-panel" class="route-completed-panel">
            <text class="route-completed-title">{{routeStateText || '暂不能新增把次'}}</text>
            <text class="route-completed-hint">这条抱石线路已完攀，不再新增把次；把次与备注都保留在本机。</text>
            <text class="route-completed-hint">点错了完攀？在上方逐把记录里，点那一把旁边的「更正」改成未完成。</text>
          </view>
        </block>
      </view>

      <!-- 同日多场：先让用户明确选一场，取消不改归属 -->
      <view wx:if="{{sessionPicker}}" id="session-picker" class="card session-picker">
        <text class="card-title">当天再记：选一场</text>
        <text class="session-picker-meta">{{sessionPicker.dateText}} · {{sessionPicker.gymName}} · {{sessionPicker.routeName}}</text>
        <view
          wx:for="{{sessionPicker.sessions}}"
          wx:key="id"
          id="choose-session-{{item.id}}"
          class="session-option"
          data-archive-id="{{sessionPicker.archiveId}}"
          data-route-id="{{sessionPicker.routeId}}"
          data-picker-key="{{sessionPicker.pickerKey}}"
          data-session-id="{{item.id}}"
          bindtap="chooseSessionForAgain"
        >{{item.label}}{{item.isCurrent ? '（当前场次）' : ''}}</view>
        <button id="cancel-session-picker" class="text-button" bindtap="cancelSessionPicker">取消</button>
      </view>
    </block>
  </block>
</view>
