/**
 * 长期线路详情页样式（T018）
 * 与首页、场内页同一套配色（#2c3e50），回看信息为主、操作按钮在下方。
 */

.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 16rpx;
}

.section {
  margin-bottom: 30rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 16rpx;
}

/* 错误与提示 */
.error-card {
  background-color: #ffebee;
}

.error-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #c62828;
  margin-bottom: 12rpx;
}

.error-text {
  display: block;
  font-size: 26rpx;
  color: #b71c1c;
  margin-bottom: 10rpx;
}

.error-hint {
  display: block;
  font-size: 24rpx;
  color: #777777;
  margin-bottom: 20rpx;
}

.storage-error {
  background-color: #fff3e0;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.notice {
  background-color: #e3f2fd;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.storage-error-text,
.notice-text {
  display: block;
  font-size: 26rpx;
  color: #2c3e50;
}

.storage-error-hint,
.notice-hint {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

.primary-button {
  background-color: #2c3e50;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.primary-button::after,
.secondary-button::after,
.text-button::after {
  border: none;
}

.secondary-button {
  background-color: #ffffff;
  color: #2c3e50;
  border: 2rpx solid #2c3e50;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.text-button {
  background-color: transparent;
  color: #2c3e50;
  font-size: 28rpx;
  text-decoration: underline;
  margin-top: 12rpx;
}

/* 线路头部 */
.route-header {
  background-color: #ffffff;
}

.route-title-row {
  display: flex;
  align-items: center;
}

.route-swatch {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.route-title-info {
  flex: 1;
}

.route-name {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  color: #2c3e50;
}

.route-meta {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-top: 6rpx;
}

.route-gym {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

.route-state {
  font-size: 24rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}

.route-state-done {
  background-color: #e8f5e9;
  color: #2e7d32;
}

.route-state-pending {
  background-color: #fff3e0;
  color: #b26a00;
}

.route-summary {
  display: block;
  font-size: 26rpx;
  color: #2c3e50;
  margin-top: 16rpx;
}

/* 跨日分组回看 */
.history-group {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.history-group-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.history-date {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-right: 16rpx;
}

.history-session {
  flex: 1;
  font-size: 24rpx;
  color: #666666;
}

.history-count {
  font-size: 24rpx;
  color: #999999;
}

.empty-attempts {
  font-size: 26rpx;
  color: #999999;
  padding: 24rpx 0;
}

.attempt-item {
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}

.attempt-main {
  display: flex;
  align-items: baseline;
}

.attempt-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-right: 20rpx;
}

.attempt-result {
  font-size: 28rpx;
  margin-right: 20rpx;
}

.result-send {
  color: #2e7d32;
}

.result-fail {
  color: #c62828;
}

.attempt-time {
  font-size: 24rpx;
  color: #999999;
}

.attempt-note {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-top: 12rpx;
}

/* 按把更正 */
.route-correction {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.route-correction-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #2c3e50;
}

.route-correction-hint {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.route-correction-status {
  display: block;
  font-size: 24rpx;
  color: #b26a00;
  margin-top: 8rpx;
}

.route-correction-row {
  margin-top: 16rpx;
}

.route-correction-target {
  display: block;
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.route-correction-slot {
  min-height: 72rpx;
  display: flex;
  align-items: center;
}

.route-correct-button {
  font-size: 26rpx;
}

.route-corrected-text {
  font-size: 24rpx;
  color: #2e7d32;
}

/* 当天再记 */
.record-again-footer {
  margin-bottom: 30rpx;
}

.record-again-hint {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 12rpx;
}

.route-completed-panel {
  background-color: #e8f5e9;
  border-radius: 16rpx;
  padding: 24rpx;
}

.route-completed-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #2e7d32;
  margin-bottom: 8rpx;
}

.route-completed-hint {
  display: block;
  font-size: 24rpx;
  color: #4b6b3f;
  margin-top: 4rpx;
}

/* 同日多场选场 */
.session-picker-meta {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.session-option {
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: #2c3e50;
}

.empty-card {
  background-color: #ffffff;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 12rpx;
}

.empty-hint {
  display: block;
  font-size: 26rpx;
  color: #999999;
}

/* ---- 线路主照片（T019）：详情展示完整主图，保存必须由用户确认 ---- */
.photo-card {
  border: 2rpx dashed #b0bec5;
}

.photo-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.photo-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
}

.photo-note {
  font-size: 22rpx;
  color: #999999;
}

.photo-main,
.photo-preview,
.photo-thumb {
  display: block;
  width: 100%;
  height: 420rpx;
  margin-top: 16rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
}

.photo-thumb {
  height: 300rpx;
}

.photo-status {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #2c3e50;
}

.photo-status-busy {
  color: #b26a00;
}

.photo-status-error {
  color: #c62828;
}

.photo-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999999;
}

.photo-error-detail {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #b71c1c;
  line-height: 1.45;
}

.photo-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
  line-height: 1.5;
}

.photo-actions {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.photo-action {
  flex: 1;
  min-height: 80rpx;
  line-height: 80rpx;
  margin-top: 14rpx;
  font-size: 28rpx;
}

.photo-action + .photo-action {
  margin-left: 14rpx;
}

.photo-remove {
  flex: none;
  margin: 14rpx 0 0 18rpx;
  color: #c62828;
}

.photo-source-row {
  display: flex;
  margin-top: 10rpx;
}

.photo-source {
  flex: 1;
  min-height: 84rpx;
  line-height: 84rpx;
  margin-top: 14rpx;
  font-size: 28rpx;
}

.photo-source + .photo-source {
  margin-left: 14rpx;
}
