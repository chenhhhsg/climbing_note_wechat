/**
 * 长期线路详情页样式（T018）
 * 与首页、场内页同一套配色（#182421），回看信息为主、操作按钮在下方。
 */

.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.card {
  background-color: #FFFFFF;
  border: 1px solid #D7DED9;
  border-radius: 8rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #182421;
  margin-bottom: 16rpx;
}

.section {
  margin-bottom: 30rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #182421;
  margin-bottom: 16rpx;
}

/* 错误与提示 */
.error-card {
  background-color: #F7E6DB;
}

.error-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #943A23;
  margin-bottom: 12rpx;
}

.error-text {
  display: block;
  font-size: 26rpx;
  color: #813323;
  margin-bottom: 10rpx;
}

.error-hint {
  display: block;
  font-size: 24rpx;
  color: #53615B;
  margin-bottom: 20rpx;
}

.storage-error {
  background-color: #F7F1E2;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.notice {
  background-color: #E9EFEC;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.storage-error-text,
.notice-text {
  display: block;
  font-size: 26rpx;
  color: #182421;
}

.storage-error-hint,
.notice-hint {
  display: block;
  font-size: 22rpx;
  color: #53615B;
  margin-top: 8rpx;
}

.primary-button {
  background-color: #1F5948;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.primary-button::after,
.secondary-button::after,
.text-button::after {
  border: none;
}

.secondary-button {
  background-color: #FFFFFF;
  color: #1F5948;
  border: 2rpx solid #1F5948;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.text-button {
  background-color: transparent;
  color: #1F5948;
  font-size: 28rpx;
  margin-top: 12rpx;
}

/* 线路头部 */
.route-header { position:relative; overflow:hidden; background:#FFFFFF; border:1px solid #D7DED9; color:#182421; padding:24rpx 26rpx 20rpx; }

.route-title-row {
  display: flex;
  align-items: center;
}

.route-swatch {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.route-title-info {
  flex: 1;
}

.route-name {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  color: #182421;
}

.route-meta {
  display: block;
  font-size: 26rpx;
  color: #53615B;
  margin-top: 6rpx;
}

.route-gym {
  display: block;
  font-size: 24rpx;
  color: #53615B;
  margin-top: 4rpx;
}

.route-state {
  font-size: 24rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}

.route-state-done {
  background-color: #E9EFEC;
  color: #1F5948;
}

.route-state-pending {
  background-color: #F7F1E2;
  color: #8A442E;
}

.route-summary {
  display: block;
  font-size: 26rpx;
  color: #182421;
  margin-top: 16rpx;
}

/* 跨日分组回看 */
.history-group {
  background-color: #FFFFFF;
  border: 1px solid #D7DED9;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.history-group-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

/* 分组标题可点：按原 sessionId 回到那一条单线记录（T036）。 */
.history-group-open {
  min-height: 44px;
  box-sizing: border-box;
  padding: 8rpx 0;
}

.history-open-hint {
  flex: none;
  font-size: 22rpx;
  color: #B7683D;
}

.history-date {
  font-size: 30rpx;
  font-weight: bold;
  color: #182421;
  margin-right: 16rpx;
}

.history-session {
  flex: 1;
  font-size: 24rpx;
  color: #53615B;
}

.history-count {
  font-size: 24rpx;
  color: #53615B;
}

.empty-attempts {
  font-size: 26rpx;
  color: #53615B;
  padding: 24rpx 0;
}

.attempt-item {
  background-color: #F2F4F3;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}

.attempt-main {
  display: flex;
  align-items: baseline;
}

.attempt-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #182421;
  margin-right: 20rpx;
}

.attempt-result {
  font-size: 28rpx;
  margin-right: 20rpx;
}

.result-send {
  color: #1F5948;
}

.result-fail {
  color: #943A23;
}

.attempt-time {
  font-size: 24rpx;
  color: #53615B;
}

.attempt-note {
  display: block;
  font-size: 26rpx;
  color: #53615B;
  margin-top: 12rpx;
}

/* 按把更正 */
.route-correction {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.route-correction-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #182421;
}

.route-correction-hint {
  display: block;
  font-size: 24rpx;
  color: #53615B;
  margin-top: 8rpx;
}

.route-correction-status {
  display: block;
  font-size: 24rpx;
  color: #8A442E;
  margin-top: 8rpx;
}

.route-correction-row {
  margin-top: 16rpx;
}

.route-correction-target {
  display: block;
  font-size: 24rpx;
  color: #53615B;
  margin-bottom: 8rpx;
}

.route-correction-slot {
  min-height: 44px;
  display: flex;
  align-items: center;
}

.route-correct-button {
  font-size: 26rpx;
}

.route-corrected-text {
  font-size: 24rpx;
  color: #1F5948;
}

/* 当天再记 */
.record-again-footer {
  margin-bottom: 30rpx;
}

.record-again-hint {
  display: block;
  font-size: 24rpx;
  color: #53615B;
  margin-top: 12rpx;
}

.route-completed-panel {
  background-color: #E9EFEC;
  border-radius: 16rpx;
  padding: 24rpx;
}

.route-completed-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #1F5948;
  margin-bottom: 8rpx;
}

.route-completed-hint {
  display: block;
  font-size: 24rpx;
  color: #1F5948;
  margin-top: 4rpx;
}

/* 同日多场选场 */
.session-picker-meta {
  display: block;
  font-size: 24rpx;
  color: #53615B;
  margin-bottom: 12rpx;
}

.session-option {
  background-color: #F2F4F3;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: #182421;
}

.empty-card {
  background-color: #FFFFFF;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #182421;
  margin-bottom: 12rpx;
}

.empty-hint {
  display: block;
  font-size: 26rpx;
  color: #53615B;
}

/* ---- 线路主照片（T019）：详情展示完整主图，保存必须由用户确认 ---- */
.photo-card {
  border: 2rpx dashed #D7DED9;
}

.photo-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.photo-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #182421;
}

.photo-note {
  font-size: 22rpx;
  color: #53615B;
}

.photo-main,
.photo-preview,
.photo-thumb {
  display: block;
  width: 100%;
  height: 420rpx;
  margin-top: 16rpx;
  background-color: #F2F4F3;
  border-radius: 12rpx;
}

.photo-thumb {
  height: 300rpx;
}

.photo-status {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #182421;
}

.photo-status-busy {
  color: #8A442E;
}

.photo-status-error {
  color: #943A23;
}

.photo-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #53615B;
}

.photo-error-detail {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #813323;
  line-height: 1.45;
}

.photo-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #53615B;
  line-height: 1.5;
}

.photo-actions {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.photo-action {
  flex: 1;
  min-height: 44px;
  line-height: 80rpx;
  margin-top: 14rpx;
  font-size: 28rpx;
}

.photo-action + .photo-action {
  margin-left: 14rpx;
}

.photo-remove {
  flex: none;
  margin: 14rpx 0 0 18rpx;
  color: #943A23;
}

.photo-source-row {
  display: flex;
  margin-top: 10rpx;
}

.photo-source {
  flex: 1;
  min-height: 44px;
  line-height: 84rpx;
  margin-top: 14rpx;
  font-size: 28rpx;
}

.photo-source + .photo-source {
  margin-left: 14rpx;
}

/* 岩馆手册 */
page {
  background-color: #F2F4F3;
}

.page { padding:20rpx 24rpx 55rpx; background-color: #F2F4F3; }
.section-title,.card-title,.photo-title { font-family:"Songti SC","Noto Serif CJK SC","SimSun",serif; line-height:1.35; font-weight:700; }
.section-title { font-size:39rpx; border-bottom:2rpx solid #1F5948; padding:0 0 14rpx; }
.card,.photo-card,.attempt-item,.history-group,.selected-route { border-radius:8rpx; box-shadow:none; }
.primary-button,.secondary-button,.text-button { min-height:44px; box-sizing:border-box; display:flex; align-items:center; justify-content:center; line-height:1.4; }
.primary-button,.secondary-button { border-radius:8rpx; }
.attempt-item { background:transparent; border-bottom:1px solid #D7DED9; margin:0; padding:20rpx 0; }
.attempt-label,.history-date { font-weight:700; color:#182421; }
.attempt-time,.session-meta,.history-date,.route-summary { font-family:"IBM Plex Mono",Consolas,"PingFang SC","Microsoft YaHei",sans-serif; font-variant-numeric:tabular-nums; }
.attempt-note { border-left:4rpx solid #B7683D; padding:3rpx 0 3rpx 16rpx; margin:12rpx 0; line-height:1.6; }
.photo-card { background:#F2F4F3; border:1px solid #D7DED9; padding:24rpx; }
.photo-title { font-size:32rpx; color:#182421; }
.photo-thumb,.photo-main { background:#E9EFEC; border-radius:4rpx; }
.route-title-info,.selected-route-info,.session-heading { min-width:0; }
.route-name,.selected-route-name,.training-gym,.card-title { word-break:break-all; }
.route-completed-panel,.route-pending-panel { border-left:8rpx solid #1F5948; background:#E9EFEC; border-radius:4rpx; }
.route-pending-panel { border-left-color:#B7683D; background:#F7F1E2; }

.route-header { position:relative; overflow:hidden; background:#FFFFFF; border:1px solid #D7DED9; color:#182421; padding:24rpx 26rpx 20rpx; }
.route-title-row { align-items:flex-start; flex-wrap:wrap; gap:8rpx 16rpx; }
.route-title-row .route-swatch { position:absolute; width:9rpx; height:100%; left:0; top:0; margin:0; border:0; border-radius:0; }
.route-grade-display { display:inline-flex; align-items:center; justify-content:center; min-width:52px; min-height:44px; box-sizing:border-box; padding:0 10rpx; border-radius:6rpx; background:#E9EFEC; color:#1F5948; font:700 36rpx/1.2 "IBM Plex Mono",Consolas,"PingFang SC","Microsoft YaHei",sans-serif; font-variant-numeric:tabular-nums; letter-spacing:0; word-break:break-all; }
.route-name { margin:12rpx 0 4rpx; color:#182421; font:700 40rpx/1.3 "Songti SC","SimSun",serif; word-break:break-all; }
.route-meta,.route-gym { color:#53615B; line-height:1.55; word-break:break-all; }
.route-summary { display:block; color:#53615B; border-top:1px solid #D7DED9; margin:20rpx 0 0; padding-top:14rpx; line-height:1.5; }
.history-group { background:#FFFFFF; border:1px solid #D7DED9; border-radius:8rpx; padding:16rpx 20rpx; margin-bottom:16rpx; }
.history-group-head { flex-wrap:wrap; gap:6rpx 12rpx; }
.result-send { background:#E9EFEC; color:#1F5948; }
.result-fail { background:#F0EDE3; color:#6B5544; }

/* 下次想爬（T027）：加入、撤下与拆线归档只改清单，线路、照片与把次都不动 */
.wishlist-card { background:#F2F4F3; border:1px solid #D7DED9; padding:24rpx; }
.wishlist-head { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.wishlist-title { font-family:"Songti SC","Noto Serif CJK SC","SimSun",serif; font-weight:700; font-size:32rpx; color:#182421; }
.wishlist-state { font-size:24rpx; padding:6rpx 16rpx; border-radius:8rpx; background:#E9EFEC; color:#1F5948; }
.wishlist-state-completed { background:#E9EFEC; color:#1F5948; }
.wishlist-state-archived { background:#F0EDE3; color:#6B5544; }
.wishlist-state-text { display:block; margin-top:12rpx; font-size:28rpx; color:#182421; }
.wishlist-hint, .wishlist-error { display:block; margin-top:8rpx; font-size:24rpx; line-height:1.6; color:#53615B; }
.wishlist-error { color:#9C3D22; }
.wishlist-actions { display:flex; align-items:center; flex-wrap:wrap; gap:16rpx; margin-top:16rpx; }
.wishlist-actions .wishlist-action { flex:1; min-width:300rpx; }
.wishlist-archive { color:#8A442E; }
.wishlist-remove { color:#745241; }

/* ---- 照片卡点标记（T028）：只动本机标记记录，图上的点按原图归一化位置复原 ---- */
/* 显示区即照片本身的矩形：标记的像素位置由这个矩形与原图尺寸换算出，不能有内边距。 */
.photo-mark-stage {
  position: relative;
  margin-top: 16rpx;
  border-radius: 4rpx;
  overflow: hidden;
  background: #E9EFEC;
}
.photo-mark-stage .photo-main { margin-top: 0; }
.photo-mark-stage-active { outline: 4rpx solid #FF793F; outline-offset: -4rpx; }

.mark-pin {
  position: absolute;
  z-index: 2;
  min-width: 44rpx;
  height: 44rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  transform: translate(-50%, -50%);
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 24rpx;
  line-height: 44rpx;
  text-align: center;
  color: #FFFFFF;
  background: #1F5948;
  box-shadow: 0 2rpx 8rpx rgba(23, 61, 50, 0.35);
}
/* 手法与脚法用不同底色，图上不用读字也能区分。 */
.mark-pin-hand { background: #FF793F; }
.mark-pin-foot { background: #1F5948; }
.mark-pin-selected { outline: 4rpx solid #FF793F; outline-offset: 2rpx; }
.mark-pin-draft { background: #B7683D; opacity: 0.9; }

.mark-card { background: #F2F4F3; border: 1px solid #D7DED9; padding: 24rpx; }
.mark-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.mark-title {
  font-family: "Songti SC", "Noto Serif CJK SC", "SimSun", serif;
  font-weight: 700;
  font-size: 32rpx;
  color: #182421;
}
.mark-count { font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 8rpx; background: #E9EFEC; color: #1F5948; }
.mark-hint, .mark-warn, .mark-notice, .mark-error {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #53615B;
}
.mark-warn { color: #8A442E; }
.mark-notice { color: #1F5948; }
.mark-error { color: #9C3D22; }

.mark-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.mark-actions .mark-action { flex: 1; min-width: 260rpx; margin: 0; }
.mark-delete { color: #745241; }

.mark-editor { margin-top: 20rpx; padding-top: 20rpx; border-top: 1px solid #D7DED9; }
.mark-editor-title { display: block; font-size: 27rpx; font-weight: 700; color: #182421; }
.mark-kind-row { display: flex; gap: 16rpx; margin-top: 14rpx; }
.mark-kind {
  flex: 1;
  min-height: 44px;
  line-height: 72rpx;
  margin: 0;
  font-size: 27rpx;
  border-radius: 8rpx;
  background: #FFFFFF;
  color: #182421;
  border: 2rpx solid #D7DED9;
}
.mark-kind::after { border: none; }
.mark-kind-active { background: #1F5948; color: #FFFFFF; border-color: #1F5948; }
.mark-input {
  margin-top: 16rpx;
  padding: 20rpx;
  min-height: 44px;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #182421;
  background: #FFFFFF;
  border: 2rpx solid #D7DED9;
  border-radius: 8rpx;
}

.mark-list { margin-top: 20rpx; }
.mark-list-title { display: block; font-size: 26rpx; font-weight: 700; color: #182421; margin-bottom: 8rpx; }
.mark-item {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  padding: 16rpx 0;
  border-bottom: 1px solid #D7DED9;
}
.mark-item-index {
  font-family: "IBM Plex Mono", Consolas, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 24rpx;
  min-width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 22rpx;
  color: #FFFFFF;
  background: #1F5948;
}
.mark-item-kind { font-size: 26rpx; color: #8A442E; }
.mark-item-text { flex: 1; font-size: 27rpx; color: #182421; word-break: break-all; }
