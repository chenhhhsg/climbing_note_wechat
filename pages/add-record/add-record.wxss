/**
 * 添加攀岩 Session 页面样式
 */

.page-wrap {
  padding: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 160rpx;
}

/* ========== 区块标题 ========== */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

.section-title-routes {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 32rpx;
}

.route-count {
  font-size: 24rpx;
  font-weight: normal;
  color: #999999;
}

/* ========== 基础信息表单 ========== */
.form-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 0 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item-last {
  border-bottom: none;
}

.form-item-visibility {
  border-bottom: none;
  align-items: flex-start;
  flex-direction: column;
  gap: 16rpx;
}

.visibility-tags {
  display: flex;
  gap: 16rpx;
}

.visibility-tag {
  padding: 12rpx 28rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #666666;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.visibility-active {
  background-color: #e8f5e9;
  border-color: #4caf50;
  color: #4caf50;
  font-weight: bold;
}

.form-label {
  width: 140rpx;
  font-size: 30rpx;
  color: #333333;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
  text-align: right;
}

.form-value {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
  text-align: right;
}

/* ========== 线路空状态 ========== */
.routes-empty {
  text-align: center;
  padding: 60rpx 0;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.routes-empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

.routes-empty-text {
  font-size: 30rpx;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.routes-empty-hint {
  font-size: 26rpx;
  color: #999999;
  display: block;
}

/* ========== 线路卡片 ========== */
.route-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.route-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.route-card-grade {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c3e50;
}

.route-card-status {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.status-success {
  background-color: #e8f5e9;
  color: #4caf50;
}

.status-project {
  background-color: #e3f2fd;
  color: #2196f3;
}

.status-fail {
  background-color: #ffebee;
  color: #f44336;
}

.route-card-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.route-tag {
  font-size: 24rpx;
  padding: 6rpx 14rpx;
  background-color: #f5f5f5;
  color: #666666;
  border-radius: 8rpx;
}

.route-attempts {
  font-size: 24rpx;
  color: #999999;
}

.route-card-images {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.route-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 10rpx;
}

.route-card-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.route-action-btn {
  font-size: 26rpx;
  color: #2c3e50;
  padding: 8rpx 20rpx;
}

.route-action-delete {
  color: #f44336;
}

/* ========== 添加线路按钮 ========== */
.add-route-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx;
  margin-top: 16rpx;
  background-color: #ffffff;
  border: 2rpx dashed #cccccc;
  border-radius: 16rpx;
  transition: border-color 0.2s;
}

.add-route-btn:active {
  border-color: #2c3e50;
}

.add-route-icon {
  font-size: 40rpx;
  color: #2c3e50;
  font-weight: bold;
}

.add-route-text {
  font-size: 30rpx;
  color: #2c3e50;
}

/* ========== 底部固定按钮 ========== */
.bottom-placeholder {
  height: 40rpx;
}

.fixed-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.btn-submit {
  background-color: #2c3e50;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 32rpx;
  border: none;
  font-weight: bold;
}

.btn-submit::after {
  border: none;
}

.btn-submit[disabled] {
  background-color: #95a5a6;
  color: #ffffff;
}

/* ========== 线路表单弹层 ========== */
.route-form-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.route-form-panel {
  width: 100%;
  max-height: 85vh;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
}

.route-form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.route-form-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2c3e50;
}

.route-form-close {
  font-size: 36rpx;
  color: #999999;
  padding: 10rpx;
}

.route-form-body {
  flex: 1;
  padding: 20rpx 30rpx;
  overflow-y: auto;
}

/* 线路表单项 */
.rf-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.rf-item:last-child {
  border-bottom: none;
}

.rf-label {
  font-size: 28rpx;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
}

.rf-value {
  font-size: 30rpx;
  color: #333333;
  padding: 16rpx 0;
}

.rf-input {
  font-size: 30rpx;
  color: #333333;
  padding: 16rpx 0;
}

/* 状态标签 */
.rf-status-tags {
  display: flex;
  gap: 12rpx;
}

.rf-status-tag {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.rf-status-active {
  transform: scale(1.05);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.rf-status-flash.rf-status-active {
  background-color: #fff8e1;
  border-color: #ffc107;
}

.rf-status-completed.rf-status-active {
  background-color: #e8f5e9;
  border-color: #4caf50;
}

.rf-status-failed.rf-status-active {
  background-color: #ffebee;
  border-color: #f44336;
}

.rf-status-project.rf-status-active {
  background-color: #e3f2fd;
  border-color: #2196f3;
}

.rf-status-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

.rf-status-text {
  font-size: 22rpx;
  color: #666666;
}

.rf-status-active .rf-status-text {
  font-weight: bold;
  color: #333333;
}

/* 尝试次数 */
.rf-attempts {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
}

.rf-attempts-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #2c3e50;
  border-radius: 50%;
  font-size: 36rpx;
  color: #ffffff;
}

.rf-attempts-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #2c3e50;
  min-width: 60rpx;
  text-align: center;
}

/* 线路颜色 */
.rf-colors {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.rf-color {
  padding: 12rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #666666;
}

.rf-color-active {
  background-color: #2c3e50;
  color: #ffffff;
}

/* 线路图片 */
.rf-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.rf-image-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
}

.rf-image {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
}

.rf-image-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.rf-image-add {
  width: 140rpx;
  height: 140rpx;
  background-color: #f5f5f5;
  border: 2rpx dashed #cccccc;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rf-image-add-icon {
  font-size: 48rpx;
  color: #cccccc;
}

/* 弹层底部按钮 */
.route-form-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
}

.rf-btn-cancel {
  flex: 1;
  background-color: #f5f5f5;
  color: #666666;
  border-radius: 16rpx;
  font-size: 30rpx;
  border: none;
}

.rf-btn-cancel::after {
  border: none;
}

.rf-btn-confirm {
  flex: 1;
  background-color: #2c3e50;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  border: none;
  font-weight: bold;
}

.rf-btn-confirm::after {
  border: none;
}
