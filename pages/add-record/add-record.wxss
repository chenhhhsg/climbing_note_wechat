/**
 * 添加记录页面样式
 */

/* 页面容器 */
.page-wrap {
  padding: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 160rpx;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
}

/* 表单区域 */
.form-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 16rpx;
  padding-left: 10rpx;
}

/* 表单卡片 */
.form-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 0 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 表单项 */
.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

/* 表单标签 */
.form-label {
  width: 160rpx;
  font-size: 30rpx;
  color: #333333;
  flex-shrink: 0;
}

/* 表单输入 */
.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
  text-align: right;
}

/* 表单选择器显示 */
.form-value {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
  text-align: right;
}

/* 状态标签选择 */
.status-tags {
  display: flex;
  gap: 16rpx;
}

.status-tag {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s;
}

.status-tag-active {
  transform: scale(1.05);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.status-tag-flash.status-tag-active {
  background-color: #fff8e1;
  border: 2rpx solid #ffc107;
}

.status-tag-completed.status-tag-active {
  background-color: #e8f5e9;
  border: 2rpx solid #4caf50;
}

.status-tag-failed.status-tag-active {
  background-color: #ffebee;
  border: 2rpx solid #f44336;
}

.status-tag-project.status-tag-active {
  background-color: #e3f2fd;
  border: 2rpx solid #2196f3;
}

.status-tag-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.status-tag-text {
  font-size: 24rpx;
  color: #666666;
}

.status-tag-active .status-tag-text {
  font-weight: bold;
  color: #333333;
}

/* 尝试次数控件 */
.attempts-control {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.attempts-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #2c3e50;
  border-radius: 50%;
}

.attempts-btn-text {
  font-size: 40rpx;
  color: #ffffff;
  font-weight: bold;
}

.attempts-input {
  width: 120rpx;
  text-align: center;
  font-size: 48rpx;
  font-weight: bold;
  color: #2c3e50;
  margin: 0 40rpx;
}

/* 线路颜色选择 */
.color-section {
  margin-top: 20rpx;
}

.color-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 16rpx;
  display: block;
}

.color-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.color-item {
  padding: 16rpx 28rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666666;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s;
}

.color-item-active {
  background-color: #2c3e50;
  color: #ffffff;
}

/* 文本域 */
.form-textarea {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  color: #333333;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  box-sizing: border-box;
}

/* 图片列表 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  width: 180rpx;
  height: 180rpx;
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 12rpx 0 12rpx;
}

.image-add {
  width: 180rpx;
  height: 180rpx;
  background-color: #f5f5f5;
  border: 2rpx dashed #cccccc;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.image-add-icon {
  font-size: 50rpx;
  color: #cccccc;
  line-height: 1;
}

.image-add-text {
  font-size: 22rpx;
  color: #cccccc;
  margin-top: 8rpx;
}

.image-hint {
  font-size: 24rpx;
  color: #999999;
  margin-top: 16rpx;
  display: block;
}

/* 底部占位 */
.bottom-placeholder {
  height: 40rpx;
}

/* 固定底部按钮 */
.fixed-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.btn-submit {
  background-color: #2c3e50;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 32rpx;
  border: none;
  font-weight: bold;
}

.btn-submit::after {
  border: none;
}

.btn-submit[disabled] {
  background-color: #95a5a6;
  color: #ffffff;
}
