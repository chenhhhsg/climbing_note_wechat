<!--
  添加记录页面
-->
<view class="container">
  <view class="form-card">
    <!-- 日期选择 -->
    <view class="form-item">
      <text class="form-label">日期</text>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="form-value">{{date || '请选择日期'}}</view>
      </picker>
    </view>

    <!-- 地点输入 -->
    <view class="form-item">
      <text class="form-label">地点</text>
      <input
        class="form-input"
        placeholder="请输入攀岩地点"
        value="{{location}}"
        bindinput="onLocationInput"
      />
    </view>

    <!-- 攀岩类型选择 -->
    <view class="form-item">
      <text class="form-label">攀岩类型</text>
      <picker range="{{climbTypes}}" bindchange="onClimbTypeChange">
        <view class="form-value">{{climbType || '请选择类型'}}</view>
      </picker>
    </view>

    <!-- 难度等级选择 -->
    <view class="form-item">
      <text class="form-label">难度等级</text>
      <picker range="{{gradeOptions}}" bindchange="onGradeChange">
        <view class="form-value">{{grade || '请选择难度'}}</view>
      </picker>
    </view>

    <!-- 完成状态选择 -->
    <view class="form-item">
      <text class="form-label">完成状态</text>
      <picker range="{{statusOptions}}" bindchange="onStatusChange">
        <view class="form-value">{{status || '请选择状态'}}</view>
      </picker>
    </view>

    <!-- 尝试次数 -->
    <view class="form-item">
      <text class="form-label">尝试次数</text>
      <input
        class="form-input"
        type="number"
        placeholder="请输入尝试次数"
        value="{{attempts}}"
        bindinput="onAttemptsChange"
      />
    </view>

    <!-- 备注 -->
    <view class="form-item form-item-textarea">
      <text class="form-label">备注</text>
      <textarea
        class="form-textarea"
        placeholder="添加备注信息..."
        value="{{notes}}"
        bindinput="onNotesInput"
        maxlength="500"
      />
    </view>

    <!-- 图片上传 -->
    <view class="form-item form-item-images">
      <text class="form-label">图片</text>
      <view class="image-list">
        <view
          wx:for="{{images}}"
          wx:key="*this"
          class="image-item"
        >
          <image
            src="{{item}}"
            mode="aspectFill"
            class="image-preview"
            bindtap="previewImage"
            data-url="{{item}}"
          />
          <view
            class="image-delete"
            catchtap="deleteImage"
            data-index="{{index}}"
          >×</view>
        </view>
        <view
          wx:if="{{images.length < 9}}"
          class="image-add"
          bindtap="chooseImage"
        >
          <text class="image-add-icon">+</text>
        </view>
      </view>
      <text class="image-hint">最多上传9张图片</text>
    </view>
  </view>

  <!-- 提交按钮 -->
  <button
    class="btn-submit"
    bindtap="submitForm"
    disabled="{{isSubmitting}}"
  >
    {{isSubmitting ? '保存中...' : '保存记录'}}
  </button>
</view>
