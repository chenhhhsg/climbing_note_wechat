<!--
  添加攀岩 Session 页面
-->
<view class="page-wrap">
  <!-- ========== 基础信息 ========== -->
  <view class="section-title">基础信息</view>
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">日期</text>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="form-value">{{date}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">岩馆</text>
      <input
        class="form-input"
        placeholder="请输入岩馆/地点"
        value="{{location}}"
        bindinput="onLocationInput"
      />
    </view>
    <view class="form-item form-item-last">
      <text class="form-label">备注</text>
      <input
        class="form-input"
        placeholder="本次攀岩备注（选填）"
        value="{{notes}}"
        bindinput="onNotesInput"
      />
    </view>
    <view class="form-item form-item-visibility">
      <text class="form-label">可见范围</text>
      <view class="visibility-tags">
        <view
          class="visibility-tag {{visibility === 'private' ? 'visibility-active' : ''}}"
          bindtap="onVisibilitySelect"
          data-value="private"
        >仅自己</view>
        <view
          class="visibility-tag {{visibility === 'friends' ? 'visibility-active' : ''}}"
          bindtap="onVisibilitySelect"
          data-value="friends"
        >好友可见</view>
      </view>
    </view>
  </view>

  <!-- ========== 线路列表 ========== -->
  <view class="section-title section-title-routes">
    <text>线路记录</text>
    <text class="route-count" wx:if="{{routes.length > 0}}">{{routes.length}} 条</text>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{routes.length === 0}}" class="routes-empty">
    <text class="routes-empty-icon">🧗</text>
    <text class="routes-empty-text">还没有添加线路</text>
    <text class="routes-empty-hint">点击下方按钮开始记录</text>
  </view>

  <!-- 线路卡片列表 -->
  <view wx:for="{{routes}}" wx:key="id" class="route-card">
    <view class="route-card-header">
      <view class="route-card-grade">{{item.grade}}</view>
      <view class="route-card-status {{item.status === 'flash' || item.status === 'completed' ? 'status-success' : item.status === 'project' ? 'status-project' : 'status-fail'}}">
        {{item.status === 'flash' ? '⚡Flash' : item.status === 'completed' ? '✅完成' : item.status === 'project' ? '🎯Project' : '❌未完成'}}
      </view>
    </view>
    <view class="route-card-info">
      <text wx:if="{{item.routeColor}}" class="route-tag">{{item.routeColor}}</text>
      <text wx:if="{{item.routeName}}" class="route-tag">{{item.routeName}}</text>
      <text wx:if="{{item.area}}" class="route-tag">{{item.area}}</text>
      <text class="route-attempts">{{item.attempts}}次</text>
    </view>
    <view wx:if="{{item.images.length > 0}}" class="route-card-images">
      <image
        wx:for="{{item.images}}"
        wx:for-item="img"
        wx:key="*this"
        src="{{img}}"
        mode="aspectFill"
        class="route-thumb"
      />
    </view>
    <view class="route-card-actions">
      <view class="route-action-btn" bindtap="openEditRouteForm" data-index="{{index}}">
        <text>编辑</text>
      </view>
      <view class="route-action-btn route-action-delete" bindtap="deleteRoute" data-index="{{index}}">
        <text>删除</text>
      </view>
    </view>
  </view>

  <!-- 添加线路按钮 -->
  <view class="add-route-btn" bindtap="openAddRouteForm">
    <text class="add-route-icon">+</text>
    <text class="add-route-text">添加线路</text>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-placeholder"></view>
</view>

<!-- ========== 固定底部保存按钮 ========== -->
<view class="fixed-bottom">
  <button
    class="btn-submit"
    bindtap="submitSession"
    disabled="{{isSubmitting}}"
  >
    {{isSubmitting ? '保存中...' : editingSessionId ? '更新本次攀岩' : '保存本次攀岩'}}
  </button>
</view>

<!-- ========== 线路表单弹层 ========== -->
<view wx:if="{{showRouteForm}}" class="route-form-mask" bindtap="closeRouteForm">
  <view class="route-form-panel" catchtap="onPanelTap">
    <view class="route-form-header">
      <text class="route-form-title">{{editingRouteIndex >= 0 ? '编辑线路' : '添加线路'}}</text>
      <text class="route-form-close" bindtap="closeRouteForm">✕</text>
    </view>

    <scroll-view scroll-y class="route-form-body" style="height: 60vh;">
      <!-- 攀岩类型 -->
      <view class="rf-item">
        <text class="rf-label">攀岩类型</text>
        <picker range="{{climbTypes}}" bindchange="onRouteClimbTypeChange">
          <view class="rf-value">{{climbTypeLabels[routeForm.climbType] || '请选择'}}</view>
        </picker>
      </view>

      <!-- 难度 -->
      <view class="rf-item">
        <text class="rf-label">难度等级</text>
        <picker range="{{gradeOptions}}" bindchange="onRouteGradeChange">
          <view class="rf-value">{{routeForm.grade || '请选择'}}</view>
        </picker>
      </view>

      <!-- 完成状态 -->
      <view class="rf-item rf-item-status">
        <text class="rf-label">完成状态</text>
        <view class="rf-status-tags">
          <view
            wx:for="{{statusTags}}"
            wx:key="value"
            class="rf-status-tag {{routeForm.status === item.value ? 'rf-status-active' : ''}} rf-status-{{item.value}}"
            bindtap="onRouteStatusSelect"
            data-status="{{item.value}}"
          >
            <text class="rf-status-icon">{{item.icon}}</text>
            <text class="rf-status-text">{{item.label}}</text>
          </view>
        </view>
      </view>

      <!-- 尝试次数 -->
      <view class="rf-item rf-item-attempts">
        <text class="rf-label">尝试次数</text>
        <view class="rf-attempts">
          <view class="rf-attempts-btn" bindtap="onRouteAttemptsMinus">
            <text>−</text>
          </view>
          <text class="rf-attempts-num">{{routeForm.attempts}}</text>
          <view class="rf-attempts-btn" bindtap="onRouteAttemptsPlus">
            <text>+</text>
          </view>
        </view>
      </view>

      <!-- 线路颜色 -->
      <view class="rf-item rf-item-color">
        <text class="rf-label">线路颜色</text>
        <view class="rf-colors">
          <view
            wx:for="{{colorOptions}}"
            wx:key="*this"
            class="rf-color {{routeForm.routeColor === item ? 'rf-color-active' : ''}}"
            bindtap="onRouteColorSelect"
            data-color="{{item}}"
          >{{item}}</view>
        </view>
      </view>

      <!-- 线路编号 -->
      <view class="rf-item">
        <text class="rf-label">线路编号</text>
        <input class="rf-input" placeholder="如 A3" value="{{routeForm.routeName}}" bindinput="onRouteNameInput" />
      </view>

      <!-- 区域 -->
      <view class="rf-item">
        <text class="rf-label">区域</text>
        <input class="rf-input" placeholder="如 抱石区A" value="{{routeForm.area}}" bindinput="onRouteAreaChange" />
      </view>

      <!-- 备注 -->
      <view class="rf-item">
        <text class="rf-label">备注</text>
        <input class="rf-input" placeholder="选填" value="{{routeForm.notes}}" bindinput="onRouteNotesInput" />
      </view>

      <!-- 图片 -->
      <view class="rf-item rf-item-images">
        <text class="rf-label">图片（最多6张）</text>
        <view class="rf-images">
          <view wx:for="{{routeForm.images}}" wx:key="*this" class="rf-image-wrap">
            <image src="{{item}}" mode="aspectFill" class="rf-image" bindtap="previewRouteImage" data-url="{{item}}" />
            <view class="rf-image-del" catchtap="deleteRouteImage" data-index="{{index}}">×</view>
          </view>
          <view wx:if="{{routeForm.images.length < 6}}" class="rf-image-add" bindtap="chooseRouteImage">
            <text class="rf-image-add-icon">+</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="route-form-footer">
      <button class="rf-btn-cancel" bindtap="closeRouteForm">取消</button>
      <button class="rf-btn-confirm" bindtap="confirmRouteForm">
        {{editingRouteIndex >= 0 ? '更新线路' : '添加线路'}}
      </button>
    </view>
  </view>
</view>
