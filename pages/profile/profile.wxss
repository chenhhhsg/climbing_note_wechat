/**
 * 个人中心页面样式
 */

/* 用户信息区域 */
.user-section {
  background: linear-gradient(135deg, #2c3e50 0%, #3d566e 100%);
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 62, 80, 0.3);
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 30rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-default {
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  font-size: 48rpx;
  color: #ffffff;
}

/* 头像选择按钮 */
.avatar-btn {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  margin-right: 30rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.user-detail {
  flex: 1;
}

.username {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  display: block;
  margin-bottom: 10rpx;
}

/* 昵称输入框 */
.nickname-input {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  background: transparent;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.3);
  padding-bottom: 8rpx;
}

.nickname-input::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.user-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  display: block;
  margin-top: 10rpx;
}

/* 功能菜单 */
.menu-section {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  font-size: 30rpx;
  color: #333333;
}

.menu-arrow {
  font-size: 30rpx;
  color: #cccccc;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 40rpx 0;
  color: #999999;
  font-size: 24rpx;
}
