/**
 * 个人中心页面样式
 */

/* 用户信息区域 */
.user-section {
  background-color: #173d32;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 30rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-default {
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  font-size: 50rpx;
  color: #fffcf3;
}

.user-detail {
  flex: 1;
}

.username {
  font-size: 36rpx;
  font-weight: bold;
  color: #fffcf3;
  display: block;
  margin-bottom: 10rpx;
}

.user-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  display: block;
}

/* 功能菜单 */
.menu-section {
  background-color: #fffcf3;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #dcdccc;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  font-size: 30rpx;
  color: #22372f;
}

.menu-arrow {
  font-size: 30rpx;
  color: #b6bcaa;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 40rpx 0;
  color: #606d61;
  font-size: 24rpx;
}

/* T068：文字备份与恢复
   320/390 宽都用流式布局：按钮可换行，文本框与输入框宽度 100%，不写固定像素宽。 */
.backup-section {
  background-color: #fffcf3;
  border-radius: 8rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 30rpx;
}

.backup-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.backup-title {
  font-family: "Songti SC", "Noto Serif CJK SC", "SimSun", serif;
  font-size: 34rpx;
  font-weight: 700;
  color: #173d32;
}

.backup-scope,
.backup-hint,
.backup-footnote {
  display: block;
  font-size: 25rpx;
  line-height: 1.65;
  color: #4b5b50;
}

.backup-scope {
  margin-bottom: 18rpx;
}

.backup-subtitle {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #173d32;
  margin-bottom: 8rpx;
}

.backup-hint {
  margin-bottom: 14rpx;
}

.backup-footnote {
  font-size: 23rpx;
  color: #606d61;
  margin-top: 14rpx;
}

.backup-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.backup-pager {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.backup-button {
  flex: 1 1 240rpx;
  min-width: 0;
  margin: 0;
  padding: 18rpx 22rpx;
  border: none;
  border-radius: 8rpx;
  background-color: #173d32;
  color: #fffcf3;
  font-size: 27rpx;
  line-height: 1.35;
  text-align: center;
}

.backup-button::after {
  border: none;
}

.backup-button[disabled] {
  opacity: 0.45;
}

.backup-button.secondary {
  background-color: #fffcf3;
  color: #173d32;
  border: 1rpx solid #b6bcaa;
}

.backup-button.danger {
  background-color: #9c3d22;
  color: #fffcf3;
}

.backup-notice {
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.backup-notice-success {
  background-color: #e2ebda;
  color: #2f6248;
}

.backup-notice-info {
  background-color: #e4ebdf;
  color: #355e50;
}

.backup-notice-warning {
  background-color: #f6ead5;
  color: #745241;
}

.backup-notice-error {
  background-color: #f7e6db;
  color: #813323;
}

.backup-output {
  margin-bottom: 20rpx;
}

.backup-meta {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #4b5b50;
  margin-bottom: 10rpx;
}

.backup-text-box {
  width: 100%;
  height: 320rpx;
  box-sizing: border-box;
  padding: 16rpx;
  margin-bottom: 14rpx;
  background-color: #f7f4ea;
  border: 1rpx solid #dcdccc;
  border-radius: 8rpx;
}

.backup-text {
  display: block;
  font-size: 22rpx;
  line-height: 1.5;
  color: #22372f;
  word-break: break-all;
  white-space: pre-wrap;
}

.backup-warn {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #813323;
}

.backup-import-block {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #dcdccc;
}

.backup-import {
  width: 100%;
  height: 240rpx;
  box-sizing: border-box;
  padding: 16rpx;
  margin-bottom: 14rpx;
  background-color: #f7f4ea;
  border: 1rpx solid #dcdccc;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #22372f;
}

.backup-preview {
  padding: 16rpx 20rpx;
  background-color: #f7f1e2;
  border-radius: 8rpx;
  margin-top: 6rpx;
}

.backup-preview .backup-meta:last-child {
  margin-bottom: 0;
}

/* 岩馆手册 */
.field-menu-mark { width:14rpx; height:18rpx; margin-right:24rpx; }
.menu-section,.user-section { border-radius:8rpx; }
