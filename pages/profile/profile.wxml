<!--
  个人中心页面
-->
<view class="container">
  <!-- 用户信息区域 -->
  <view class="user-section">
    <view wx:if="{{hasUserInfo}}" class="user-info">
      <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
      <view class="user-detail">
        <text class="username">{{userInfo.nickName}}</text>
        <text class="user-desc">头像和昵称只在本页显示，不会创建账号或上传同步。</text>
      </view>
    </view>
    <view wx:else class="user-info" bindtap="getUserProfile">
      <view class="avatar avatar-default">
        <text class="avatar-icon">?</text>
      </view>
      <view class="user-detail">
        <text class="username">设置头像昵称</text>
        <text class="user-desc">头像和昵称只在本页显示，不会创建账号或上传同步；新的训练记录保存在这台手机的攀笔中。</text>
      </view>
    </view>
    <!-- T066：资料读取结果只在本页说明，和意见反馈的复制结果互不影响 -->
    <text wx:if="{{profileNotice}}" id="profile-notice" class="user-desc">{{profileNotice}}</text>
  </view>

  <!--
    T068：文字备份入口。说明紧挨入口，写清只备份文字、不含媒体/时间点/操作日志；
    已有媒体保持旧档案归属，恢复不会产生可播放副本。
  -->
  <view class="backup-section" id="backup-section">
    <view class="backup-head">
      <view class="field-menu-mark"></view>
      <text class="backup-title">文字备份与恢复</text>
    </view>
    <text class="backup-scope" id="backup-scope">
      只备份文字：训练场次、线路、逐把结果与备注、下次想爬清单、计数与当前选择。照片、视频、时间点标记、操作日志和云端记录不包含；已有照片与视频仍归旧档案所有，恢复的文字不会产生可播放副本。
    </text>

    <view wx:if="{{backupNotice}}" id="backup-notice" class="backup-notice backup-notice-{{backupNoticeKind}}">
      <text>{{backupNotice}}</text>
    </view>

    <view class="backup-actions">
      <button id="export-backup" class="backup-button" bindtap="exportBackupText">生成文本备份</button>
      <button id="export-diagnostics" class="backup-button secondary" bindtap="exportBackupDiagnostics">导出受损诊断</button>
    </view>

    <view wx:if="{{backupExportReady}}" id="backup-export" class="backup-output">
      <text id="backup-export-meta" class="backup-meta">{{backupExportMeta}}</text>
      <text id="backup-export-slice-label" class="backup-meta">{{backupExportSliceLabel}}</text>
      <scroll-view class="backup-text-box" scroll-y="{{true}}">
        <text class="backup-text" selectable="{{true}}" user-select="{{true}}">{{backupExportSlice}}</text>
      </scroll-view>
      <view wx:if="{{backupExportSliceCount > 1}}" class="backup-pager">
        <button
          id="prev-backup-slice"
          class="backup-button secondary"
          disabled="{{backupExportSliceIndex <= 0}}"
          bindtap="prevBackupExportSlice"
        >上一段</button>
        <button
          id="next-backup-slice"
          class="backup-button secondary"
          disabled="{{backupExportSliceIndex >= backupExportSliceCount - 1}}"
          bindtap="nextBackupExportSlice"
        >下一段</button>
      </view>
      <button id="copy-backup" class="backup-button" bindtap="copyBackupText">复制备份文本（全文）</button>
      <text wx:if="{{backupCopyFailed}}" id="backup-copy-failed" class="backup-warn">{{backupCopyIssueText}}</text>
    </view>

    <view wx:if="{{backupDiagnosticsReady}}" id="backup-diagnostics" class="backup-output">
      <text id="backup-diagnostics-meta" class="backup-meta">{{backupDiagnosticsMeta}}</text>
      <text id="backup-diagnostics-slice-label" class="backup-meta">{{backupDiagnosticsSliceLabel}}</text>
      <scroll-view class="backup-text-box" scroll-y="{{true}}">
        <text class="backup-text" selectable="{{true}}" user-select="{{true}}">{{backupDiagnosticsSlice}}</text>
      </scroll-view>
      <view wx:if="{{backupDiagnosticsSliceCount > 1}}" class="backup-pager">
        <button
          id="prev-diagnostics-slice"
          class="backup-button secondary"
          disabled="{{backupDiagnosticsSliceIndex <= 0}}"
          bindtap="prevBackupDiagnosticsSlice"
        >上一段</button>
        <button
          id="next-diagnostics-slice"
          class="backup-button secondary"
          disabled="{{backupDiagnosticsSliceIndex >= backupDiagnosticsSliceCount - 1}}"
          bindtap="nextBackupDiagnosticsSlice"
        >下一段</button>
      </view>
      <button id="copy-diagnostics" class="backup-button secondary" bindtap="copyBackupDiagnostics">复制诊断原文（全文）</button>
      <text wx:if="{{backupDiagnosticsCopyFailed}}" id="backup-diagnostics-copy-failed" class="backup-warn">{{backupDiagnosticsCopyIssueText}}</text>
    </view>

    <view class="backup-import-block" id="backup-import-block">
      <text class="backup-subtitle">从文字恢复</text>
      <text class="backup-hint">
        把之前复制到别处保存的备份文本粘贴到这里。正常导入只接受本页「生成文本备份」的格式；受损诊断原文只能用于排查，不能当作备份导入。
      </text>
      <!-- 原生非受控输入：不回绑 value，粘贴的大文本只留在页面实例，避免 setData 放大。 -->
      <textarea
        id="backup-import-input"
        class="backup-import"
        maxlength="{{backupImportMaxLength}}"
        placeholder="粘贴备份文本…"
        cursor-spacing="24"
        bindinput="onBackupImportInput"
      ></textarea>
      <view class="backup-actions">
        <button id="preview-backup" class="backup-button secondary" bindtap="previewBackupImport">检查备份文本</button>
        <button wx:if="{{backupPreview}}" id="confirm-restore" class="backup-button danger" bindtap="confirmBackupRestore">确认恢复</button>
      </view>
      <view wx:if="{{backupPreview}}" id="backup-preview" class="backup-preview">
        <text class="backup-meta">
          已校验：{{backupPreview.summary.sessions}} 场 · {{backupPreview.summary.routes}} 条线路 · {{backupPreview.summary.attempts}} 把 · {{backupPreview.summary.notes}} 条备注 · 清单 {{backupPreview.summary.wishlist}} 条
        </text>
        <text class="backup-meta">
          来源档案 {{backupPreview.plan.sourceArchiveId}}。正式恢复会分配新的档案归属；当前档案原文保留在本机供诊断，恢复不会带来照片、视频或时间点的可播放副本。
        </text>
      </view>
    </view>

    <text class="backup-footnote">
      复制与恢复都只在你点按后发生；本页不代你上传，也不把诊断原文当成可导入备份。
    </text>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goToFitnessTest">
      <view class="menu-left">
        <view class="field-menu-mark"></view>
        <text class="menu-text">体能自测</text>
      </view>
      <text class="menu-arrow">></text>
    </view>

    <view class="menu-item" bindtap="feedback">
      <view class="menu-left">
        <view class="field-menu-mark"></view>
        <text class="menu-text">意见反馈</text>
      </view>
      <text class="menu-arrow">></text>
    </view>

    <!-- T059：原生剪贴板复制失败时保留原文，提供同一段文字的重试入口 -->
    <view
      wx:if="{{feedbackCopyFailed}}"
      id="feedback-retry"
      class="menu-item"
      bindtap="retryFeedback"
    >
      <view class="menu-left">
        <view class="field-menu-mark"></view>
        <text class="menu-text">反馈未复制，点此重试</text>
      </view>
      <text class="menu-arrow">></text>
    </view>

    <view class="menu-item" bindtap="clearCache">
      <view class="menu-left">
        <view class="field-menu-mark"></view>
        <text class="menu-text">清除缓存</text>
      </view>
      <text class="menu-arrow">></text>
    </view>

    <view class="menu-item" bindtap="goToAbout">
      <view class="menu-left">
        <view class="field-menu-mark"></view>
        <text class="menu-text">关于攀笔</text>
      </view>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text>攀笔 v1.0.0</text>
  </view>
</view>
