<!--
  记录列表页面（Tab）
  上半部分：本机训练历史（T043 原场次列表，只读本机档案，按原日期与岩馆分组，
  点一场直达 pages/training-summary 的原场小结）。
  下半部分：既有「旧记录」云列表（只读回看，保留原分页、失败重试与刷新竞争处理）。
-->
<view class="container">
  <!-- 本机训练历史：日期倒序 → 同日原岩馆分组 → 组内原场次倒序 -->
  <view class="local-history">
    <view class="section-header">
      <text class="section-title">本机训练历史</text>
      <text class="section-hint">本地存档 · 按场次</text>
    </view>

    <view wx:if="{{archiveError}}" id="archive-error" class="inline-error">
      <text class="inline-error-text">{{archiveError}}</text>
      <text class="retry-link" bindtap="retryRefresh">重试读取</text>
    </view>

    <view wx:elif="{{!hasLocalHistory}}" id="local-empty" class="local-empty">
      <text class="local-empty-text">还没有本机训练记录</text>
      <text class="local-empty-hint">回首页「开始训练」，按线路逐把记录后会出现在这里。</text>
    </view>

    <view wx:else class="local-session-list">
      <view
        wx:for="{{sessionDays}}"
        wx:for-item="day"
        wx:key="date"
        id="local-day-{{day.date}}"
        class="local-day"
      >
        <text class="local-day-date">{{day.date}}</text>
        <view
          wx:for="{{day.gyms}}"
          wx:for-item="gym"
          wx:key="gymId"
          id="local-gym-{{day.date}}-{{gym.gymId}}"
          class="local-gym"
        >
          <text class="local-gym-name">{{gym.gymName}}</text>
          <!-- T044：同馆多场各一张中性卡，卡间留距；日期与岩馆在标题上，卡里只放场次身份。 -->
          <view class="local-session-list">
            <view
              wx:for="{{gym.sessions}}"
              wx:for-item="session"
              wx:key="id"
              id="local-session-{{session.id}}"
              class="local-session-row"
              bindtap="goToSessionSummary"
              data-session-id="{{session.id}}"
              data-archive-id="{{session.archiveId}}"
            >
              <view class="local-session-main">
                <text class="local-session-label">{{session.label}}</text>
                <text wx:if="{{session.stateText}}" class="local-session-state">{{session.stateText}}</text>
              </view>
              <text class="local-session-count">{{session.summaryText}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 旧记录（云汇总，只读回看；分页与失败重试保持原样） -->
  <view class="legacy-section">
    <view class="section-header">
      <text class="section-title">旧记录</text>
      <text class="section-hint">云端旧汇总 · 只读回看</text>
    </view>

    <!-- 首次加载中 -->
    <view wx:if="{{loading && records.length === 0}}" class="loading-state">
      <text>加载中...</text>
    </view>

    <!-- 首次加载失败：区分云环境不可用、没有权限与一般读取失败，给出可重试入口 -->
    <view wx:elif="{{loadError && records.length === 0}}" class="error-state">
      <text class="error-text">{{cloudErrorTitle || '加载失败'}}</text>
      <text class="error-hint">{{cloudErrorHint}}</text>
      <button class="btn-retry" bindtap="retryRefresh">重试</button>
    </view>

    <!-- 空库：旧记录为空与本机训练历史分开显示 -->
    <view wx:elif="{{isEmpty}}" class="empty-state">
      <text class="empty-text">还没有旧记录</text>
      <text class="empty-hint">旧云端汇总为空；本机训练历史不受影响。</text>
      <button class="btn-add" bindtap="goToAddRecord">补录旧记录</button>
    </view>

    <!-- 记录列表 -->
    <view wx:else class="record-list">
      <!-- 已有内容时刷新失败：保留旧记录，只做简短提示 -->
      <view wx:if="{{refreshError}}" class="inline-error">
        <text class="inline-error-text">{{cloudErrorTitle || '刷新失败'}}，正在显示上次的旧记录</text>
        <text class="retry-link" bindtap="retryRefresh">重试刷新</text>
      </view>

      <view
        wx:for="{{records}}"
        wx:key="_id"
        class="record-card"
        bindtap="goToDetail"
        data-id="{{item._id}}"
      >
        <!-- 记录头部：日期和状态 -->
        <view class="record-header">
          <text class="record-date">{{item.dateText}}</text>
          <text class="record-status {{item.status === '完成' ? 'status-success' : 'status-fail'}}">
            {{item.status}}
          </text>
        </view>

        <!-- 记录内容 -->
        <view class="record-content">
          <view class="record-info">
            <view class="info-item">
              <text class="info-label">地点</text>
              <text class="info-value">{{item.location || '-'}}</text>
            </view>
            <view class="info-item">
              <text class="info-label">类型</text>
              <text class="info-value">{{item.climbType}}</text>
            </view>
            <view class="info-item">
              <text class="info-label">难度</text>
              <text class="info-value grade">{{item.grade}}</text>
            </view>
            <view class="info-item">
              <text class="info-label">尝试</text>
              <text class="info-value">{{item.attempts}}次</text>
            </view>
          </view>

          <!-- 备注预览 -->
          <view wx:if="{{item.notes}}" class="record-notes">
            <text class="notes-text">{{item.notes}}</text>
          </view>

          <!-- 图片预览 -->
          <view wx:if="{{item.images && item.images.length > 0}}" class="record-images">
            <image
              wx:for="{{item.images}}"
              wx:for-item="img"
              wx:key="*this"
              src="{{img}}"
              mode="aspectFill"
              class="image-thumb"
            />
          </view>
        </view>
      </view>

      <!-- 加载更多提示 -->
      <view wx:if="{{loadingMore}}" class="loading-more">
        <text>加载中...</text>
      </view>
      <!-- 翻页失败：重试继续请求刚才失败的页 -->
      <view wx:elif="{{loadMoreError}}" class="inline-error load-more-error">
        <text class="inline-error-text">加载更多失败</text>
        <text class="retry-link" bindtap="retryLoadMore">重试加载更多</text>
      </view>
      <view wx:elif="{{!hasMore && records.length > 0}}" class="no-more">
        <text>没有更多旧记录了</text>
      </view>
    </view>
  </view>
</view>

<!--
  悬浮入口：旧的「补录旧记录」表单保持可达（T030）。
  写清「补录旧记录」，让新手分得清场内加线与早期记录补录，不再是一个无文字的加号。
-->
<view class="fab" bindtap="goToAddRecord">
  <text class="fab-text">＋ 补录旧记录</text>
</view>
