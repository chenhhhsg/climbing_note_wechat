<!--
  记录列表页面 - 攀岩场次列表，支持搜索、筛选
-->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索岩馆、备注、线路编号..."
        value="{{keyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
      />
      <text wx:if="{{keyword}}" class="search-clear" bindtap="onClearSearch">✕</text>
    </view>
    <view class="filter-btn {{showFilter ? 'filter-btn-active' : ''}}" bindtap="onToggleFilter">
      <text class="filter-icon">⚙</text>
    </view>
  </view>

  <!-- 当前筛选条件 -->
  <view wx:if="{{filters.climbType || filters.status || filters.grade || filters.location}}" class="active-filters">
    <view wx:if="{{filters.climbType}}" class="filter-tag">
      <text>{{climbTypeLabels[filters.climbType]}}</text>
      <text class="filter-tag-remove" bindtap="onResetFilter">✕</text>
    </view>
    <view wx:if="{{filters.status}}" class="filter-tag">
      <text>{{statusLabels[filters.status]}}</text>
      <text class="filter-tag-remove" bindtap="onResetFilter">✕</text>
    </view>
    <view wx:if="{{filters.grade}}" class="filter-tag">
      <text>{{filters.grade}}</text>
      <text class="filter-tag-remove" bindtap="onResetFilter">✕</text>
    </view>
    <view wx:if="{{filters.location}}" class="filter-tag">
      <text>{{filters.location}}</text>
      <text class="filter-tag-remove" bindtap="onResetFilter">✕</text>
    </view>
  </view>

  <!-- 筛选面板 -->
  <view wx:if="{{showFilter}}" class="filter-mask" bindtap="onFilterMaskTap">
    <view class="filter-panel" catchtap="">
      <view class="filter-title">筛选条件</view>

      <view class="filter-item">
        <text class="filter-label">岩馆</text>
        <input
          class="filter-input"
          placeholder="输入岩馆名称"
          value="{{tempFilters.location}}"
          bindinput="onFilterLocationInput"
        />
      </view>

      <view class="filter-item">
        <text class="filter-label">攀岩类型</text>
        <picker range="{{climbTypes}}" bindchange="onFilterTypeChange">
          <view class="filter-value">{{climbTypeLabels[tempFilters.climbType] || '全部'}}</view>
        </picker>
      </view>

      <view class="filter-item">
        <text class="filter-label">完成状态</text>
        <picker range="{{statusOptions}}" bindchange="onFilterStatusChange">
          <view class="filter-value">{{statusLabels[tempFilters.status] || '全部'}}</view>
        </picker>
      </view>

      <view class="filter-item">
        <text class="filter-label">难度等级</text>
        <picker range="{{filterGradeOptions}}" bindchange="onFilterGradeChange">
          <view class="filter-value">{{tempFilters.grade || '全部'}}</view>
        </picker>
      </view>

      <view class="filter-actions">
        <button class="filter-reset-btn" bindtap="onResetFilter">重置</button>
        <button class="filter-apply-btn" bindtap="onApplyFilter">应用</button>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading && sessions.length === 0}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{isEmpty}}" class="empty-state">
    <text class="empty-icon">🧗</text>
    <text class="empty-text">没有找到攀岩记录</text>
    <button class="btn-add" bindtap="goToAddRecord">添加第一次攀岩</button>
  </view>

  <!-- 攀岩场次列表 -->
  <view wx:else class="session-list">
    <view
      wx:for="{{sessions}}"
      wx:key="_id"
      class="session-card"
      bindtap="goToDetail"
      data-id="{{item._id}}"
    >
      <!-- 卡片头部：日期 + 岩馆 -->
      <view class="session-header">
        <text class="session-date">{{item.dateText}}</text>
        <text class="session-location">{{item.location || '未填写地点'}}</text>
      </view>

      <!-- 统计数据 -->
      <view class="session-stats">
        <view class="session-stat">
          <text class="session-stat-num">{{item.routeCount}}</text>
          <text class="session-stat-label">线路</text>
        </view>
        <view class="session-stat">
          <text class="session-stat-num session-stat-success">{{item.completedCount}}</text>
          <text class="session-stat-label">完成</text>
        </view>
        <view class="session-stat">
          <text class="session-stat-num session-stat-project">{{item.projectCount}}</text>
          <text class="session-stat-label">Project</text>
        </view>
        <view class="session-stat">
          <text class="session-stat-num">{{item.maxGrade}}</text>
          <text class="session-stat-label">最高</text>
        </view>
        <view class="session-stat">
          <text class="session-stat-num">{{item.completionRate}}%</text>
          <text class="session-stat-label">完成率</text>
        </view>
      </view>

      <!-- 备注摘要 -->
      <view wx:if="{{item.notes}}" class="session-notes">
        <text>{{item.notes}}</text>
      </view>
    </view>

    <!-- 加载更多提示 -->
    <view wx:if="{{loading}}" class="loading-more">
      <text>加载中...</text>
    </view>
    <view wx:elif="{{!hasMore && sessions.length > 0}}" class="no-more">
      <text>没有更多记录了</text>
    </view>

    <!-- 底部占位（为 FAB 按钮留空间） -->
    <view class="fab-placeholder"></view>
  </view>
</view>

<!-- 悬浮添加按钮 -->
<view class="fab" bindtap="goToAddRecord">
  <text class="fab-icon">+</text>
</view>
