/**
 * 记录列表页面样式
 */

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 100rpx 0;
  color: #606d61;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #526157;
  display: block;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #606d61;
  display: block;
  margin-bottom: 30rpx;
}

.btn-add {
  background-color: #173d32;
  color: #fffcf3;
  border-radius: 12rpx;
  padding: 20rpx 60rpx;
  font-size: 30rpx;
  display: inline-block;
  border: none;
}

.btn-add::after {
  border: none;
}

/* 首次加载失败 */
.error-state {
  text-align: center;
  padding: 100rpx 0;
}

.error-text {
  font-size: 30rpx;
  color: #526157;
  display: block;
  margin-bottom: 16rpx;
}

.error-hint {
  font-size: 24rpx;
  color: #606d61;
  display: block;
  margin-bottom: 30rpx;
}

.btn-retry {
  background-color: #173d32;
  color: #fffcf3;
  border-radius: 12rpx;
  padding: 18rpx 60rpx;
  font-size: 28rpx;
  display: inline-block;
  border: none;
}

.btn-retry::after {
  border: none;
}

/* 已有内容时的失败提示 */
.inline-error {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background-color: #f3edda;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
}

.inline-error-text {
  color: #745241;
}

.retry-link {
  color: #173d32;
  font-weight: bold;
}

.load-more-error {
  margin-top: 10rpx;
}

/* 记录卡片 */
.record-card {
  background-color: #fffcf3;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: none;
}

/* 记录头部 */
.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #dcdccc;
}

.record-date {
  font-size: 32rpx;
  font-weight: bold;
  color: #173d32;
}

.record-status {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.status-success {
  background-color: #e2ebda;
  color: #2f6248;
}

.status-fail {
  background-color: #f7e6db;
  color: #9c3d22;
}

/* 记录内容 */
.record-info {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 30rpx;
}

.info-item {
  display: flex;
  align-items: center;
}

.info-label {
  font-size: 26rpx;
  color: #606d61;
  margin-right: 10rpx;
}

.info-value {
  font-size: 28rpx;
  color: #22372f;
}

.info-value.grade {
  font-weight: bold;
  color: #173d32;
}

/* 备注 */
.record-notes {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #dcdccc;
}

.notes-text {
  font-size: 26rpx;
  color: #526157;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 图片预览 */
.record-images {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #dcdccc;
}

.image-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
}

/* 加载更多 */
.loading-more,
.no-more {
  text-align: center;
  padding: 30rpx 0;
  color: #606d61;
  font-size: 26rpx;
}

/* 悬浮按钮：写清是「补录旧记录」，不是无文字的加号（T030） */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 40rpx;
  min-height: 88rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  background-color: #173d32;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
  z-index: 100;
  max-width: 70%;
}

.fab-text {
  font-size: 28rpx;
  color: #fffcf3;
  font-weight: bold;
  white-space: nowrap;
}

/* 分区标题（本机训练历史 / 旧记录） */
.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #173d32;
}

.section-hint {
  font-size: 24rpx;
  color: #606d61;
}

/* 本机训练历史（T018） */
.local-history {
  margin-bottom: 40rpx;
}

.local-empty {
  background-color: #fffcf3;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  text-align: center;
}

.local-empty-text {
  display: block;
  font-size: 30rpx;
  color: #526157;
  margin-bottom: 12rpx;
}

.local-empty-hint {
  display: block;
  font-size: 24rpx;
  color: #606d61;
}

.local-route-card {
  background-color: #fffcf3;
  border-radius: 16rpx;
  padding: 26rpx;
  margin-bottom: 16rpx;
  box-shadow: none;
}

.local-route-main {
  display: flex;
  align-items: center;
}

.local-route-swatch {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.local-route-info {
  flex: 1;
}

.local-route-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #173d32;
}

.local-route-meta {
  display: block;
  font-size: 24rpx;
  color: #526157;
  margin-top: 4rpx;
}

.local-route-gym {
  display: block;
  font-size: 24rpx;
  color: #606d61;
  margin-top: 4rpx;
}

.local-route-stats {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #dcdccc;
}

.local-route-last {
  font-size: 24rpx;
  color: #526157;
}

.local-route-count {
  font-size: 24rpx;
  color: #173d32;
}

/* 旧记录（云汇总，只读回看） */
.legacy-section {
  margin-bottom: 40rpx;
}

/* 岩馆手册 */
.local-route-card,.record-card { border-radius:6rpx; border:1px solid #d8d9c9; }
.local-route-name { font-family:"Songti SC","SimSun",serif; font-size:34rpx; }
