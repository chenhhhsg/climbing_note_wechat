/**
 * 记录列表页面样式 - 攀岩场次列表
 */

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 80rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 80rpx;
}

.search-clear {
  font-size: 28rpx;
  color: #999999;
  padding: 10rpx;
}

.filter-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.filter-btn-active {
  background-color: #2c3e50;
}

.filter-btn-active .filter-icon {
  color: #ffffff;
}

.filter-icon {
  font-size: 32rpx;
  color: #666666;
}

/* 当前筛选条件 */
.active-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.filter-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background-color: #2c3e50;
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.filter-tag-remove {
  font-size: 20rpx;
  opacity: 0.8;
}

/* 筛选面板 */
.filter-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.filter-panel {
  width: 100%;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx;
  box-sizing: border-box;
}

.filter-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 30rpx;
  text-align: center;
}

.filter-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-label {
  font-size: 30rpx;
  color: #333333;
}

.filter-value {
  font-size: 30rpx;
  color: #666666;
}

.filter-input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
}

.filter-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.filter-reset-btn {
  flex: 1;
  background-color: #f5f5f5;
  color: #666666;
  border-radius: 16rpx;
  font-size: 30rpx;
  border: none;
}

.filter-reset-btn::after {
  border: none;
}

.filter-apply-btn {
  flex: 1;
  background-color: #2c3e50;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  border: none;
  font-weight: bold;
}

.filter-apply-btn::after {
  border: none;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 80rpx 0;
  color: #999999;
  font-size: 26rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  display: block;
  margin-bottom: 32rpx;
}

.btn-add {
  background-color: #2c3e50;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 60rpx;
  font-size: 30rpx;
  display: inline-block;
  border: none;
  font-weight: bold;
}

.btn-add::after {
  border: none;
}

/* 攀岩场次卡片 */
.session-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.15s ease;
}

.session-card:active {
  transform: scale(0.98);
}

.session-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.session-date {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
}

.session-location {
  font-size: 26rpx;
  color: #999999;
}

/* 统计数据行 */
.session-stats {
  display: flex;
  justify-content: space-around;
  padding: 8rpx 0;
}

.session-stat {
  text-align: center;
}

.session-stat-num {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 6rpx;
}

.session-stat-success {
  color: #4caf50;
}

.session-stat-project {
  color: #2196f3;
}

.session-stat-label {
  display: block;
  font-size: 22rpx;
  color: #999999;
}

/* 备注摘要 */
.session-notes {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 26rpx;
  color: #666666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 加载更多 */
.loading-more,
.no-more {
  text-align: center;
  padding: 30rpx 0;
  color: #999999;
  font-size: 26rpx;
}

/* 底部占位 */
.fab-placeholder {
  height: 120rpx;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background-color: #2c3e50;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(44, 62, 80, 0.35);
  z-index: 100;
}

.fab-icon {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: bold;
}
