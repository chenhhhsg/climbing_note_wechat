<!--
  首页 - 训练入口（开始/继续本场）与最近记录
  训练入口只依赖本机档案，先于旧云请求渲染；旧记录区失败或延迟都不遮住它。
-->
<view class="container">
  <view class="field-cover">
    <image class="field-cover-image" src="/images/field-cover.jpg" mode="aspectFill" aria-hidden="true" />
    <view class="field-cover-title"><text>岩馆</text><text>手册</text></view>
  </view>
  <!-- 训练入口：开始训练 / 继续本场 -->
  <view id="training-entry" class="training-entry">
    <view class="field-section-head"><view class="field-mark"></view><text class="field-section-name">本次训练</text></view>
    <view wx:if="{{hasActiveSession}}" class="training-current">
      <view class="training-current-head">
        <text class="training-gym">{{activeSession.gymName}}</text>
        <text class="training-date">{{activeSession.dateText}} · {{activeSession.label}}</text>
      </view>
      <text class="training-route">当前线路 · {{activeSession.routeName || '还没选线路'}} · 本场 {{activeSession.attemptCountText}}</text>
      <view class="training-actions">
        <button id="continue-training" class="btn-training" bindtap="continueTraining">继续本场</button>
        <button id="start-training" class="btn-training-secondary" bindtap="startTraining">另开一场</button>
      </view>
    </view>

    <view wx:else class="training-empty">
      <text class="training-hint">从自己的岩馆开始一场，按线路逐把记录。</text>
      <button id="start-training" class="btn-training" bindtap="startTraining">开始训练</button>
    </view>

    <text wx:if="{{archiveError}}" id="archive-error" class="training-error">{{archiveError}}</text>
  </view>

  <!--
    下次想爬（T027）：按岩馆分组的收藏清单，只读。
    点开某一条回到它的长期线路详情，按原线路 ID 看照片、把次与历史并继续记。
  -->
  <view id="wishlist-entry" class="section wishlist-entry">
    <view class="section-header">
      <text class="section-title">下次想爬</text>
      <text wx:if="{{wishlistCountText}}" id="wishlist-count" class="section-more">{{wishlistCountText}}</text>
    </view>

    <view wx:if="{{wishlistError}}" id="wishlist-error" class="cloud-error">
      <text class="cloud-error-text">下次想爬暂不可读：{{wishlistError}}</text>
      <text class="empty-hint">原清单与训练记录保持原样；先开始或继续一场训练不受影响。</text>
    </view>

    <view wx:elif="{{!hasWishlist}}" id="wishlist-empty" class="empty-state wishlist-empty">
      <text class="empty-text">还没有想爬的线</text>
      <text class="empty-hint">在岩馆把想继续的线加入清单后，下次进馆从这里直接找到原线。</text>
    </view>

    <block wx:else>
      <view wx:for="{{wishlistGroups}}" wx:key="gymId" id="wishlist-gym-{{item.gymId}}" class="wishlist-gym">
        <view class="wishlist-gym-head">
          <text class="wishlist-gym-name">{{item.gymName}}</text>
          <text class="wishlist-gym-count">{{item.countText}}</text>
        </view>
        <view
          wx:for="{{item.items}}"
          wx:for-item="route"
          wx:key="routeId"
          id="wishlist-{{route.routeId}}"
          class="wishlist-line"
          data-route-id="{{route.routeId}}"
          bindtap="openWishlistRoute"
        >
          <view class="route-swatch" style="background: {{route.colorHex}};"></view>
          <view class="wishlist-line-info">
            <view class="wishlist-line-head">
              <text class="wishlist-line-name">{{route.name}}</text>
              <text
                id="wishlist-state-{{route.routeId}}"
                class="wishlist-line-state wishlist-line-state-{{route.status}}"
              >{{route.statusText}}</text>
            </view>
            <text class="wishlist-line-meta">{{route.climbType}} {{route.grade}}{{route.colorName ? ' · ' + route.colorName : ''}} · 累计 {{route.attemptCountText}}</text>
            <text wx:if="{{route.hasNote}}" class="wishlist-line-note">最近备注：{{route.latestNote}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 旧记录区域（云端旧汇总，只读回看；与本机训练分开） -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">旧记录</text>
      <text class="section-more" bindtap="goToList">查看全部 ›</text>
    </view>

    <!-- 旧云读取失败：只影响本区，训练入口照常可用 -->
    <view wx:if="{{cloudState === 'error'}}" id="cloud-error" class="cloud-error">
      <text class="cloud-error-text">{{cloudError}}</text>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="loading-state">
      <text>加载中...</text>
    </view>

    <!-- 无数据状态 -->
    <view wx:elif="{{isEmpty}}" class="empty-state">

      <text class="empty-text">还没有旧记录</text>
      <text class="empty-hint">早期的云端记录会出现在这里。</text>
    </view>

    <!-- 记录列表 -->
    <view wx:else class="record-list">
      <view
        wx:for="{{recentRecords}}"
        wx:key="_id"
        class="record-item"
        bindtap="goToDetail"
        data-id="{{item._id}}"
      >
        <view class="record-left">
          <view class="record-date">{{item.dateText}}</view>
          <view class="record-location">{{item.location || '未填写地点'}}</view>
        </view>
        <view class="record-right">
          <view class="record-grade">{{item.grade || '-'}}</view>
          <view class="record-type">{{item.climbType}}</view>
        </view>
        <view class="record-status {{item.status === '完成' ? 'status-success' : 'status-fail'}}">
          {{item.status}}
        </view>
      </view>
    </view>
    <view class="quick-actions">
      <button id="add-legacy-record" class="btn-add" bindtap="goToAddRecord">
        <text class="btn-icon">+</text>
        <text class="btn-text">添加旧记录</text>
      </button>
    </view>
  </view>
</view>
