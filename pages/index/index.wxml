<!--
  首页 - 显示最近记录和快捷添加按钮
-->
<view class="container">
  <!-- 头部欢迎区域 -->
  <view class="header">
    <view class="welcome-text">攀岩记录</view>
    <view class="subtitle">记录每一次攀登</view>
  </view>

  <!-- 快捷操作区域 -->
  <view class="quick-actions">
    <button class="btn-add" bindtap="goToAddRecord">
      <text class="btn-icon">+</text>
      <text class="btn-text">添加记录</text>
    </button>
  </view>

  <!-- 最近记录区域 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">最近记录</text>
      <text class="section-more" bindtap="goToList">查看全部 ></text>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="loading-state">
      <text>加载中...</text>
    </view>

    <!-- 无数据状态 -->
    <view wx:elif="{{isEmpty}}" class="empty-state">
      <text class="empty-icon">🧗</text>
      <text class="empty-text">还没有攀岩记录</text>
      <text class="empty-hint">点击上方按钮开始记录吧</text>
    </view>

    <!-- 记录列表 -->
    <view wx:else class="record-list">
      <view
        wx:for="{{recentRecords}}"
        wx:key="_id"
        class="record-item"
        bindtap="goToDetail"
        data-id="{{item._id}}"
      >
        <view class="record-left">
          <view class="record-date">{{item.dateText}}</view>
          <view class="record-location">{{item.location || '未填写地点'}}</view>
        </view>
        <view class="record-right">
          <view class="record-grade">{{item.grade || '-'}}</view>
          <view class="record-type">{{item.climbType}}</view>
        </view>
        <view class="record-status {{item.status === '完成' ? 'status-success' : 'status-fail'}}">
          {{item.status}}
        </view>
      </view>
    </view>
  </view>
</view>
