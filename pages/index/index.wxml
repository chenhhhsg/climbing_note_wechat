<!--
  首页 - 显示基础统计和最近记录
-->
<view class="container">
  <!-- 头部欢迎区域 -->
  <view class="header">
    <view class="welcome-text">攀笔</view>
    <view class="subtitle">记录每一次攀登</view>
  </view>

  <!-- 快捷操作区域 -->
  <view class="quick-actions">
    <button class="btn-add" bindtap="goToAddRecord">
      <text class="btn-icon">+</text>
      <text class="btn-text">添加记录</text>
    </button>
  </view>

  <!-- 基础统计卡片 -->
  <view class="stats-section" bindtap="goToStats">
    <view class="stats-header">
      <text class="stats-title">本月数据</text>
      <text class="stats-more">查看详情 ></text>
    </view>
    <view wx:if="{{statsLoading}}" class="stats-loading">
      <text>加载中...</text>
    </view>
    <view wx:else class="stats-grid">
      <view class="stats-item">
        <text class="stats-number">{{stats.monthClimbs}}</text>
        <text class="stats-label">攀岩次数</text>
      </view>
      <view class="stats-item">
        <text class="stats-number">{{stats.maxGrade}}</text>
        <text class="stats-label">最高难度</text>
      </view>
      <view class="stats-item">
        <text class="stats-number">{{stats.completionRate}}%</text>
        <text class="stats-label">完成率</text>
      </view>
    </view>
  </view>

  <!-- 最近记录区域 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">最近记录</text>
      <text class="section-more" bindtap="goToList">查看全部 ></text>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="loading-state">
      <text>加载中...</text>
    </view>

    <!-- 无数据状态 -->
    <view wx:elif="{{isEmpty}}" class="empty-state">
      <text class="empty-icon">🧗</text>
      <text class="empty-text">还没有攀岩记录</text>
      <text class="empty-hint">点击上方按钮开始记录吧</text>
    </view>

    <!-- 记录列表 -->
    <view wx:else class="record-list">
      <view
        wx:for="{{recentRecords}}"
        wx:key="_id"
        class="record-item"
        bindtap="goToDetail"
        data-id="{{item._id}}"
      >
        <view class="record-left">
          <view class="record-date">{{item.dateText}}</view>
          <view class="record-location">{{item.location || '未填写地点'}}</view>
        </view>
        <view class="record-right">
          <view class="record-grade">{{item.grade || '-'}}</view>
          <view class="record-type">{{item.climbTypeLabel}}</view>
        </view>
        <view class="record-status {{item.isCompleted ? 'status-success' : 'status-fail'}}">
          {{item.statusLabel}}
        </view>
      </view>
    </view>
  </view>
</view>
