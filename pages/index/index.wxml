<!--
  首页 - 显示基础统计和最近攀岩场次
-->
<view class="container">
  <!-- 头部欢迎区域 -->
  <view class="header">
    <view class="welcome-text">攀笔</view>
    <view class="subtitle">攀笔——记录你的攀岩进步</view>
  </view>

  <!-- 快捷操作区域 -->
  <view class="quick-actions">
    <button class="btn-add" bindtap="goToAddRecord">
      <text class="btn-icon">+</text>
      <text class="btn-text">添加攀岩</text>
    </button>
  </view>

  <!-- 基础统计卡片 -->
  <view class="stats-section" bindtap="goToStats">
    <view class="stats-header">
      <text class="stats-title">本月数据</text>
      <text class="stats-more">查看详情 ></text>
    </view>
    <view wx:if="{{statsLoading}}" class="stats-loading">
      <text>加载中...</text>
    </view>
    <view wx:else class="stats-grid">
      <view class="stats-item">
        <text class="stats-number">{{stats.monthSessions}}</text>
        <text class="stats-label">进馆次数</text>
      </view>
      <view class="stats-item">
        <text class="stats-number">{{stats.monthRoutes}}</text>
        <text class="stats-label">线路数</text>
      </view>
      <view class="stats-item">
        <text class="stats-number">{{stats.maxGrade}}</text>
        <text class="stats-label">最高难度</text>
      </view>
      <view class="stats-item">
        <text class="stats-number">{{stats.completionRate}}%</text>
        <text class="stats-label">完成率</text>
      </view>
    </view>
  </view>

  <!-- 最近攀岩场次 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">最近攀岩</text>
      <text class="section-more" bindtap="goToList">查看全部 ></text>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="loading-state">
      <text>加载中...</text>
    </view>

    <!-- 无数据状态 -->
    <view wx:elif="{{isEmpty}}" class="empty-state">
      <text class="empty-icon">🧗</text>
      <text class="empty-text">还没有攀岩记录</text>
      <text class="empty-hint">点击上方按钮开始记录吧</text>
    </view>

    <!-- 攀岩场次列表 -->
    <view wx:else class="session-list">
      <view
        wx:for="{{recentSessions}}"
        wx:key="_id"
        class="session-card"
        bindtap="goToDetail"
        data-id="{{item._id}}"
      >
        <view class="session-header">
          <text class="session-date">{{item.dateText}}</text>
          <text class="session-location">{{item.location || '未填写地点'}}</text>
        </view>
        <view class="session-stats">
          <view class="session-stat">
            <text class="session-stat-num">{{item.routeCount}}</text>
            <text class="session-stat-label">线路</text>
          </view>
          <view class="session-stat">
            <text class="session-stat-num session-stat-success">{{item.completedCount}}</text>
            <text class="session-stat-label">完成</text>
          </view>
          <view class="session-stat">
            <text class="session-stat-num">{{item.maxGrade}}</text>
            <text class="session-stat-label">最高</text>
          </view>
          <view class="session-stat">
            <text class="session-stat-num">{{item.completionRate}}%</text>
            <text class="session-stat-label">完成率</text>
          </view>
        </view>
        <view wx:if="{{item.notes}}" class="session-notes">{{item.notes}}</view>
      </view>
    </view>
  </view>
</view>
