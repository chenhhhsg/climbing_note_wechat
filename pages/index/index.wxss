/**
 * 首页样式
 */

/* 头部区域 */
.header {
  padding: 40rpx 0 30rpx;
}

.welcome-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #2c3e50;
}

.subtitle {
  font-size: 28rpx;
  color: #999999;
  margin-top: 10rpx;
}

/* 快捷操作区域 */
.quick-actions {
  margin-bottom: 40rpx;
}

.btn-add {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #2c3e50;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  font-size: 32rpx;
  border: none;
}

.btn-add::after {
  border: none;
}

.btn-icon {
  font-size: 48rpx;
  margin-right: 15rpx;
  font-weight: bold;
}

.btn-text {
  font-size: 32rpx;
}

/* 区域标题 */
.section {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2c3e50;
}

.section-more {
  font-size: 26rpx;
  color: #999999;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 60rpx 0;
  color: #999999;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
  background-color: #ffffff;
  border-radius: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666666;
  display: block;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999999;
  display: block;
}

/* 记录列表 */
.record-item {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.record-left {
  flex: 1;
}

.record-date {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.record-location {
  font-size: 26rpx;
  color: #999999;
}

.record-right {
  text-align: right;
  margin-right: 20rpx;
}

.record-grade {
  font-size: 34rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.record-type {
  font-size: 24rpx;
  color: #999999;
}

.record-status {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.status-success {
  background-color: #e8f5e9;
  color: #4caf50;
}

.status-fail {
  background-color: #ffebee;
  color: #f44336;
}

/* 训练入口：开始训练 / 继续本场（只依赖本机档案） */
.training-entry {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.training-current-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10rpx;
}

.training-gym {
  font-size: 34rpx;
  font-weight: bold;
  color: #2c3e50;
}

.training-date {
  font-size: 24rpx;
  color: #999999;
}

.training-route {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 20rpx;
}

.training-hint {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 20rpx;
}

.btn-training {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #2c3e50;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 32rpx;
  border: none;
}

.btn-training::after {
  border: none;
}

.btn-training-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
  color: #2c3e50;
  border: 2rpx solid #2c3e50;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  margin-top: 16rpx;
}

.btn-training-secondary::after {
  border: none;
}

.training-error {
  display: block;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background-color: #ffebee;
  color: #f44336;
  border-radius: 12rpx;
  font-size: 24rpx;
}

/* 旧云记录读取失败：只影响本区 */
.cloud-error {
  background-color: #fff8e1;
  color: #8d6e63;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
}
