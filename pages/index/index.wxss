/**
 * 首页样式
 */

/* 头部区域 */
.header {
  padding: 48rpx 32rpx 56rpx;
  background: linear-gradient(135deg, #2c3e50 0%, #3d566e 100%);
  border-radius: 0 0 32rpx 32rpx;
  margin: -20rpx -20rpx 24rpx;
}

.welcome-text {
  font-size: 52rpx;
  font-weight: bold;
  color: #ffffff;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 10rpx;
}

/* 快捷操作区域 */
.quick-actions {
  margin-bottom: 24rpx;
}

.btn-add {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #2c3e50;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 32rpx;
  border: none;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(44, 62, 80, 0.3);
}

.btn-add::after {
  border: none;
}

.btn-icon {
  font-size: 44rpx;
  margin-right: 12rpx;
  font-weight: bold;
}

.btn-text {
  font-size: 32rpx;
}

/* 统计区域 */
.stats-section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.stats-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
}

.stats-more {
  font-size: 26rpx;
  color: #999999;
}

.stats-loading {
  text-align: center;
  padding: 24rpx 0;
  color: #999999;
  font-size: 26rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stats-item {
  text-align: center;
}

.stats-number {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 6rpx;
}

.stats-label {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

/* 区域标题 */
.section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
}

.section-more {
  font-size: 26rpx;
  color: #999999;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 80rpx 0;
  color: #999999;
  font-size: 26rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.empty-icon {
  font-size: 96rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  display: block;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999999;
  display: block;
}

/* 攀岩场次卡片 */
.session-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.15s ease;
}

.session-card:active {
  transform: scale(0.98);
}

.session-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.session-date {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
}

.session-location {
  font-size: 26rpx;
  color: #999999;
}

.session-stats {
  display: flex;
  justify-content: space-around;
  padding: 8rpx 0;
}

.session-stat {
  text-align: center;
}

.session-stat-num {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 6rpx;
}

.session-stat-success {
  color: #4caf50;
}

.session-stat-label {
  display: block;
  font-size: 22rpx;
  color: #999999;
}

.session-notes {
  font-size: 26rpx;
  color: #666666;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
