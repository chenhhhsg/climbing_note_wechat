/**
 * 首页样式
 */

/* 头部区域 */
.header {
  padding: 40rpx 30rpx 50rpx;
  background: linear-gradient(135deg, #2c3e50 0%, #3d566e 100%);
  border-radius: 0 0 32rpx 32rpx;
  margin: -20rpx -20rpx 30rpx;
}

.welcome-text {
  font-size: 52rpx;
  font-weight: bold;
  color: #ffffff;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 10rpx;
}

/* 快捷操作区域 */
.quick-actions {
  margin-bottom: 30rpx;
}

.btn-add {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #2c3e50;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  font-size: 32rpx;
  border: none;
}

.btn-add::after {
  border: none;
}

.btn-icon {
  font-size: 48rpx;
  margin-right: 15rpx;
  font-weight: bold;
}

.btn-text {
  font-size: 32rpx;
}

/* 统计区域 */
.stats-section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.stats-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
}

.stats-more {
  font-size: 26rpx;
  color: #999999;
}

.stats-loading {
  text-align: center;
  padding: 30rpx 0;
  color: #999999;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stats-item {
  text-align: center;
}

.stats-number {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.stats-label {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

/* 区域标题 */
.section {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2c3e50;
}

.section-more {
  font-size: 26rpx;
  color: #999999;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 60rpx 0;
  color: #999999;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
  background-color: #ffffff;
  border-radius: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666666;
  display: block;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999999;
  display: block;
}

/* 记录列表 */
.record-item {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  position: relative;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.2s ease;
}

.record-item:active {
  transform: scale(0.98);
}

.record-left {
  flex: 1;
}

.record-date {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.record-location {
  font-size: 26rpx;
  color: #999999;
}

.record-right {
  text-align: right;
  margin-right: 20rpx;
}

.record-grade {
  font-size: 34rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.record-type {
  font-size: 24rpx;
  color: #999999;
}

.record-status {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.status-success {
  background-color: #e8f5e9;
  color: #4caf50;
}

.status-fail {
  background-color: #ffebee;
  color: #f44336;
}
