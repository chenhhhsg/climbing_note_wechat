/**
 * 首页样式
 */

/* 头部区域 */
.header {
  padding: 40rpx 0 30rpx;
}

.welcome-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #173d32;
}

.subtitle {
  font-size: 28rpx;
  color: #606d61;
  margin-top: 10rpx;
}

/* 快捷操作区域 */
.quick-actions {
  margin-bottom: 40rpx;
}

.btn-add {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #173d32;
  color: #fffcf3;
  border-radius: 16rpx;
  padding: 30rpx;
  font-size: 32rpx;
  border: none;
}

.btn-add::after {
  border: none;
}

.btn-icon {
  font-size: 48rpx;
  margin-right: 15rpx;
  font-weight: bold;
}

.btn-text {
  font-size: 32rpx;
}

/* 区域标题 */
.section {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #173d32;
}

.section-more {
  font-size: 26rpx;
  color: #606d61;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 60rpx 0;
  color: #606d61;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
  background-color: #fffcf3;
  border-radius: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #526157;
  display: block;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #606d61;
  display: block;
}

/* 记录列表 */
.record-item {
  display: flex;
  align-items: center;
  background-color: #fffcf3;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.record-left {
  flex: 1;
}

.record-date {
  font-size: 30rpx;
  font-weight: bold;
  color: #173d32;
  margin-bottom: 8rpx;
}

.record-location {
  font-size: 26rpx;
  color: #606d61;
}

.record-right {
  text-align: right;
  margin-right: 20rpx;
}

.record-grade {
  font-size: 34rpx;
  font-weight: bold;
  color: #173d32;
  margin-bottom: 8rpx;
}

.record-type {
  font-size: 24rpx;
  color: #606d61;
}

.record-status {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.status-success {
  background-color: #e2ebda;
  color: #2f6248;
}

.status-fail {
  background-color: #f7e6db;
  color: #9c3d22;
}

/* 训练入口：开始训练 / 继续本场（只依赖本机档案） */
.training-entry {
  background-color: #FFFFFF;
  border: 1px solid #D7DED9;
  border-radius: 8rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 24rpx;
}

.training-current-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10rpx;
}

.training-gym {
  font-size: 34rpx;
  font-weight: 700;
  color: #182421;
}

.training-date {
  font-size: 24rpx;
  color: #53615B;
}

.training-route {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #53615B;
  margin-bottom: 20rpx;
}

.training-hint {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #53615B;
  margin-bottom: 20rpx;
}

.btn-training {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #1F5948;
  color: #FFFFFF;
  border: none;
  border-radius: 8rpx;
  padding: 20rpx 26rpx;
  font-size: 32rpx;
  font-weight: 650;
  min-height: 44px;
  box-sizing: border-box;
}

.btn-training::after {
  border: none;
}

.btn-training-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FFFFFF;
  color: #1F5948;
  border: 2rpx solid #1F5948;
  border-radius: 8rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  margin-top: 16rpx;
}

.btn-training-secondary::after {
  border: none;
}

.training-error {
  display: block;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background-color: #f7e6db;
  color: #9c3d22;
  border-radius: 12rpx;
  font-size: 24rpx;
}

/* 旧云记录读取失败：只影响本区；原因与重试同屏，入口保持可操作 */
.cloud-error {
  background-color: #f3edda;
  color: #745241;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
}
.cloud-error-text { display:block; line-height:1.6; }
.btn-cloud-retry {
  margin:16rpx 0 0;
  min-height:44px;
  box-sizing:border-box;
  width:auto;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:0 32rpx;
  background:#FFFFFF;
  color:#1F5948;
  border:2rpx solid #1F5948;
  border-radius:8rpx;
  font-size:26rpx;
  line-height:1.35;
}

/* 岩馆手册 */
.container { padding: 12rpx 32rpx 48rpx; }
/* T063 U4：压缩品牌封面（334rpx → 176rpx），让训练主入口更早出现，保留原图与标题。 */
.field-cover { position:relative; overflow:hidden; border-radius:6rpx; height:176rpx; background:#173d32; margin-bottom:20rpx; }
.field-cover-image { position:absolute; width:100%; height:100%; }
.field-cover-title { position:absolute; left:24rpx; top:20rpx; color:#ffedc2; font:700 52rpx/1.04 "Songti SC","Noto Serif CJK SC","SimSun",serif; letter-spacing:3rpx; }
.field-cover-title text { display:block; }
.training-entry { padding:24rpx 20rpx; background:#FFFFFF; border:1px solid #D7DED9; margin:0 0 16rpx; border-radius:8rpx; }
.field-section-head { border-bottom:2rpx solid #1F5948; padding-bottom:15rpx; margin-bottom:22rpx; }
/* 上次训练沿用同一张卡片，只用既有橙色点出与今天的差别。 */
.training-entry-previous .field-section-head { border-bottom-color:#944424; }
.training-entry-previous .field-mark { background:#944424; }
.training-current-head { align-items:center; flex-wrap:wrap; gap:6rpx 18rpx; }
.training-gym { font-size:34rpx; font-weight:700; color:#173d32; }
.training-date,.record-date { font-family:"IBM Plex Mono",Consolas,"PingFang SC","Microsoft YaHei",sans-serif; }
.training-date { font-size:24rpx; }
.training-route,.training-hint { color:#526157; font-size:27rpx; line-height:1.6; margin-bottom:22rpx; }
.btn-training,.btn-training-secondary { min-height:44px; box-sizing:border-box; width:100%; margin-left:0; display:flex; align-items:center; line-height:1.35; }
.btn-training { background:#1F5948; color:#FFFFFF; padding:20rpx 26rpx; justify-content:space-between; border-radius:8rpx; font-weight:650; }
.btn-training::before { content:""; position:absolute; right:30rpx; width:15rpx; height:15rpx; border-right:4rpx solid #FFFFFF; border-top:4rpx solid #FFFFFF; transform:rotate(45deg); }
.btn-add { background:transparent; color:#173d32; border:0; padding:16rpx 0; justify-content:flex-start; font-size:26rpx; }
.btn-training-secondary { margin:0; color:#1F5948; background:#FFFFFF; border:2rpx solid #1F5948; }
.quick-actions { margin:0 0 32rpx; border-bottom:1px solid #c4c7b6; }
.btn-icon { font-size:32rpx; color:#944424; margin-right:12rpx; }
.btn-text { font-size:26rpx; }
.section-header { column-gap:8rpx; flex-wrap:wrap; }
.section-title { font-size:38rpx; }
.record-item { background:transparent; border-radius:0; padding:20rpx 0; margin:0; border-bottom:1px solid #d2d3c4; }
.record-date,.record-grade { color:#173d32; }
.cloud-error,.empty-state { background:#edece0; text-align:left; border-radius:6rpx; padding:20rpx 24rpx; }
.training-entry { padding:24rpx 20rpx; margin:0 0 20rpx; border:1px solid #D7DED9; border-radius:8rpx; background:#FFFFFF; }
.training-actions { display:flex; align-items:stretch; gap:16rpx; }
.training-entry button.btn-training { width:100%; min-width:0; min-height:44px; margin:0; box-sizing:border-box; }
.training-actions button.btn-training { flex:1; width:auto; }
.training-actions button.btn-training-secondary { flex:none; width:auto; min-height:44px; padding:0 20rpx; }
.quick-actions { margin:6rpx 0 0; border:0; }
.quick-actions button.btn-add { width:auto; min-height:44px; margin:0; justify-content:flex-start; }

/* 下次想爬（T035 / T037）：首页只有一行（名称 + 数量 + 进入箭头）；整份清单在独立页 */
.wishlist-entry { display:block; min-height:44px; box-sizing:border-box; padding:22rpx 0; margin:0 0 16rpx; border-bottom:1px solid #D7DED9; }
.wishlist-entry-row { display:flex; align-items:baseline; justify-content:space-between; gap:16rpx; }
.wishlist-entry-title { font-weight:700; font-size:34rpx; color:#182421; }
.wishlist-entry-right { flex:none; display:flex; align-items:baseline; gap:10rpx; }
.wishlist-entry-count { font-family:"IBM Plex Mono",Consolas,"PingFang SC","Microsoft YaHei",sans-serif; font-size:26rpx; color:#53615B; }
.wishlist-entry-arrow { font-size:30rpx; color:#1F5948; }
.wishlist-entry-error { display:block; margin-top:8rpx; font-size:24rpx; line-height:1.6; color:#9c3d22; }
