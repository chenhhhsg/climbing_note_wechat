/**
 * 全局样式 - 攀笔攀岩记录小程序
 * 主色：#2c3e50
 * 辅助灰色：#999999
 * 背景：#f5f5f5
 * 卡片背景：#ffffff
 * 圆角：16rpx
 */

/* 重置默认样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  font-size: 28rpx;
  color: #333333;
  background-color: #f5f5f5;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

/* 通用容器 */
.container {
  padding: 20rpx;
  min-height: 100vh;
}

/* 卡片样式 */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 按钮样式 */
.btn-primary {
  background-color: #2c3e50;
  color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  text-align: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

/* 标题样式 */
.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 20rpx;
}

/* 次要文字 */
.text-secondary {
  color: #999999;
  font-size: 26rpx;
}

/* 空状态提示 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-right: 10rpx;
}

.tag-success {
  background-color: #e8f5e9;
  color: #4caf50;
}

.tag-warning {
  background-color: #fff3e0;
  color: #ff9800;
}

.tag-danger {
  background-color: #ffebee;
  color: #f44336;
}

.tag-info {
  background-color: #e3f2fd;
  color: #2196f3;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin: 20rpx 0;
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
