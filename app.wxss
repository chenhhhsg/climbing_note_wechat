/**
 * 全局样式
 */

/* 重置默认样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  font-size: 28rpx;
  color: #22372f;
  background-color: #f7f4ea;
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  padding: 20rpx;
  min-height: 100vh;
}

/* 卡片样式 */
.card {
  background-color: #fffcf3;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: none;
}

/* 按钮样式 */
.btn-primary {
  background-color: #173d32;
  color: #fffcf3;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  text-align: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

/* 标题样式 */
.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #173d32;
  margin-bottom: 20rpx;
}

/* 次要文字 */
.text-secondary {
  color: #606d61;
  font-size: 26rpx;
}

/* 空状态提示 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #606d61;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-right: 10rpx;
}

.tag-success {
  background-color: #e2ebda;
  color: #2f6248;
}

.tag-warning {
  background-color: #f6ead5;
  color: #934327;
}

.tag-danger {
  background-color: #f7e6db;
  color: #9c3d22;
}

.tag-info {
  background-color: #e4ebdf;
  color: #355e50;
}

/* 岩馆手册 */
page { color: #173d32; background: #f7f4ea; font-family: "PingFang SC","Microsoft YaHei",sans-serif; }
.container { box-sizing: border-box; padding: 32rpx; }
.field-section-head { display:flex; align-items:center; gap:14rpx; }
.field-mark,.field-menu-mark { width:16rpx; height:20rpx; background:#ff793f; border-radius:70% 36% 55% 42%; transform:rotate(25deg); flex:none; }
.field-section-name,.section-title,.card-title { font-family:"Songti SC","Noto Serif CJK SC","SimSun",serif; font-weight:700; }
.field-section-name { font-size:38rpx; }
button { box-sizing:border-box; }
