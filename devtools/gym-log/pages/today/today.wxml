<!--
  今日攀爬：独立本地试用页
  开始场次 → 按岩馆选线路 → 连续记两把 → 给第二把补备注。
  已选线路与本场尝试放在上方，点结果后立即能看到新的一条。
-->
<view class="page">
  <view class="trial-banner">
    <text class="trial-badge">{{trialBadge}}</text>
    <text class="trial-note">{{trialNote}}</text>
  </view>

  <!-- 本地缓存损坏：只显示错误与重置入口，避免覆盖后仍不清楚 -->
  <view wx:if="{{loadError}}" class="card error-card">
    <text class="error-title">本地数据读取失败</text>
    <text class="error-text">{{loadError}}</text>
    <view class="button-row">
      <button id="retry-load" class="secondary-button" bindtap="retryLoad">重试读取</button>
      <button id="reset-trial" class="secondary-button" bindtap="resetTrialData">重置本地试用数据</button>
    </view>
  </view>

  <block wx:else>
    <view class="page-header">
      <text class="page-title">今日攀爬</text>
      <text class="page-subtitle">下一把，趁动作还记得</text>
    </view>

    <!--
      弱网演练入口：本地模拟保存端，只影响下一次保存。
      账本与客户端待确认操作分开；重试复用同一操作 ID。
    -->
    <view id="weak-network-drill" class="card drill-card">
      <text class="card-title">弱网演练（本地模拟）</text>
      <text class="drill-hint">模拟保存端已入账、但回执丢失。仅作用于下一次保存；失败行保留原条目，重试沿用同一操作 ID。</text>
      <button
        id="arm-receipt-loss"
        class="secondary-button drill-button"
        bindtap="toggleReceiptLossArm"
      >{{faultInjectionArmed ? '取消模拟回执丢失' : '模拟下一次保存回执丢失'}}</button>
      <text wx:if="{{faultInjectionArmed}}" class="drill-armed">已就绪：下一次保存会写入模拟账本，但客户端收不到回执（仅一次）</text>
      <text wx:if="{{faultInjectionError}}" class="field-error">{{faultInjectionError}}</text>
    </view>

    <view wx:if="{{storageError}}" class="storage-error" bindtap="dismissStorageError">
      <text class="storage-error-text">{{storageError}}</text>
      <text class="storage-error-hint">当前操作未生效，请重试；点击可收起</text>
    </view>

    <!-- 照片提示：权限、成功保存等；不改变线路与尝试记录 -->
    <view
      wx:if="{{photoNotice}}"
      id="photo-notice"
      class="photo-notice"
      bindtap="dismissPhotoNotice"
    >
      <text class="photo-notice-text">{{photoNotice}}</text>
      <text class="photo-notice-hint">点击收起</text>
    </view>

    <!-- 照片空间：实际受管文件计量、提醒线与可重建缓存管理 -->
    <view wx:if="{{photoSpace}}" id="photo-space-card" class="card photo-space-card">
      <view class="photo-space-head">
        <text class="card-title">照片空间（本机试用）</text>
        <text class="photo-space-usage">{{photoSpace.usageText}}</text>
      </view>
      <view class="photo-space-track">
        <view
          class="photo-space-fill {{photoSpace.over ? 'photo-space-fill-over' : (photoSpace.warn ? 'photo-space-fill-warn' : '')}}"
          style="width: {{photoSpace.percent}}%;"
        ></view>
      </view>
      <text wx:if="{{photoSpace.detailText}}" class="photo-space-detail">{{photoSpace.detailText}}</text>
      <text wx:if="{{photoSpace.currentDatasetText}}" class="photo-space-detail">{{photoSpace.currentDatasetText}}</text>
      <text wx:if="{{photoSpace.warningText}}" id="photo-space-warn" class="photo-space-warn">{{photoSpace.warningText}}</text>
      <text wx:if="{{photoSpace.missingThumbText}}" class="photo-space-hint">{{photoSpace.missingThumbText}}</text>
      <text wx:if="{{photoSpace.errorText}}" class="photo-space-error">{{photoSpace.errorText}}</text>

      <view class="photo-space-actions">
        <button
          id="photo-space-manage"
          class="secondary-button photo-space-action"
          bindtap="togglePhotoSpaceManage"
        >{{photoSpaceExpanded ? '收起管理' : '管理照片空间'}}</button>
        <button
          id="photo-space-clear-cache"
          class="secondary-button photo-space-action"
          bindtap="clearPhotoCache"
        >清除可重建缓存</button>
      </view>

      <view wx:if="{{photoSpaceExpanded}}" id="photo-space-details" class="photo-space-details">
        <text class="photo-space-hint">预算 {{photoSpace.budgetText}} · 提醒线 {{photoSpace.warnText}} · 更换余量 {{photoSpace.reserveText}}（应用自设上限，不是设备可用空间保证）</text>
        <text class="photo-space-hint">普通清缓存只删除可重建缩略图；主图、照片索引、场次、尝试、备注和待确认操作均保留。</text>
        <text wx:if="{{photoSpace.orphanText}}" class="photo-space-hint">{{photoSpace.orphanText}}</text>
        <view class="photo-space-actions">
          <button
            id="photo-space-rebuild"
            class="secondary-button photo-space-action"
            bindtap="rebuildPhotoThumbs"
          >重建缺失缩略图</button>
          <button
            id="photo-space-cleanup"
            class="secondary-button photo-space-action"
            bindtap="cleanupPhotoOrphans"
          >清理无引用文件</button>
        </view>
      </view>
    </view>

    <!-- 开始场次：日期默认今天，可选历史日期回放跨天 -->
    <view wx:if="{{sessionFormVisible}}" class="card session-form">
      <text class="card-title">{{sessionFormTitle}}</text>
      <view class="field">
        <text class="field-label">岩馆</text>
        <picker
          mode="selector"
          range="{{gyms}}"
          range-key="name"
          value="{{formGymIndex}}"
          bindchange="onGymChange"
        >
          <view class="picker-value">{{formGymName}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">日期</text>
        <picker mode="date" value="{{formDate}}" bindchange="onDateChange">
          <view class="picker-value">{{formDate}}</view>
        </picker>
      </view>
      <text wx:if="{{formError}}" class="field-error">{{formError}}</text>
      <button id="start-session" class="primary-button" bindtap="startSession">开始场次</button>
      <button
        wx:if="{{activeSession}}"
        class="text-button"
        bindtap="cancelSessionForm"
      >取消</button>
    </view>

    <block wx:if="{{activeSession}}">
      <view class="card session-card">
        <view class="session-top">
          <view class="session-heading">
            <text class="card-title">{{activeSession.gymName}}</text>
            <text class="session-meta">{{activeSession.dateText}} · {{activeSession.label}}</text>
          </view>
          <button id="open-session-form" class="text-button session-new" bindtap="openSessionForm">
            开始新场次
          </button>
        </view>

        <view wx:if="{{sameDaySessions.length > 1}}" class="session-switch">
          <text class="field-label">本日场次归属</text>
          <view class="chip-row">
            <view
              wx:for="{{sameDaySessions}}"
              wx:key="id"
              id="session-chip-{{item.id}}"
              class="chip {{item.isActive ? 'chip-active' : ''}}"
              data-session-id="{{item.id}}"
              bindtap="switchSession"
            >{{item.label}}</view>
          </view>
        </view>
      </view>

      <!-- 已选线路与本场尝试靠前，点结果后即时可见 -->
      <view wx:if="{{selectedRoute}}" class="section current-route">
        <text class="section-title">本场记录</text>
        <view class="selected-route">
          <view class="route-swatch" style="background: {{selectedRoute.colorHex}};"></view>
          <view class="selected-route-info">
            <text class="selected-route-name">{{selectedRoute.name}}</text>
            <text class="selected-route-meta">{{selectedRoute.climbType}} {{selectedRoute.grade}} · 本场 {{routeCountText}}</text>
            <text
              wx:if="{{routeStateText}}"
              id="selected-route-state"
              class="route-state {{routeCompleted ? 'route-state-done' : 'route-state-pending'}}"
            >{{routeStateText}}</text>
          </view>
          <button
            id="selected-route-detail"
            class="text-button route-detail-link"
            data-route-id="{{selectedRoute.id}}"
            bindtap="openRouteDetail"
          >详情</button>
        </view>

        <!--
          线路照片：每条线路至多一张主照片，可选。
          选择后先预览，确认才保存；保存中/失败不锁住下方记尝试按钮。
        -->
        <view wx:if="{{routePhoto}}" id="route-photo-card" class="photo-card">
          <view class="photo-head">
            <text class="photo-title">线路照片</text>
            <text class="photo-note">本机试用 · 照片保存在本机</text>
          </view>

          <block wx:if="{{routePhoto.status === 'saved'}}">
            <image
              id="photo-thumb"
              class="photo-thumb"
              src="{{routePhoto.thumbnailPath}}"
              mode="aspectFill"
              data-route-id="{{selectedRoute.id}}"
              bindtap="previewRoutePhoto"
            />
            <text class="photo-status">{{routePhoto.statusText}}</text>
            <text wx:if="{{routePhoto.bytesText}}" class="photo-meta">{{routePhoto.bytesText}}</text>
            <view class="photo-actions">
              <button
                id="photo-preview"
                class="secondary-button photo-action"
                data-route-id="{{selectedRoute.id}}"
                bindtap="previewRoutePhoto"
              >查看大图</button>
              <button
                id="photo-remove"
                class="text-button photo-remove"
                data-route-id="{{selectedRoute.id}}"
                bindtap="removeRoutePhoto"
              >移除照片</button>
            </view>
          </block>

          <block wx:elif="{{routePhoto.status === 'preview'}}">
            <image
              id="photo-preview-image"
              class="photo-preview"
              src="{{routePhoto.previewPath}}"
              mode="aspectFit"
            />
            <text class="photo-status">{{routePhoto.statusText}}</text>
            <view class="photo-actions">
              <button
                id="photo-cancel"
                class="secondary-button photo-action"
                data-route-id="{{selectedRoute.id}}"
                bindtap="cancelRoutePhoto"
              >取消</button>
              <button
                id="photo-confirm"
                class="primary-button photo-action"
                data-route-id="{{selectedRoute.id}}"
                bindtap="confirmRoutePhoto"
              >确认保存</button>
            </view>
          </block>

          <block wx:elif="{{routePhoto.status === 'saving'}}">
            <image
              wx:if="{{routePhoto.thumbnailPath}}"
              class="photo-thumb"
              src="{{routePhoto.thumbnailPath}}"
              mode="aspectFill"
            />
            <text id="photo-saving" class="photo-status photo-status-busy">{{routePhoto.statusText}}</text>
            <text class="photo-hint">照片文件和关联都写入后才提示成功；可以先继续记尝试。</text>
          </block>

          <block wx:elif="{{routePhoto.status === 'failed'}}">
            <image
              wx:if="{{routePhoto.thumbnailPath}}"
              class="photo-thumb"
              src="{{routePhoto.thumbnailPath}}"
              mode="aspectFill"
              data-route-id="{{selectedRoute.id}}"
              bindtap="previewRoutePhoto"
            />
            <text id="photo-error" class="photo-status photo-status-error">{{routePhoto.statusText}}</text>
            <text class="photo-error-detail">{{routePhoto.errorText}}</text>
            <view class="photo-actions">
              <button
                id="photo-retry"
                class="secondary-button photo-action"
                data-route-id="{{selectedRoute.id}}"
                bindtap="retryRoutePhoto"
              >{{routePhoto.retryText}}</button>
              <button
                id="photo-dismiss"
                class="text-button photo-remove"
                data-route-id="{{selectedRoute.id}}"
                bindtap="dismissRoutePhotoFailure"
              >收起</button>
            </view>
            <button
              wx:if="{{routePhoto.manageSpaceVisible}}"
              id="photo-space-open"
              class="secondary-button photo-action"
              bindtap="openPhotoSpaceManager"
            >{{routePhoto.manageSpaceText}}</button>
          </block>

          <block wx:elif="{{routePhoto.status === 'missing'}}">
            <text id="photo-missing" class="photo-status photo-status-error">本机照片不可用，可重新添加</text>
            <text class="photo-hint">照片文件可能已被系统清理；重新添加会替换原关联，尝试记录不变。</text>
          </block>

          <block wx:elif="{{routePhoto.status === 'error'}}">
            <text class="photo-status photo-status-error">{{routePhoto.statusText}}</text>
            <button
              class="secondary-button photo-action"
              data-route-id="{{selectedRoute.id}}"
              bindtap="reloadRoutePhoto"
            >重试读取</button>
          </block>

          <block wx:else>
            <text class="photo-status">{{routePhoto.statusText}}</text>
          </block>

          <!-- 拍照/相册只传来源参数；照片不是必填项，可稍后添加 -->
          <view wx:if="{{routePhoto.sourceVisible}}" class="photo-source-row">
            <button
              id="photo-camera"
              class="secondary-button photo-source"
              data-source="camera"
              data-route-id="{{selectedRoute.id}}"
              bindtap="chooseRoutePhoto"
            >{{routePhoto.cameraText}}</button>
            <button
              id="photo-album"
              class="secondary-button photo-source"
              data-source="album"
              data-route-id="{{selectedRoute.id}}"
              bindtap="chooseRoutePhoto"
            >{{routePhoto.albumText}}</button>
          </view>
        </view>

        <!-- 保存中、回执丢失等结果提示；点击可收起，待确认行本身仍保留 -->
        <view wx:if="{{saveNotice}}" id="save-notice" class="save-notice" bindtap="dismissSaveNotice">
          <text class="save-notice-text">{{saveNotice}}</text>
          <text class="save-notice-hint">点击收起</text>
        </view>

        <!-- 补备注：始终显示对应的线路与第几把 -->
        <view wx:if="{{noteEditor}}" id="note-editor" class="card note-editor">
          <text class="card-title">补备注</text>
          <text class="note-context">{{noteEditor.routeName}} · {{noteEditor.attemptLabel}} · {{noteEditor.resultText}}</text>
          <textarea
            id="note-input"
            class="note-input"
            value="{{noteEditor.text}}"
            placeholder="例如：抓到后向右摆"
            maxlength="120"
            bindinput="onNoteInput"
          ></textarea>
          <view class="button-row">
            <button class="secondary-button" bindtap="cancelNote">取消</button>
            <button id="save-note" class="primary-button" bindtap="saveNote">保存备注</button>
          </view>
        </view>

        <block wx:else>
          <view wx:if="{{!hasAttempts && !hasPending}}" class="empty-attempts">
            <text>还没有记录，从墙上下来后点一次结果。</text>
          </view>
          <view wx:for="{{attempts}}" wx:key="id" class="attempt-item">
            <view class="attempt-main">
              <text class="attempt-label">{{item.label}}</text>
              <text class="attempt-result">{{item.resultText}}</text>
              <text class="attempt-time">{{item.timeText}}</text>
            </view>
            <text wx:if="{{item.note}}" class="attempt-note">{{item.note}}</text>
            <button
              id="note-{{item.id}}"
              class="text-button attempt-note-button"
              data-attempt-id="{{item.id}}"
              bindtap="openNoteEditor"
            >{{item.hasNote ? '改备注' : '补备注'}}</button>
          </view>

          <!-- 待确认操作：保存中不可重复派发；失败后保留原条目，可在该行重试同一 ID -->
          <view
            wx:for="{{pendingAttempts}}"
            wx:key="opId"
            id="pending-{{item.opId}}"
            class="attempt-item pending-attempt"
          >
            <view class="attempt-main">
              <text class="attempt-label">{{item.label}}</text>
              <text class="attempt-result">{{item.resultText}}</text>
              <text class="attempt-time">{{item.timeText}}</text>
            </view>
            <view class="pending-footer">
              <text class="pending-status {{item.isSaving ? 'pending-status-saving' : 'pending-status-failed'}}">{{item.statusText}}</text>
              <button
                wx:if="{{!item.isSaving}}"
                id="retry-{{item.opId}}"
                class="text-button pending-retry"
                data-op-id="{{item.opId}}"
                bindtap="retryPendingAttempt"
              >重试保存</button>
            </view>
          </view>
        </block>
      </view>

      <view class="section">
        <text class="section-title">{{selectedRoute ? '换线路' : '选线路'}}</text>
        <view class="route-list">
          <view
            wx:for="{{routes}}"
            wx:key="id"
            id="route-{{item.id}}"
            class="route-item {{item.isSelected ? 'route-selected' : ''}}"
            data-route-id="{{item.id}}"
            bindtap="onRouteTap"
          >
            <view class="route-main">
              <view class="route-swatch" style="background: {{item.colorHex}};"></view>
              <!-- 历史选线入口：缩略图来自同一条持久主照片，点「加/换照片」进入照片操作 -->
              <image
                wx:if="{{item.photoThumb}}"
                id="route-thumb-{{item.id}}"
                class="route-photo-thumb"
                src="{{item.photoThumb}}"
                mode="aspectFill"
              />
              <view class="route-info">
                <text class="route-name">{{item.name}}</text>
                <text class="route-meta">{{item.climbType}} {{item.grade}} · {{item.colorName}}</text>
                <text wx:if="{{item.photoMissing}}" class="route-photo-missing">本机照片不可用</text>
              </view>
              <!-- 已完攀：历史项直接进入详情回看，不再转入新增流程 -->
              <text
                wx:if="{{item.completionText}}"
                id="route-state-{{item.id}}"
                class="route-state {{item.isCompleted ? 'route-state-done' : 'route-state-pending'}}"
              >{{item.completionText}}</text>
              <text wx:if="{{item.isSelected}}" class="route-check">已选</text>
            </view>
            <view class="route-actions">
              <button
                id="route-photo-{{item.id}}"
                class="text-button route-item-photo"
                data-route-id="{{item.id}}"
                catchtap="openRoutePhotoPicker"
              >{{item.photoButtonText}}</button>
              <button
                id="route-detail-{{item.id}}"
                class="text-button route-item-detail"
                data-route-id="{{item.id}}"
                catchtap="openRouteDetail"
              >详情</button>
            </view>
          </view>
        </view>

        <button class="text-button quick-route-toggle" bindtap="toggleQuickRoute">
          {{quickRouteVisible ? '收起新建线路' : '＋ 快速新建线路'}}
        </button>

        <view wx:if="{{quickRouteVisible}}" class="card quick-route-form">
          <input
            class="text-input"
            placeholder="线路名称，例如：蓝色动态线"
            value="{{quickRouteName}}"
            bindinput="onQuickRouteNameInput"
          />

          <!-- 新建线路可选一张照片，紧邻名称；跳过也能创建，照片失败不回滚线路 -->
          <view class="quick-route-photo">
            <text class="field-label">线路照片（可选）</text>
            <view wx:if="{{quickRoutePhoto}}" class="quick-photo-preview">
              <image
                id="quick-photo-preview"
                class="photo-preview"
                src="{{quickRoutePhoto.path}}"
                mode="aspectFit"
              />
              <text class="photo-status">{{quickRoutePhoto.statusText}}</text>
              <button
                id="quick-photo-cancel"
                class="text-button photo-remove"
                bindtap="cancelQuickRoutePhoto"
              >取消照片</button>
            </view>
            <view wx:else class="photo-source-row">
              <button
                id="quick-photo-camera"
                class="secondary-button photo-source"
                data-source="camera"
                bindtap="chooseQuickRoutePhoto"
              >拍照</button>
              <button
                id="quick-photo-album"
                class="secondary-button photo-source"
                data-source="album"
                bindtap="chooseQuickRoutePhoto"
              >从相册选择</button>
            </view>
            <text class="photo-hint">不添加照片也能创建线路；创建后照片保存到本机。</text>
          </view>

          <!-- 攀岩类型在左、等级在右；等级选项随类型重算，失效时显示「请选择等级」 -->
          <view class="quick-route-row">
            <picker
              mode="selector"
              range="{{quickRouteTypes}}"
              value="{{quickRouteTypeIndex}}"
              bindchange="onQuickRouteTypeChange"
            >
              <view class="picker-value">攀岩类型：{{quickRouteType}}</view>
            </picker>
            <picker
              mode="selector"
              range="{{quickRouteGrades}}"
              value="{{quickRouteGradeIndex}}"
              bindchange="onQuickRouteGradeChange"
            >
              <view class="picker-value">等级：{{quickRouteGradeText}}</view>
            </picker>
          </view>

          <!-- 颜色是独立属性，与类型和等级无关，切换类型时保持不变 -->
          <view class="field">
            <text class="field-label">颜色</text>
            <picker
              mode="selector"
              range="{{quickRouteColors}}"
              range-key="name"
              value="{{quickRouteColorIndex}}"
              bindchange="onQuickRouteColorChange"
            >
              <view class="picker-value">{{quickRouteColorName}}</view>
            </picker>
          </view>

          <text wx:if="{{quickRouteError}}" class="field-error">{{quickRouteError}}</text>
          <button id="create-quick-route" class="secondary-button" bindtap="createQuickRoute">
            创建并选中
          </button>
        </view>
      </view>

      <!-- 拇指可及的两个大按钮，底部留出安全区；
           本场本线路还有待确认时锁定，先在该行重试，确认后才生成新的一把。
           抱石首次完攀确认后，原按钮位置改成「已完攀」并只留回看入口。 -->
      <view wx:if="{{selectedRoute && !noteEditor}}" class="result-footer">
        <block wx:if="{{routeCompleted}}">
          <view id="route-completed-panel" class="route-completed-panel">
            <text class="route-completed-title">已完攀</text>
            <text class="route-completed-hint">这条抱石线路已完攀，只能回看；把次、备注与照片都保留在本机。</text>
          </view>
          <button
            id="route-completed-detail"
            class="secondary-button route-completed-detail"
            data-route-id="{{selectedRoute.id}}"
            bindtap="openRouteDetail"
          >查看记录</button>
        </block>
        <block wx:else>
          <text wx:if="{{resultLocked}}" id="result-locked-hint" class="result-lock-hint">{{resultLockHint}}</text>
          <button
            id="record-fail"
            class="result-button result-fail"
            data-result="fail"
            disabled="{{resultLocked}}"
            bindtap="recordAttempt"
          >未完成</button>
          <button
            id="record-send"
            class="result-button result-send"
            data-result="send"
            disabled="{{resultLocked}}"
            bindtap="recordAttempt"
          >完攀</button>
        </block>
      </view>

      <view class="section session-history">
        <text class="section-title">已开始场次</text>
        <view
          wx:for="{{allSessions}}"
          wx:key="id"
          class="session-item {{item.isActive ? 'session-item-active' : ''}}"
          data-session-id="{{item.id}}"
          bindtap="switchSession"
        >
          <text class="session-item-date">{{item.dateText}}</text>
          <text class="session-item-gym">{{item.gymName}}</text>
          <text class="session-item-meta">{{item.label}} · {{item.attemptCount}} 把</text>
        </view>
      </view>
    </block>

    <!-- 旧汇总只读入口：虚构样例，用于检查原始汇总可读且不生成逐次尝试 -->
    <view
      wx:if="{{legacySample}}"
      id="legacy-entry"
      class="legacy-entry"
      bindtap="openLegacySample"
    >
      <view class="legacy-entry-main">
        <text class="legacy-entry-title">{{legacySample.name}} · 旧汇总（只读）</text>
        <text class="legacy-entry-meta">{{legacySample.legacy.summaryText}}</text>
      </view>
      <text class="legacy-entry-link">查看 ›</text>
    </view>
  </block>
</view>
