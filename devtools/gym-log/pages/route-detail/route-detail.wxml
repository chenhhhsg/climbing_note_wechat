<!--
  线路详情：同一条线跨天接着记
  按日期与场次分组回看逐次尝试；主要操作「今天再爬」固定在拇指可及处。
  旧汇总样例只显示原始汇总，逐次统计保持 0，不生成多条尝试。
-->
<view class="page route-detail-page">
  <view class="trial-banner">
    <text class="trial-badge">{{trialBadge}}</text>
    <text class="trial-note">跨天回看 · 仅保存在本机</text>
  </view>

  <view wx:if="{{loadError}}" class="card error-card">
    <text class="error-title">本地数据读取失败</text>
    <text class="error-text">{{loadError}}</text>
    <view class="button-row">
      <button id="retry-load" class="secondary-button" bindtap="retryLoad">重试读取</button>
      <button id="back-today" class="secondary-button" bindtap="goBackToToday">返回今日</button>
    </view>
  </view>

  <block wx:else>
    <view class="page-header">
      <text class="page-title">线路详情</text>
      <text class="page-subtitle">同一条线，接着上次继续</text>
    </view>

    <view wx:if="{{storageError}}" class="storage-error" bindtap="dismissStorageError">
      <text class="storage-error-text">{{storageError}}</text>
      <text class="storage-error-hint">当前操作未生效，请重试；点击可收起</text>
    </view>

    <!-- 已完攀只回看：迟到的「今天再爬」或选场不再新增，只给一次提示 -->
    <view wx:if="{{recordNotice}}" id="record-notice" class="storage-error" bindtap="dismissRecordNotice">
      <text class="storage-error-text">{{recordNotice}}</text>
      <text class="storage-error-hint">点击可收起</text>
    </view>

    <view
      wx:if="{{photoNotice}}"
      id="photo-notice"
      class="photo-notice"
      bindtap="dismissPhotoNotice"
    >
      <text class="photo-notice-text">{{photoNotice}}</text>
      <text class="photo-notice-hint">点击收起</text>
    </view>

    <view wx:if="{{notFound}}" class="card error-card">
      <text class="error-title">找不到这条线路</text>
      <text class="error-text">这条线路可能已被移除，请返回今日页重新选择。</text>
      <button class="secondary-button" bindtap="goBackToToday">返回今日</button>
    </view>

    <block wx:if="{{route}}">
      <view class="card route-header">
        <view class="route-swatch" style="background: {{route.colorHex}};"></view>
        <view class="route-heading">
          <text class="route-title">{{route.name}}</text>
          <text class="route-meta">{{route.climbType}} {{route.grade}} · {{route.colorName}} · {{route.gymName}}</text>
        </view>
      </view>

      <!--
        主照片：详情展示完整主图，点击进入微信原生预览，可双指缩放。
        照片可选；缺文件时只对本线路显示重新添加入口。
      -->
      <view wx:if="{{!isLegacy && routePhoto}}" id="route-photo-card" class="card photo-card">
        <view class="photo-head">
          <text class="photo-title">线路照片</text>
          <text class="photo-note">本机试用 · 照片保存在本机</text>
        </view>

        <block wx:if="{{routePhoto.status === 'saved'}}">
          <image
            id="detail-photo-main"
            class="detail-photo-main"
            src="{{routePhoto.mainPath}}"
            mode="aspectFit"
            data-route-id="{{route.id}}"
            bindtap="previewDetailPhoto"
          />
          <text class="photo-status">{{routePhoto.statusText}}</text>
          <text wx:if="{{routePhoto.bytesText}}" class="photo-meta">{{routePhoto.bytesText}}</text>
          <text class="photo-hint">点击照片打开完整主图，可双指缩放。</text>
          <view class="photo-actions">
            <button
              id="detail-photo-preview"
              class="secondary-button photo-action"
              data-route-id="{{route.id}}"
              bindtap="previewDetailPhoto"
            >查看大图</button>
            <button
              id="detail-photo-remove"
              class="text-button photo-remove"
              data-route-id="{{route.id}}"
              bindtap="removeDetailPhoto"
            >移除照片</button>
          </view>
        </block>

        <block wx:elif="{{routePhoto.status === 'preview'}}">
          <image
            id="detail-photo-preview-image"
            class="photo-preview"
            src="{{routePhoto.previewPath}}"
            mode="aspectFit"
          />
          <text class="photo-status">{{routePhoto.statusText}}</text>
          <view class="photo-actions">
            <button
              id="detail-photo-cancel"
              class="secondary-button photo-action"
              data-route-id="{{route.id}}"
              bindtap="cancelDetailPhoto"
            >取消</button>
            <button
              id="detail-photo-confirm"
              class="primary-button photo-action"
              data-route-id="{{route.id}}"
              bindtap="confirmDetailPhoto"
            >确认保存</button>
          </view>
        </block>

        <block wx:elif="{{routePhoto.status === 'saving'}}">
          <image
            wx:if="{{routePhoto.mainPath}}"
            class="photo-thumb"
            src="{{routePhoto.mainPath}}"
            mode="aspectFill"
          />
          <text id="detail-photo-saving" class="photo-status photo-status-busy">{{routePhoto.statusText}}</text>
          <text class="photo-hint">照片文件和关联都写入后才提示成功。</text>
        </block>

        <block wx:elif="{{routePhoto.status === 'failed'}}">
          <image
            wx:if="{{routePhoto.mainPath}}"
            class="photo-thumb"
            src="{{routePhoto.mainPath}}"
            mode="aspectFill"
            data-route-id="{{route.id}}"
            bindtap="previewDetailPhoto"
          />
          <text id="detail-photo-error" class="photo-status photo-status-error">{{routePhoto.statusText}}</text>
          <text class="photo-error-detail">{{routePhoto.errorText}}</text>
          <view class="photo-actions">
            <button
              id="detail-photo-retry"
              class="secondary-button photo-action"
              data-route-id="{{route.id}}"
              bindtap="retryDetailPhoto"
            >{{routePhoto.retryText}}</button>
            <button
              id="detail-photo-dismiss"
              class="text-button photo-remove"
              data-route-id="{{route.id}}"
              bindtap="dismissDetailPhotoFailure"
            >收起</button>
          </view>
          <button
            wx:if="{{routePhoto.manageSpaceVisible}}"
            id="detail-photo-space-manage"
            class="secondary-button photo-action"
            bindtap="openSpaceManager"
          >返回今日页管理照片空间</button>
        </block>

        <block wx:elif="{{routePhoto.status === 'missing'}}">
          <text id="detail-photo-missing" class="photo-status photo-status-error">本机照片不可用，可重新添加</text>
          <text class="photo-hint">照片文件可能已被系统清理；重新添加会替换原关联，历史尝试不变。</text>
        </block>

        <block wx:elif="{{routePhoto.status === 'error'}}">
          <text class="photo-status photo-status-error">{{routePhoto.statusText}}</text>
          <button
            class="secondary-button photo-action"
            data-route-id="{{route.id}}"
            bindtap="reloadDetailPhoto"
          >重试读取</button>
        </block>

        <block wx:else>
          <text class="photo-status">{{routePhoto.statusText}}</text>
        </block>

        <view wx:if="{{routePhoto.sourceVisible}}" class="photo-source-row">
          <button
            id="detail-photo-camera"
            class="secondary-button photo-source"
            data-source="camera"
            data-route-id="{{route.id}}"
            bindtap="chooseDetailPhoto"
          >{{routePhoto.cameraText}}</button>
          <button
            id="detail-photo-album"
            class="secondary-button photo-source"
            data-source="album"
            data-route-id="{{route.id}}"
            bindtap="chooseDetailPhoto"
          >{{routePhoto.albumText}}</button>
        </view>
      </view>

      <view class="summary-row">
        <text class="summary-text">{{summaryText}}</text>
        <text wx:if="{{hasAttempts}}" class="summary-detail">完攀 {{sendCount}} 把</text>
      </view>

      <!-- 已完攀标记：与今日页、历史选线显示同一份判定 -->
      <text
        wx:if="{{routeStateText}}"
        id="detail-route-state"
        class="detail-route-state {{routeCompleted ? 'detail-route-state-done' : 'detail-route-state-pending'}}"
      >{{routeStateText}}</text>

      <!-- 旧汇总：只读原样展示，不生成逐次尝试，不参与统计 -->
      <view wx:if="{{isLegacy}}" class="card legacy-card">
        <text class="legacy-label">{{legacySummary.label}}</text>
        <text class="legacy-summary">{{legacySummary.summaryText}}</text>
        <text class="legacy-hint">{{legacySummary.hint}}</text>
        <view class="legacy-stat">
          <text class="legacy-stat-label">逐次尝试</text>
          <text class="legacy-stat-value">{{attemptCountText}}</text>
        </view>
      </view>

      <view wx:elif="{{hasAttempts}}" class="history-groups">
        <view wx:for="{{groups}}" wx:key="sessionId" class="history-group">
          <view class="group-head">
            <text class="group-date">{{item.dateText}}</text>
            <text class="group-session">{{item.sessionLabel}}</text>
            <text class="group-gym">{{item.gymName}}</text>
            <text class="group-count">{{item.countText}}</text>
          </view>
          <view
            wx:for="{{item.attempts}}"
            wx:key="id"
            wx:for-item="attempt"
            class="detail-attempt"
          >
            <view class="attempt-main">
              <text class="attempt-label">{{attempt.label}}</text>
              <text class="attempt-result">{{attempt.resultText}}</text>
              <text class="attempt-time">{{attempt.timeText}}</text>
            </view>
            <text wx:if="{{attempt.hasNote}}" class="attempt-note">{{attempt.note}}</text>
          </view>
        </view>
      </view>

      <view wx:else class="card empty-history">
        <text>这条线路还没有逐次记录。</text>
        <text class="empty-hint">点「今天再爬」用原线路记一把。</text>
      </view>
    </block>
  </block>

  <!-- 已完攀的抱石线不再提供「今天再爬」，只保留回看；顶绳和先锋可重复完攀，入口照旧 -->
  <view
    wx:if="{{!isLegacy && route && canRecordAgain}}"
    class="record-again-footer"
  >
    <button id="record-again" class="record-again-button" bindtap="recordAgain">今天再爬</button>
    <text class="record-again-hint">今天该岩馆只有一场时直接沿用；多场先选归属；没有就新建一场</text>
  </view>
  <view
    wx:elif="{{!isLegacy && route}}"
    id="detail-completed-footer"
    class="record-again-footer detail-completed-footer"
  >
    <text id="detail-completed-state" class="detail-completed-title">已完攀</text>
    <text class="detail-completed-hint">这条抱石线路已完攀，只能回看；逐把记录、备注与照片都保留在本机。</text>
  </view>

  <!--
    同日多场：必须明确选一场才切换归属并返回。
    取消不写缓存，当前场次与详情数据保持原样。
  -->
  <view
    wx:if="{{sessionPicker}}"
    class="picker-mask"
    bindtap="cancelSessionPicker"
  ></view>
  <view wx:if="{{sessionPicker}}" class="session-picker">
    <text class="picker-title">今天记到哪一场？</text>
    <text class="picker-subtitle">{{sessionPicker.dateText}} · {{sessionPicker.gymName}} · 共 {{sessionPicker.sessions.length}} 场</text>
    <text class="picker-hint">同日多场需要明确归属；选中后切到该场并返回今日页。</text>
    <view
      wx:for="{{sessionPicker.sessions}}"
      wx:key="id"
      id="pick-{{item.id}}"
      class="picker-session {{item.isCurrent ? 'picker-session-current' : ''}}"
      data-session-id="{{item.id}}"
      bindtap="chooseSessionForAgain"
    >
      <view class="picker-session-main">
        <text class="picker-session-label">{{item.label}}</text>
        <text wx:if="{{item.isCurrent}}" class="picker-current-badge">当前</text>
      </view>
      <text class="picker-session-time">{{item.timeText}} 开始</text>
    </view>
    <button id="cancel-session-picker" class="picker-cancel" bindtap="cancelSessionPicker">取消，保持当前场次</button>
  </view>
</view>
