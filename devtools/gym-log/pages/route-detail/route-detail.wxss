/**
 * 线路详情 · 岩馆线路手账风格
 * 粉笔白底、炭黑字；线路色只出现在小色标上，跨天分组用留白和细线区分。
 */
.route-detail-page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(240rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f7f4ec;
  color: #23241f;
}

.trial-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.trial-badge {
  padding: 6rpx 16rpx;
  border: 2rpx dashed #8a877b;
  border-radius: 999rpx;
  color: #55564e;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.trial-note {
  color: #85857a;
  font-size: 22rpx;
}

.page-header {
  margin: 8rpx 0 28rpx;
}

.page-title {
  display: block;
  color: #23241f;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.page-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #717269;
  font-size: 26rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: #fffdf8;
  border: 1rpx solid #e3ded0;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(35, 36, 31, 0.05);
}

.secondary-button {
  min-height: 96rpx;
  line-height: 96rpx;
  margin-top: 24rpx;
  border-radius: 18rpx;
  background: #f3efe4;
  color: #23241f;
  border: 1rpx solid #d8d2c2;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.secondary-button::after {
  border: none;
}

.button-row {
  display: flex;
  margin-top: 8rpx;
}

.button-row .secondary-button {
  flex: 1;
  margin-left: 12rpx;
}

.button-row .secondary-button:first-child {
  margin-left: 0;
}

.error-card {
  border-color: #e7b6b1;
}

.error-title {
  display: block;
  color: #b3261e;
  font-size: 32rpx;
  font-weight: 700;
}

.error-text {
  display: block;
  margin-top: 12rpx;
  color: #6c4a46;
  font-size: 26rpx;
}

.storage-error {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: #fbeceb;
  border: 1rpx solid #e7b6b1;
  border-radius: 16rpx;
}

.storage-error-text {
  display: block;
  color: #b3261e;
  font-size: 26rpx;
  font-weight: 600;
}

.storage-error-hint {
  display: block;
  margin-top: 6rpx;
  color: #8a4b45;
  font-size: 22rpx;
}

.route-header {
  display: flex;
  align-items: center;
}

.route-swatch {
  flex: none;
  width: 28rpx;
  height: 96rpx;
  margin-right: 24rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(35, 36, 31, 0.18);
}

.route-heading {
  flex: 1;
  min-width: 0;
}

.route-title {
  display: block;
  color: #23241f;
  font-size: 40rpx;
  font-weight: 700;
}

.route-meta {
  display: block;
  margin-top: 8rpx;
  color: #717269;
  font-size: 26rpx;
}

.summary-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 4rpx 4rpx 20rpx;
}

.summary-text {
  color: #23241f;
  font-size: 30rpx;
  font-weight: 700;
}

.summary-detail {
  color: #4b5f4a;
  font-size: 24rpx;
  font-weight: 600;
}

/* 完攀标记：与今日页、历史选线同一份状态文案 */
.detail-route-state {
  display: inline-block;
  margin: 0 4rpx 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.detail-route-state-done {
  background: #e7efe4;
  border: 1rpx solid #bcd3b6;
  color: #3f6a3c;
}

.detail-route-state-pending {
  background: #faf0dd;
  border: 1rpx solid #e0cf9f;
  color: #8a6d1f;
}

.legacy-card {
  border-color: #b9b3a2;
  border-style: dashed;
  background: #faf7ee;
}

.legacy-label {
  display: block;
  color: #8a6d1f;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.legacy-summary {
  display: block;
  margin-top: 14rpx;
  color: #23241f;
  font-size: 34rpx;
  font-weight: 700;
}

.legacy-hint {
  display: block;
  margin-top: 10rpx;
  color: #717269;
  font-size: 24rpx;
  line-height: 1.5;
}

.legacy-stat {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #e3ded0;
}

.legacy-stat-label {
  color: #717269;
  font-size: 24rpx;
}

.legacy-stat-value {
  color: #23241f;
  font-size: 28rpx;
  font-weight: 700;
}

.history-group {
  margin-bottom: 28rpx;
}

.group-head {
  display: flex;
  align-items: baseline;
  padding: 12rpx 4rpx 14rpx;
  border-bottom: 2rpx solid #23241f;
}

.group-date {
  color: #23241f;
  font-size: 30rpx;
  font-weight: 700;
}

.group-session {
  margin-left: 16rpx;
  padding: 2rpx 14rpx;
  background: #23241f;
  border-radius: 999rpx;
  color: #fdfbf5;
  font-size: 22rpx;
  font-weight: 600;
}

.group-gym {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
  color: #717269;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-count {
  margin-left: 12rpx;
  color: #4b5f4a;
  font-size: 22rpx;
  font-weight: 600;
}

.detail-attempt {
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  background: #fffdf8;
  border: 1rpx solid #e3ded0;
  border-radius: 18rpx;
}

.attempt-main {
  display: flex;
  align-items: baseline;
}

.attempt-label {
  color: #23241f;
  font-size: 28rpx;
  font-weight: 700;
}

.attempt-result {
  margin-left: 16rpx;
  color: #23241f;
  font-size: 30rpx;
  font-weight: 700;
}

.attempt-time {
  margin-left: auto;
  color: #8a877b;
  font-size: 22rpx;
}

.attempt-note {
  display: block;
  margin-top: 10rpx;
  color: #4b4c44;
  font-size: 26rpx;
  line-height: 1.45;
}

.empty-history {
  color: #717269;
  font-size: 26rpx;
  text-align: center;
}

.empty-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
}

/* 主要操作固定在拇指可及处，避开微信底栏与手机安全区 */
.record-again-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 20rpx 32rpx 20rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(247, 244, 236, 0.98);
  border-top: 1rpx solid #ddd8ca;
  box-sizing: border-box;
}

.record-again-button {
  height: 116rpx;
  line-height: 116rpx;
  padding: 0;
  background: #23241f;
  border-radius: 20rpx;
  color: #fdfbf5;
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
}

.record-again-button::after {
  border: none;
}

.record-again-hint {
  display: block;
  margin-top: 10rpx;
  color: #85857a;
  font-size: 22rpx;
  text-align: center;
}

/* 抱石已完攀：同一页脚位置改成状态说明，不再提供「今天再爬」 */
.detail-completed-footer {
  background: rgba(231, 239, 228, 0.98);
  border-top: 1rpx solid #bcd3b6;
}

.detail-completed-title {
  display: block;
  color: #3f6a3c;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.detail-completed-hint {
  display: block;
  margin-top: 8rpx;
  color: #55564e;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}

/* 误点完攀的更正：与「已完攀」同处一个页脚，写明改正的是哪一把 */
.detail-correction {
  width: 100%;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #bcd3b6;
}

.detail-correction-target {
  display: block;
  color: #2f4a7a;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.detail-correction-hint {
  display: block;
  margin-top: 6rpx;
  color: #55564e;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}

.detail-correction-status {
  display: block;
  margin-top: 6rpx;
  color: #8a6414;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}

.detail-correct-send {
  width: 100%;
  margin-top: 12rpx;
}

/* 抱石完攀待确认：与「已完攀」区分开，给出回原把次重试的入口 */
.detail-pending-footer {
  background: rgba(251, 241, 222, 0.98);
  border-top: 1rpx solid #dfc79a;
}

.detail-pending-title {
  display: block;
  color: #8a6414;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.detail-pending-hint {
  display: block;
  margin-top: 8rpx;
  color: #55564e;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}

.detail-pending-retry {
  margin-top: 16rpx;
}

/* 同日多场选择：底部面板，编号 + 开始时刻 + 当前标记 */
.picker-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  background: rgba(35, 36, 31, 0.45);
}

.session-picker {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 41;
  padding: 32rpx 32rpx 24rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fffdf8;
  border-top: 1rpx solid #ddd8ca;
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -12rpx 32rpx rgba(35, 36, 31, 0.12);
  box-sizing: border-box;
}

.picker-title {
  display: block;
  color: #23241f;
  font-size: 40rpx;
  font-weight: 700;
}

.picker-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #55564e;
  font-size: 26rpx;
}

.picker-hint {
  display: block;
  margin-top: 6rpx;
  color: #85857a;
  font-size: 22rpx;
}

.picker-session {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 26rpx 28rpx;
  background: #f7f4ec;
  border: 1rpx solid #d8d2c2;
  border-radius: 18rpx;
}

.picker-session-current {
  background: #fdfbf5;
  border: 2rpx solid #23241f;
}

.picker-session-main {
  display: flex;
  align-items: center;
  min-width: 0;
}

.picker-session-label {
  color: #23241f;
  font-size: 32rpx;
  font-weight: 700;
}

.picker-current-badge {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  background: #23241f;
  border-radius: 999rpx;
  color: #fdfbf5;
  font-size: 20rpx;
  font-weight: 600;
}

.picker-session-time {
  margin-left: 16rpx;
  color: #717269;
  font-size: 24rpx;
}

.picker-cancel {
  min-height: 96rpx;
  line-height: 96rpx;
  margin-top: 20rpx;
  padding: 0;
  background: #f3efe4;
  border: 1rpx solid #d8d2c2;
  border-radius: 18rpx;
  color: #23241f;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.picker-cancel::after {
  border: none;
}

/* ---- 线路照片：详情展示完整主图，列表缩略图在今日页 ---- */
.photo-notice {
  margin-bottom: 24rpx;
  padding: 18rpx 22rpx;
  background: #f3efe4;
  border: 1rpx solid #d8d2c2;
  border-radius: 14rpx;
}

.photo-notice-text {
  display: block;
  color: #3f4b3e;
  font-size: 25rpx;
  line-height: 1.5;
}

.photo-notice-hint {
  display: block;
  margin-top: 6rpx;
  color: #85857a;
  font-size: 22rpx;
}

.photo-card {
  border-style: dashed;
  border-color: #b9b3a2;
}

.photo-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.photo-title {
  color: #23241f;
  font-size: 28rpx;
  font-weight: 700;
}

.photo-note {
  color: #85857a;
  font-size: 22rpx;
}

.detail-photo-main {
  display: block;
  width: 100%;
  height: 420rpx;
  margin-top: 16rpx;
  background: #f3efe4;
  border-radius: 14rpx;
}

.photo-preview {
  display: block;
  width: 100%;
  height: 420rpx;
  margin-top: 16rpx;
  background: #f3efe4;
  border-radius: 14rpx;
}

.photo-thumb {
  display: block;
  width: 100%;
  height: 300rpx;
  margin-top: 16rpx;
  background: #f3efe4;
  border-radius: 14rpx;
}

.photo-status {
  display: block;
  margin-top: 14rpx;
  color: #3f4b3e;
  font-size: 26rpx;
  font-weight: 600;
}

.photo-status-busy {
  color: #6b4a12;
}

.photo-status-error {
  color: #8f4a2f;
}

.photo-meta {
  display: block;
  margin-top: 4rpx;
  color: #85857a;
  font-size: 22rpx;
}

.photo-error-detail {
  display: block;
  margin-top: 6rpx;
  color: #8a4b45;
  font-size: 23rpx;
  line-height: 1.45;
}

.photo-hint {
  display: block;
  margin-top: 8rpx;
  color: #85857a;
  font-size: 22rpx;
  line-height: 1.5;
}

.photo-actions {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.photo-action {
  flex: 1;
  min-height: 80rpx;
  line-height: 80rpx;
  margin-top: 14rpx;
  font-size: 28rpx;
}

.photo-action + .photo-action {
  margin-left: 14rpx;
}

.photo-remove {
  flex: none;
  margin: 14rpx 0 0 18rpx;
  color: #8f4a2f;
}

.photo-source-row {
  display: flex;
  margin-top: 10rpx;
}

.photo-source {
  flex: 1;
  min-height: 84rpx;
  line-height: 84rpx;
  margin-top: 14rpx;
  font-size: 28rpx;
}

.photo-source + .photo-source {
  margin-left: 14rpx;
}

.primary-button {
  min-height: 96rpx;
  line-height: 96rpx;
  margin-top: 24rpx;
  border-radius: 18rpx;
  background: #23241f;
  color: #fdfbf5;
  border: 1rpx solid #23241f;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.primary-button::after {
  border: none;
}

.primary-button.photo-action {
  min-height: 80rpx;
  line-height: 80rpx;
  margin-top: 14rpx;
  font-size: 28rpx;
}
