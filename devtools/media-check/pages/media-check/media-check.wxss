.page {
  padding: 32rpx;
  box-sizing: border-box;
}

.intro {
  margin-bottom: 28rpx;
}

.intro-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.intro-text {
  display: block;
  color: #666;
  line-height: 1.6;
}

.btn {
  margin: 0;
  padding: 0 28rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
  background: #fff;
  color: #2c3e50;
  border: 1rpx solid #d9dee3;
}

.btn::after {
  border: none;
}

.btn-primary {
  width: 100%;
  background: #2c3e50;
  color: #fff;
  border-color: #2c3e50;
}

.player-panel {
  margin-top: 28rpx;
}

.video {
  width: 100%;
  height: 420rpx;
  background: #000;
  border-radius: 16rpx;
}

.meta {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.meta-label {
  color: #666;
}

.meta-value {
  font-variant-numeric: tabular-nums;
}

.controls {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.controls .btn {
  flex: 1;
}

.seek-panel {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.seek-target,
.seek-actual,
.seek-status,
.seek-short {
  display: block;
  margin-bottom: 10rpx;
}

.seek-target {
  font-weight: 600;
}

.seek-actual {
  color: #2c3e50;
  font-variant-numeric: tabular-nums;
}

.seek-status {
  color: #8a6d3b;
}

.seek-short {
  color: #a94442;
}

.notice {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
}

.notice-error {
  background: #fdecea;
  color: #a94442;
}

.notice-text {
  display: block;
  margin-bottom: 12rpx;
}

.notice-action {
  color: #a94442;
  text-decoration: underline;
}

.empty {
  margin-top: 28rpx;
  padding: 60rpx 0;
  text-align: center;
  color: #999;
}

.tips {
  margin-top: 40rpx;
  color: #999;
  font-size: 24rpx;
  line-height: 1.6;
}
